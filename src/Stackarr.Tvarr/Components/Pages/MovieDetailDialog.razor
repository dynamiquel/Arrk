@inject RadarrService RadarrService
@inject RadarrReleaseProvider RadarrReleases
@inject TmdbService TmdbService
@inject ITvPlayerLinks JellyfinLinkService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IOptionsMonitor<TvConfig> TvOptions
@using Stackarr.Core.Lifecycle
@inject StaleMediaEnricher Stale

<MudDialog Class="st-media-dialog">
    <DialogContent>
        @if (_loading)
        {
            <div style="padding:32px;"><LoadingView /></div>
        }
        else
        {
        <MediaDetailHero Title="@_movie.Title"
                         Year="_movie.Year"
                         PosterUrl="@_movie.PosterUrl"
                         BackdropUrl="@(!string.IsNullOrEmpty(_backdropUrl) ? _backdropUrl : _movie.FanartUrl)"
                         LogoUrl="@_logoUrl"
                         Rating="_rating"
                         RuntimeMinutes="@(_runtime ?? _movie.RuntimeMinutes)"
                         Certification="@(!string.IsNullOrEmpty(_certification) ? _certification : _movie.Certification)"
                         Tagline="@_tagline"
                         TmdbId="_tmdbId"
                         ImdbId="@_movie.ImdbId"
                         TrailerKey="@(_trailerKey ?? string.Empty)"
                         PlayUrl="@_playUrl"
                         IsTrailerPlaying="_showTrailer"
                         MediaType="movie"
                         OnClose="() => MudDialog.Cancel()"
                         OnPlayTrailer="() => _showTrailer = !_showTrailer">
            <Badges>
                <StaleBadge Level="_staleLevel" DaysRemaining="_staleDays" ShowBookmarked="_staleBookmarked"
                            BookmarkLabel="_staleBookmark" IsPinned="_stalePinned" ShowPinned="false" />
                @if (IsSearchResult)
                {
                    <StatusPill Variant="remote" Icon="@Icons.Material.Filled.AddCircleOutline" Label="Not in Library" />
                }
                else if (_queueItems.Count > 0)
                {
                    <StatusPill Variant="info" Label="Downloading" />
                }
                else
                {
                    <StatusPill Variant="@(_movieStatus == "Downloaded" ? "success" : "error")"
                                     Icon="@(_movieStatus == "Downloaded" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)"
                                     Label="@_movieStatus" />
                }
                @if (!IsSearchResult)
                {
                    <StatusPill Variant="@(_movie.Monitored ? "info" : "neutral")"
                                     Icon="@(_movie.Monitored ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.VisibilityOff)"
                                     Label="@(_movie.Monitored ? "Monitored" : "Unmonitored")" />
                }
                @if (NotYetReleased)
                {
                    <StatusPill Variant="unreleased" Icon="@Icons.Material.Filled.Schedule" Label="Not Released" />
                }
            </Badges>
            <Links>
                <UiRegion Name="tv.movie.links" Context="new TvMovieActionContext(_movie)" />
            </Links>
        </MediaDetailHero>

            <div class="st-detail-body">
                @if (_showTrailer)
                {
                    <MediaTrailer TrailerKey="@_trailerKey" Title="@_movie.Title" />
                }

                @if (!string.IsNullOrEmpty(_movie.Overview))
                {
                    <MudText Typo="Typo.body2" Class="st-detail-overview">@_movie.Overview</MudText>
                }

                @if (_movie.Genres.Count > 0)
                {
                    <div class="st-detail-chips">
                        @foreach (string genre in _movie.Genres)
                        {
                            <StChip Variant="neutral">@genre</StChip>
                        }
                    </div>
                }

                <MetaGrid>
                    @if (!string.IsNullOrEmpty(_releaseDate))
                    {
                        <MetaItem Label="Release Date" Value="@_releaseDate" />
                    }
                    @if ((_runtime ?? _movie.RuntimeMinutes) is > 0)
                    {
                        <MetaItem Label="Runtime" Value="@FormatRuntime((_runtime ?? _movie.RuntimeMinutes)!.Value)" />
                    }
                    <MetaItem Label="Status" Value="@ReleaseStatusText" />
                    <MetaItem Label="Release Source" Value="@(_movie.ReleaseSource == ReleaseSource.Unknown ? "Unknown" : _movie.ReleaseSource.ToString())" />
                    @if (_movie.File?.Technical is { } tech && !string.IsNullOrWhiteSpace(tech.Summary))
                    {
                        <MetaItem Label="Format">
                            <MediaFormatLine Info="tech" Quality="_movie.Quality" />
                        </MetaItem>
                    }
                    <MetaItem Label="Age Rating" Value="@(string.IsNullOrEmpty(_certification) && string.IsNullOrEmpty(_movie.Certification) ? "Unknown" : FormatHelper.ToUkCertification(!string.IsNullOrEmpty(_certification) ? _certification : _movie.Certification))" />
                    <MetaItem Label="Language" Value="@FormatHelper.LanguageName(!string.IsNullOrEmpty(_language) ? _language : _movie.OriginalLanguage)" />
                    @if (!string.IsNullOrEmpty(_studio))
                    {
                        <MetaItem Label="Studio" Value="@_studio" />
                    }
                    @if (!string.IsNullOrEmpty(_movie.CollectionTitle))
                    {
                        <MetaItem Label="Collection" Value="@_movie.CollectionTitle" />
                    }
                    @if (_movie.InCinemas.HasValue)
                    {
                        <MetaItem Label="In Cinemas" Value="@_movie.InCinemas.Value.ToString("MMM dd, yyyy")" />
                    }
                    @if (!string.IsNullOrEmpty(PhysicalReleaseText) && !FormatHelper.IsReleased(PhysicalReleaseDate))
                    {
                        <MetaItem Label="Physical Release" Value="@PhysicalReleaseText" />
                    }
                    @if (!string.IsNullOrEmpty(DigitalReleaseText) && !FormatHelper.IsReleased(DigitalReleaseDate))
                    {
                        <MetaItem Label="Web Release" Value="@DigitalReleaseText" />
                    }
                    @if (_movie.SizeOnDisk > 0)
                    {
                        <MetaItem Label="Size on Disk" Value="@FormatHelper.FormatBytes(_movie.SizeOnDisk)" />
                    }
                    @if (!IsSearchResult)
                    {
                        <MetaItem Label="Added" Value="@_movie.Added.ToString("MMM dd, yyyy")" />
                    }
                </MetaGrid>

                <MediaRecommendations MediaType="@TmdbMediaType.Movie" TmdbId="_tmdbId" />

                <MediaCastRow Cast="@_cast" />

                @if (_queueItems.Count > 0)
                {
                    RadarrQueueItemDto q = _queueItems.First();
                    <div class="st-queue-panel">
                        <div class="st-detail-section-label">
                            <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" /> Downloading
                        </div>
                        @if (q.Size > 0)
                        {
                            double progress = q.Sizeleft > 0 ? (double)(q.Size - (long)q.Sizeleft) / q.Size * 100 : 100;
                            <MudProgressLinear Value="@progress" Color="Color.Info" Size="Size.Small" Rounded="true" Style="height:6px;" />
                            <MudText Typo="Typo.caption" Style="color:var(--st-text-secondary);margin-top:6px;">
                                @FormatHelper.FormatBytes(q.Size - (long)q.Sizeleft) / @FormatHelper.FormatBytes(q.Size)
                            </MudText>
                        }
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (IsSearchResult && SearchEnabled)
        {
            <MudButton OnClick="AddFromSearch" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_loading"
                       Class="st-btn-gradient"
                       StartIcon="@Icons.Material.Filled.Add" title="Add to library" AriaLabel="Add to library">
                <span class="st-btn-label">Add</span>
            </MudButton>
        }
        else
        {
            @if (_movie.HasFile)
            {
                <MudButton OnClick="OpenMediaInfo" Variant="Variant.Outlined" Color="Color.Default" Disabled="@_loading"
                           StartIcon="@Icons.Material.Filled.Info" title="Media info" AriaLabel="Media info">
                    <span class="st-btn-label">Media Info</span>
                </MudButton>
            }
            @if (_queueItems.Count > 0 && IsAdmin)
            {
                <MudButton OnClick="CancelMovieDownload" Variant="Variant.Outlined" Color="Color.Error" Disabled="@_loading"
                           StartIcon="@Icons.Material.Filled.Cancel" title="Cancel download" AriaLabel="Cancel download">
                    <span class="st-btn-label">Cancel</span>
                </MudButton>
            }
            @if (SearchEnabled)
            {
                <StSearchButton OnSearch="Search" OnInteractive="OpenInteractiveSearch"
                                OnRetry="RetryMovieSearch" OnUpload="UploadMovie"
                                EnableInteractive="IsAdmin" EnableRetry="IsAdmin" EnableUpload="IsAdmin"
                                Disabled="_loading" />
            }
            else if (IsAdmin)
            {
                <MudButton OnClick="UploadMovie" Variant="Variant.Outlined" Color="Color.Default" Disabled="@_loading"
                           StartIcon="@Icons.Material.Filled.CloudUpload" title="Upload a local file"
                           AriaLabel="Upload a local file">
                    <span class="st-btn-label">Upload</span>
                </MudButton>
            }
            <WatchlistButton ProviderKey="@WatchActivityServices.Tv" Domain="@TvMediaDomains.Movie"
                             ItemKey="@MediaItemKeys.Movie(_tmdbId)"
                             Title="@_movie.Title"
                             Subtitle="@(_movie.Year > 0 ? _movie.Year.ToString() : null)"
                             PosterUrl="@_movie.PosterUrl" Year="_movie.Year" TmdbId="_tmdbId"
                             AsButton="true" />
            @if (MediaEntityRefs.Movie(_movie) is { } followEntity)
            {
                <FollowButton Entity="followEntity" AsButton="true" />
            }
            @if (IsAdmin || !_movie.Monitored)
            {
                <MudButton OnClick="ToggleMonitored" Variant="@(_movie.Monitored ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" Disabled="@_loading"
                           StartIcon="@(_movie.Monitored ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.VisibilityOff)"
                           title="@(_movie.Monitored ? "Unmonitor" : "Monitor")" AriaLabel="@(_movie.Monitored ? "Unmonitor" : "Monitor")">
                    <span class="st-btn-label">@(_movie.Monitored ? "Monitored" : "Monitor")</span>
                </MudButton>
            }
            @if (IsAdmin)
            {
                <PinButton ProviderKey="tv" ItemKey="@MediaItemKeys.Movie(_tmdbId)" Title="@_movie.Title"
                           IsPinned="_stalePinned" OnToggled="OnPinToggled" AsButton="true" Disabled="_loading" />
                <MudButton OnClick="Delete" Variant="Variant.Outlined" Color="Color.Error" Disabled="@_loading"
                           StartIcon="@Icons.Material.Filled.Delete" title="Delete" AriaLabel="Delete">
                    <span class="st-btn-label">Delete</span>
                </MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TvMovie Movie { get; set; } = new();
    [Parameter] public bool IsSearchResult { get; set; }

    /// <summary>Non-admins get a read-only view: they can search/add but cannot delete or unmonitor.</summary>
    [Parameter] public bool IsAdmin { get; set; }

    TvMovie _movie = new();
    bool _loading = true;
    bool _showTrailer;
    string _movieStatus = "";
    List<QualityProfile> _profiles = [];
    List<RadarrQueueItemDto> _queueItems = [];
    List<TmdbCreditPerson> _cast = [];
    string? _trailerKey;
    string _backdropUrl = "";
    string _logoUrl = "";
    double? _rating;
    int? _runtime;
    string _certification = "";
    string _releaseDate = "";
    string _physicalRelease = "";
    string _digitalRelease = "";
    string _tagline = "";
    string _language = "";
    string _studio = "";
    string _jellyfinUrl = "";
    string _playUrl = "";
    int _tmdbId;
    StaleLevel _staleLevel = StaleLevel.Fresh;
    double? _staleDays;
    bool _staleBookmarked;
    string? _staleBookmark;
    bool _stalePinned;

    string PhysicalReleaseText => !string.IsNullOrEmpty(_physicalRelease)
        ? FormatHelper.FormatReleaseDate(_physicalRelease)
        : _movie.PhysicalRelease?.ToString("MMM dd, yyyy") ?? "";

    string DigitalReleaseText => !string.IsNullOrEmpty(_digitalRelease)
        ? FormatHelper.FormatReleaseDate(_digitalRelease)
        : _movie.DigitalRelease?.ToString("MMM dd, yyyy") ?? "";

    DateTime? PhysicalReleaseDate => FormatHelper.ParseReleaseDate(_physicalRelease) ?? _movie.PhysicalRelease;
    DateTime? DigitalReleaseDate => FormatHelper.ParseReleaseDate(_digitalRelease) ?? _movie.DigitalRelease;

    /// <summary>
    /// Radarr's generic "Released" is replaced with the specific release window the movie is in
    /// (In Cinema / Web Release / Physical Release) so the three stages are clearly distinct.
    /// </summary>
    string ReleaseStatusText => ReleaseStatus.MovieReleaseLabel(_movie.Status, _movie.InCinemas, DigitalReleaseDate, PhysicalReleaseDate);

    /// <summary>True while the movie has no web or physical release yet (unreleased / cinema-only).</summary>
    bool NotYetReleased => ReleaseStatus.MovieNotYetReleased(_movie.Status, _movie.InCinemas, DigitalReleaseDate, PhysicalReleaseDate);

    bool SearchEnabled => TvOptions.CurrentValue.Search.Enabled;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null && (await AuthStateTask).User.IsInRole(StackarrRoles.Admin))
            IsAdmin = true;

        _movie = Movie;
        _movieStatus = _movie.HasFile ? "Downloaded" : "Missing";
        _rating = _movie.Rating;
        _tmdbId = _movie.TmdbId;
        try
        {
            _profiles = await RadarrService.GetQualityProfiles();
        }
        catch
        {
        }
        await LoadQueue();
        await LoadStaleAsync();

        // Wait briefly for TMDB so the hero renders once with the final artwork/logo.
        // If TMDB is slow we fall back to the Radarr data and refresh when it lands.
        Task extras = Task.WhenAll(LoadTmdbExtras(), LoadJellyfinLink());
        Task finished = await Task.WhenAny(extras, Task.Delay(1500));
        if (finished != extras)
        {
            _ = extras.ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);
        }
        _loading = false;
    }

    async Task LoadJellyfinLink()
    {
        if (IsSearchResult || !_movie.HasFile)
            return;

        _jellyfinUrl = await JellyfinLinkService.GetMovieUrlAsync(_movie) ?? "";
        _playUrl = _jellyfinUrl;
        if (JellyfinLinkService.WebPlayerEnabled && JellyfinLinkService.ExtractItemId(_jellyfinUrl) is string itemId)
            _playUrl = JellyfinLinkService.BuildWatchUrl(itemId, _movie.Title, "/movies", _movie.PosterUrl);
    }

    async Task LoadQueue()
    {
        if (IsSearchResult) return;
        try
        {
            List<RadarrQueueItemDto> queue = await RadarrService.GetQueue();
            _queueItems = queue.Where(q => q.MovieId == _movie.Id).ToList();
        }
        catch
        {
            /* non-critical */
        }
    }

    void OnPinToggled(bool pinned) => _stalePinned = pinned;

    async Task LoadStaleAsync()
    {
        if (!Stale.IsAvailable || _tmdbId <= 0)
            return;
        try
        {
            MediaStaleState? status = await Stale.GetMovieStatusAsync(_tmdbId);
            if (status is not null)
            {
                _staleLevel = status.Level;
                _staleDays = status.DaysRemaining;
                _staleBookmarked = status.IsBookmarked;
                _staleBookmark = status.BookmarkLabel;
                _stalePinned = status.IsPinned;
            }
        }
        catch
        {
            /* non-critical */
        }
    }

    async Task LoadTmdbExtras()
    {
        if (!TmdbService.IsConfigured || _tmdbId <= 0)
            return;
        try
        {
            TmdbMovieDetail? detail = await TmdbService.GetMovieDetailAsync(_tmdbId);
            if (detail == null) return;
            _cast = detail.Credits?.Cast.Take(20).ToList() ?? [];
            _trailerKey = TmdbService.FindYouTubeTrailer(detail.Videos?.Results);
            _backdropUrl = !string.IsNullOrEmpty(detail.BackdropPath) ? TmdbService.GetBackdropUrl(detail.BackdropPath, "w1280") : "";
            _logoUrl = TmdbService.FindBestLogo(detail.Images?.Logos);
            _rating = detail.VoteAverage > 0 ? detail.VoteAverage : _rating;
            _runtime = detail.Runtime;
            _certification = ResolveCertification(detail.ReleaseDates?.Results
                ?.SelectMany(c => c.ReleaseDates.Select(r => (c.Country, r.Certification))).ToList());
            _releaseDate = detail.ReleaseDate ?? "";
            _physicalRelease = TmdbService.FindReleaseDate(detail.ReleaseDates, TmdbReleaseType.Physical, "GB", "US") ?? "";
            _digitalRelease = TmdbService.FindReleaseDate(detail.ReleaseDates, TmdbReleaseType.Digital, "GB", "US") ?? "";
            _tagline = detail.Tagline;
            _language = detail.OriginalLanguage;
            _studio = detail.ProductionCompanies.FirstOrDefault()?.Name ?? "";
        }
        catch
        {
            /* non-critical enrichment */
        }
    }

    static string ResolveCertification(List<(string Country, string Rating)>? ratings)
    {
        if (ratings == null) return "";
        (string Country, string Rating)? gb = ratings.FirstOrDefault(r => r.Country == "GB" && !string.IsNullOrWhiteSpace(r.Rating));
        if (gb is { Rating.Length: > 0 }) return gb.Value.Rating;
        (string Country, string Rating)? us = ratings.FirstOrDefault(r => r.Country == "US" && !string.IsNullOrWhiteSpace(r.Rating));
        if (us is { Rating.Length: > 0 }) return us.Value.Rating;
        return ratings.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.Rating)).Rating ?? "";
    }

    static string FormatRuntime(int minutes)
    {
        if (minutes <= 0) return "";
        if (minutes < 60) return $"{minutes}m";
        int h = minutes / 60;
        int m = minutes % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    void Close() => MudDialog.Cancel();

    async Task UploadMovie()
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can import local files.", Severity.Warning);
            return;
        }

        DialogParameters<TvUploadDialog> parameters = new()
        {
            { x => x.IsAdmin, true },
            { x => x.AutoDetect, false },
            { x => x.MediaType, "movie" },
            { x => x.TmdbId, _movie.TmdbId },
            { x => x.LibraryId, _movie.Id },
            { x => x.Title, _movie.Title },
            { x => x.Year, _movie.Year },
            { x => x.PosterUrl, _movie.PosterUrl },
            { x => x.HasExistingFile, _movie.HasFile },
        };

        DialogOptions options = new()
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<TvUploadDialog>($"Upload {_movie.Title}", parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
        {
            TvMovie? refreshed = await RadarrService.GetMovie(_movie.Id);
            if (refreshed is not null)
            {
                _movie = refreshed;
                _movieStatus = _movie.HasFile ? "Downloaded" : "Missing";
            }
        }
    }

    async Task OpenMediaInfo()
    {
        DialogParameters<MediaInfoDialog> parameters = new()
        {
            { x => x.Title, _movie.Title },
            { x => x.MovieId, _movie.Id },
            { x => x.Initial, _movie.File?.Technical }
        };
        DialogOptions options = new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<MediaInfoDialog>("Media Info", parameters, options);
    }

    async Task AddFromSearch()
    {
        DialogParameters<AddMovieDialog> parameters = new()
        {
            { x => x.Title, _movie.Title },
            { x => x.TmdbId, _tmdbId },
            { x => x.Profiles, _profiles }
        };
        DialogOptions options = new() { MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<AddMovieDialog>($"Add {_movie.Title}", parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
        {
            MudDialog.Close();
        }
    }

    async Task Search()
    {
        if (!SearchEnabled)
            return;

        _loading = true;
        StateHasChanged();
        try
        {
            await RadarrService.CommandSearchMovie(_movie.Id);
            Snackbar.Add("Search started.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
        _loading = false;
        StateHasChanged();
    }

    async Task OpenInteractiveSearch()
    {
        DialogParameters<StReleaseSearchDialog> parameters = new()
        {
            { x => x.Title, _movie.Title },
            { x => x.Subtitle, _movie.Year > 0 ? _movie.Year.ToString() : "" },
            { x => x.Providers, new List<ReleaseProvider> { RadarrReleases } },
            { x => x.Query, new ReleaseSearchQuery { Domain = TvMediaDomains.Movie, Kind = TvReleaseKinds.Movie, LibraryId = _movie.Id.ToString(), Title = _movie.Title, Noun = "a movie" } },
            { x => x.IsAdmin, IsAdmin }
        };
        DialogOptions options = new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<StReleaseSearchDialog>($"Interactive search · {_movie.Title}", parameters, options);
    }

    async Task Delete()
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can delete content.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            foreach (RadarrQueueItemDto q in _queueItems)
            {
                await RadarrService.DeleteQueueItem(q.Id, blocklist: false);
            }
            await RadarrService.DeleteMovie(_movie.Id, true);
            Snackbar.Add("Movie deleted.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        _loading = false;
        MudDialog.Close();
    }

    async Task ToggleMonitored()
    {
        if (!IsAdmin && _movie.Monitored)
        {
            Snackbar.Add("Only administrators can unmonitor content.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        await RadarrService.ToggleMonitored(_movie.Id, !_movie.Monitored);
        TvMovie? refreshed = await RadarrService.GetMovie(_movie.Id);
        if (refreshed != null)
        {
            _movie = refreshed;
        }
        _movieStatus = _movie.HasFile ? "Downloaded" : "Missing";
        _loading = false;
        StateHasChanged();
    }

    async Task CancelMovieDownload()
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can cancel downloads.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            foreach (RadarrQueueItemDto q in _queueItems)
            {
                await RadarrService.DeleteQueueItem(q.Id, blocklist: false);
            }
            Snackbar.Add("Download cancelled.", Severity.Info);
            await LoadQueue();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        _loading = false;
        StateHasChanged();
    }

    async Task RetryMovieSearch()
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can retry searches.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            foreach (RadarrQueueItemDto q in _queueItems)
            {
                await RadarrService.DeleteQueueItem(q.Id, blocklist: true);
            }
            if (_movie.HasFile)
            {
                List<MovieFileDto> files = await RadarrService.GetMovieFiles(_movie.Id);
                foreach (MovieFileDto f in files)
                {
                    await RadarrService.DeleteMovieFile(f.Id);
                }
                Snackbar.Add("Existing file removed & blocklisted. Searching again...", Severity.Info);
            }
            else
            {
                Snackbar.Add("Blocklisted existing. Searching again...", Severity.Info);
            }
            await RadarrService.CommandSearchMovie(_movie.Id);
            await Task.Delay(1000);
            await LoadQueue();
            TvMovie? refreshed = await RadarrService.GetMovie(_movie.Id);
            if (refreshed != null)
            {
                _movie = refreshed;
                _movieStatus = _movie.HasFile ? "Downloaded" : "Missing";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        _loading = false;
        StateHasChanged();
    }
}
