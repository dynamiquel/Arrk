@* Quick links to the TV library, injected into the Discover page header through the
   `discover.actions` region so the shell header never references the module. *@

<MudButton Href="/movies" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Movie"
           title="My Movies" AriaLabel="My Movies">
    <span class="st-btn-label">My Movies</span>
</MudButton>
<MudButton Href="/tv" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tv"
           title="My Shows" AriaLabel="My Shows">
    <span class="st-btn-label">My Shows</span>
</MudButton>
