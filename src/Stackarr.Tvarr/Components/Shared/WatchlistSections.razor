@using Stackarr.Core.Enums
@using Stackarr.Core.Playback
@implements IDisposable
@inject WatchlistService Watchlists
@inject IEnumerable<IExternalWatchlist> ExternalWatchlists
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<div class="st-watchlists">
    <div class="st-continue-head">
        @if (ShowTitle)
        {
            <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Watchlists</MudText>
        }
        <MudSpacer />
        @if (SelectedList is { IsExternal: false })
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                     ActivatorClassname="st-icon-btn st-icon-btn--neutral"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     title="Watchlist actions">
                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="RenameAsync">Edit</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Delete</MudMenuItem>
            </MudMenu>
        }
        else if (SelectedList is { ExternalHref: { } href })
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="@href"
                       StartIcon="@Icons.Material.Filled.OpenInNew" title="Open in MyAnimeList">
                View all
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   Class="st-watchlist-create"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
            New watchlist
        </MudButton>
    </div>

    @if (!_loaded)
    {
        <LoadingView />
    }
    else if (_lists.Count > 0)
    {
        <StTabs T="string" Items="WatchlistTabs" Value="_selectedId"
                ValueChanged="@((string id) => SelectList(id))"
                Variant="segmented" Class="st-watchlist-tabs" />

        @if (SelectedList is { } list)
        {
            if (list.Items.Count == 0 && list.ExternalItems.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.BookmarkBorder" Message="No titles in this watchlist"
                            Detail="@(list.IsExternal ? "Add anime to your MyAnimeList Plan to Watch list and they appear here." : "Use Add to Watchlist on a movie or show to keep it here.")" />
            }
            else
            {
                <ScrollRow TrackClass="st-watchlist-row">
                    @foreach (WatchlistItem item in list.Items)
                    {
                        <div class="st-watchlist-card-slot" @key="item.Id">
                            <MediaPosterCard ShowInLibraryBadge="false" Item="ToMediaItem(item)" CardSize="MediaCardSize.Small"
                                             IsAdmin="false" ShowWatchlistAction="true"
                                             OnClick="OnItemClick" />
                        </div>
                    }
                    @foreach (ExternalWatchlistItem item in list.ExternalItems.Take(20))
                    {
                        <div class="st-watchlist-card-slot" @key="item.Key">
                            <MediaPosterCard ShowInLibraryBadge="true" Item="ToMediaItem(item)" CardSize="MediaCardSize.Small"
                                             IsAdmin="false" ShowWatchlistAction="false"
                                             OnClick="() => OpenExternalAsync(item)" />
                        </div>
                    }
                </ScrollRow>
            }
        }
    }
</div>

@code {
    /// <summary>Restrict to movies or TV, or leave null on a dashboard tile to show both together.</summary>
    [Parameter] public MediaDomain? Domain { get; set; } = TvMediaDomains.Movie;

    /// <summary>Hide the shelf's own heading when it sits inside a dashboard tile frame.</summary>
    [Parameter] public bool ShowTitle { get; set; } = true;

    [Parameter] public IReadOnlyList<MediaItem> LibraryItems { get; set; } = [];
    [Parameter] public EventCallback<MediaItem> OnItemClick { get; set; }

    int _userId;
    bool _loaded;
    string _selectedId = "";
    List<ListState> _lists = [];

    ListState? SelectedList => _lists.FirstOrDefault(x => x.Id == _selectedId);

    IReadOnlyList<StTabItem<string>> WatchlistTabs =>
        _lists
            .Select(list => new StTabItem<string>(
                list.Id,
                list.Name,
                list.Icon,
                list.IsExternal ? null : (list.Items.Count + list.ExternalItems.Count).ToString(),
                IconUrl: list.IconUrl))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Watchlists.Changed += OnWatchlistsChanged;
        foreach (IExternalWatchlist external in ExternalWatchlists)
            external.Changed += OnWatchlistsChanged;

        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId))
            await LoadAsync();
    }

    void OnWatchlistsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    async Task LoadAsync()
    {
        List<WatchlistSummary> summaries = (await Watchlists.GetForUserAsync(_userId)).ToList();
        List<ListState> lists = [];

        // Service-backed lists (MyAnimeList Plan to Watch) come first. They are the "special"
        // shelves, so burying them after every personal list made them feel like an afterthought.
        foreach (IExternalWatchlist external in ExternalWatchlists.OrderBy(x => x.Order))
        {
            try
            {
                if (!await external.IsAvailableAsync(_userId))
                    continue;
                IReadOnlyList<ExternalWatchlistItem> items = Domain is { } domain
                    ? await external.GetItemsAsync(_userId, domain)
                    : (await external.GetItemsAsync(_userId, TvMediaDomains.Movie))
                        .Concat(await external.GetItemsAsync(_userId, TvMediaDomains.Tv))
                        .OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                lists.Add(new ListState(
                    $"ext:{external.Key}",
                    external.Name,
                    external.Icon,
                    [],
                    items,
                    ExternalHref: external.ViewAllHref,
                    IconUrl: external.IconUrl));
            }
            catch
            {
                /* an unavailable external service must not hide the normal watchlists */
            }
        }

        foreach (WatchlistSummary summary in summaries)
        {
            WatchlistDetail? detail = await Watchlists.GetAsync(_userId, summary.Id);
            List<WatchlistItem> items = detail?.Items
                .Where(x => Domain is null || x.Domain == Domain)
                .ToList() ?? [];
            lists.Add(new ListState(
                $"user:{summary.Id}",
                summary.Name,
                Icons.Material.Filled.Bookmark,
                items,
                [],
                ExternalHref: null,
                IconUrl: null));
        }

        _lists = lists;

        if (_lists.Count > 0 && _lists.All(x => x.Id != _selectedId))
            _selectedId = _lists[0].Id;

        _loaded = true;
    }

    void SelectList(string id) => _selectedId = id;

    async Task OpenExternalAsync(ExternalWatchlistItem item)
    {
        if (!string.IsNullOrEmpty(item.Href))
        {
            Nav.NavigateTo(item.Href);
            return;
        }

        // External lists that represent local media (MyAnimeList) use the existing TV/movie
        // detail popup. The provider hides entries with no corresponding TMDB identity.
        await OnItemClick.InvokeAsync(ToMediaItem(item));
    }

    MediaItem ToMediaItem(WatchlistItem item)
    {
        MediaItem? library = LibraryItems.FirstOrDefault(x => item.Domain.Value switch
        {
            TvMediaDomains.Movie => x.MediaType == "movie" && item.TmdbId > 0 && x.TmdbId == item.TmdbId,
            TvMediaDomains.Tv => x.MediaType == "tv"
                && ((item.TvdbId > 0 && x.TvdbId == item.TvdbId) || (item.TmdbId > 0 && x.TmdbId == item.TmdbId)),
            _ => false
        });
        if (library is not null)
            return library;

        return new MediaItem
        {
            Title = item.Title,
            Year = item.Year ?? 0,
            PosterUrl = item.PosterUrl ?? "",
            MediaType = item.Domain == TvMediaDomains.Tv ? "tv" : "movie",
            TmdbId = item.TmdbId,
            TvdbId = item.TvdbId,
            IsInLibrary = false
        };
    }

    MediaItem ToMediaItem(ExternalWatchlistItem item)
    {
        MediaItem? library = LibraryItems.FirstOrDefault(x => item.Domain.Value switch
        {
            TvMediaDomains.Movie => x.MediaType == "movie" && item.TmdbId > 0 && x.TmdbId == item.TmdbId,
            TvMediaDomains.Tv => x.MediaType == "tv"
                && ((item.TvdbId > 0 && x.TvdbId == item.TvdbId) || (item.TmdbId > 0 && x.TmdbId == item.TmdbId)),
            _ => false
        });
        if (library is not null)
            return library;

        return new MediaItem
        {
            Title = item.Title,
            Year = item.Year ?? 0,
            PosterUrl = item.PosterUrl ?? "",
            MediaType = item.Domain == TvMediaDomains.Tv ? "tv" : "movie",
            TmdbId = item.TmdbId,
            TvdbId = item.TvdbId,
            IsInLibrary = item.IsInLibrary,
            Overview = item.Overview ?? "",
            Genres = item.Genres?.ToList() ?? [],
            Rating = item.Rating,
            RuntimeMinutes = item.RuntimeMinutes,
            OriginalTitle = item.OriginalTitle ?? "",
            SeasonLabel = item.SeasonLabel ?? ""
        };
    }

    async Task CreateAsync()
    {
        if (_lists.Count(x => !x.IsExternal) >= WatchlistLimits.MaxListsPerUser)
        {
            Snackbar.Add($"You can have at most {WatchlistLimits.MaxListsPerUser} watchlists.", Severity.Warning);
            return;
        }

        DialogOptions options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<CreateWatchlistDialog>("New watchlist", new DialogParameters(), options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false, Data: WatchlistDetail created })
            _selectedId = $"user:{created.Id}";
        await LoadAsync();
    }

    async Task RenameAsync()
    {
        if (SelectedList is not { IsExternal: false } list)
            return;

        DialogParameters<CreateWatchlistDialog> parameters = new()
        {
            { x => x.WatchlistId, int.Parse(list.Id.Replace("user:", "")) },
            { x => x.InitialName, list.Name }
        };
        DialogOptions options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<CreateWatchlistDialog>("Rename watchlist", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    async Task DeleteAsync()
    {
        if (SelectedList is not { IsExternal: false } list)
            return;

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Delete watchlist",
            $"Delete \"{list.Name}\"? The titles stay in your library; only the list is removed.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirm != true)
            return;
        await Watchlists.DeleteAsync(_userId, int.Parse(list.Id.Replace("user:", "")));
        Snackbar.Add("Watchlist deleted.", Severity.Success);
        await LoadAsync();
    }

    public void Dispose()
    {
        Watchlists.Changed -= OnWatchlistsChanged;
        foreach (IExternalWatchlist external in ExternalWatchlists)
            external.Changed -= OnWatchlistsChanged;
    }

    sealed record ListState(
        string Id,
        string Name,
        string Icon,
        List<WatchlistItem> Items,
        IReadOnlyList<ExternalWatchlistItem> ExternalItems,
        string? ExternalHref,
        string? IconUrl)
    {
        public bool IsExternal => Id.StartsWith("ext:", StringComparison.Ordinal);
    }
}
