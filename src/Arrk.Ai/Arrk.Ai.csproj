<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The optional AI module: provider-agnostic chat/ranking plumbing (Microsoft.Extensions.AI),
    usage accounting, the assistant tool registry and its shell surface. It references no domain
    module — modules contribute tools and media sources through the contracts in this assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arrk.Core\Arrk.Core.csproj" />
    <ProjectReference Include="..\Arrk.Ui\Arrk.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <!-- Module endpoints and Razor components need the ASP.NET Core shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arrk.Ai.Tests" />
  </ItemGroup>

</Project>
