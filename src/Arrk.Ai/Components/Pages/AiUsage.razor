@page "/ai"
@attribute [Authorize(Policy = ArrkPolicies.AdminOnly)]
@inject AiService Ai
@inject AiUsageService Usage
@inject AiCache Cache
@inject AiBudget Budget
@inject AiDecisionService Decisions
@inject IEnumerable<IAiFeatureDescriptor> FeatureDescriptors
@inject IOptionsMonitor<AiConfig> AiOptions
@inject ISnackbar Snackbar

<PageTitle>Arrk - AI Usage</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.AutoAwesome" Title="AI Usage">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_loading" OnClick="LoadAsync">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="st-btn-gradient"
                   StartIcon="@Icons.Material.Filled.Bolt" Disabled="@(_loading || _testing || !Ai.Enabled)"
                   OnClick="TestAsync">
            @(_testing ? "Testing…" : "Test AI")
        </MudButton>
    </Actions>
</PageHeader>

@if (!Ai.Enabled)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        AI is off. Enable it and configure a provider in
        <MudLink Href="/config">Configuration → AI</MudLink>.
    </MudAlert>
}

@if (_testResult is not null)
{
    <MudAlert Severity="@(_testFailed ? Severity.Error : Severity.Success)" Variant="Variant.Outlined" Class="mb-4">
        @_testResult
    </MudAlert>
}

@if (_loading && _summary is null)
{
    <LoadingView Message="Loading AI usage…" />
}
else
{
    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="ai.calls" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="ai.tokens" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="ai.failures" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="ai.cache" Placement="TilePlacement.Page" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <SectionContainer Icon="@Icons.Material.Filled.Tune" Title="Configuration">
                <div class="st-info-grid">
                    <InfoGridRow Label="Status">@(Ai.Enabled ? "Enabled" : "Disabled")</InfoGridRow>
                    <InfoGridRow Label="Provider">@config.Provider</InfoGridRow>
                    <InfoGridRow Label="Chat model">@config.ResolveChatModel()</InfoGridRow>
                    <InfoGridRow Label="Fast model">@config.ResolveFastModel()</InfoGridRow>
                    <InfoGridRow Label="Budget">@BudgetText</InfoGridRow>
                    <InfoGridRow Label="Estimated cost (30d)">@CostText</InfoGridRow>
                </div>
            </SectionContainer>
        </MudItem>
        <MudItem xs="12" lg="5">
            <SectionContainer Icon="@Icons.Material.Filled.Timer" Title="Recent activity">
                @if (_recent.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.HourglassEmpty" Message="No AI calls recorded yet." />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mb-2">
                        Last @_recent.Count calls · average @AverageLatency ms
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="PurgeCacheAsync">
                        Purge expired cache
                    </MudButton>
                }
            </SectionContainer>
        </MudItem>
    </MudGrid>

    <div class="mt-4">
        <SectionContainer Icon="@Icons.Material.Filled.Tune" Title="Features">
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
                @foreach (IAiFeatureDescriptor feature in FeatureDescriptors)
                {
                    <StChip Variant="@(feature.IsEnabled ? "success" : "neutral")" title="@feature.Description">
                        @feature.Name
                    </StChip>
                }
            </div>
            <MudText Typo="Typo.caption">
                Each feature has its own toggle in <MudLink Href="/config">Configuration → AI</MudLink>.
            </MudText>
        </SectionContainer>
    </div>

    <div class="mt-4">
        <SectionContainer Icon="@Icons.Material.Filled.Insights" Title="Usage by feature">
            @if (_summary is null || _summary.Features.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.Insights" Message="Nothing has used AI in the last 30 days." />
            }
            else
            {
                <MudTable Items="_summary.Features" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Feature</MudTh>
                        <MudTh Align="Right">Calls</MudTh>
                        <MudTh Align="Right">Tokens</MudTh>
                        <MudTh Align="Right">Failures</MudTh>
                        <MudTh Align="Right">Avg time</MudTh>
                        <MudTh>Last used</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Feature">@context.Feature</MudTd>
                        <MudTd DataLabel="Calls" Align="Right">@context.Calls.ToString("N0")</MudTd>
                        <MudTd DataLabel="Tokens" Align="Right">@FormatTokens(context.TotalTokens)</MudTd>
                        <MudTd DataLabel="Failures" Align="Right">@context.Failures.ToString("N0")</MudTd>
                        <MudTd DataLabel="Avg time" Align="Right">@context.AverageDurationMs ms</MudTd>
                        <MudTd DataLabel="Last used">@FormatWhen(context.LastUsedAt)</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </SectionContainer>
    </div>

    <div class="mt-4">
        <SectionContainer Icon="@Icons.Material.Filled.MilitaryTech" Title="Release ranking">
            @if (_decisionSummary is null || _decisionSummary.Decisions == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.MilitaryTech"
                            Message="No ranking decisions recorded yet."
                            Detail="Enable ai.features.releaseRanking in shadow mode to compare the model with the deterministic pick without changing behaviour." />
            }
            else
            {
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="6" md="2"><StatTile Label="Decisions" Value="@_decisionSummary.Decisions.ToString("N0")" ValueColor="purple" /></MudItem>
                    <MudItem xs="6" md="2"><StatTile Label="Agreement" Value="@($"{_decisionSummary.AgreementRate:P0}")" ValueColor="blue" /></MudItem>
                    <MudItem xs="6" md="2"><StatTile Label="Applied" Value="@_decisionSummary.Applied.ToString("N0")" ValueColor="green" /></MudItem>
                    <MudItem xs="6" md="2"><StatTile Label="Imported" Value="@_decisionSummary.Imported.ToString("N0")" ValueColor="green" /></MudItem>
                    <MudItem xs="6" md="2"><StatTile Label="Mismatched" Value="@_decisionSummary.Mismatched.ToString("N0")" ValueColor="red" /></MudItem>
                    <MudItem xs="6" md="2"><StatTile Label="Pending" Value="@_decisionSummary.Pending.ToString("N0")" ValueColor="yellow" /></MudItem>
                </MudGrid>

                <MudTable Items="_decisions" Dense="true" Hover="true" Breakpoint="Breakpoint.Md">
                    <HeaderContent>
                        <MudTh>When</MudTh>
                        <MudTh>Requested</MudTh>
                        <MudTh>Mode</MudTh>
                        <MudTh>Deterministic</MudTh>
                        <MudTh>AI pick</MudTh>
                        <MudTh>AI context</MudTh>
                        <MudTh Align="Right">Confidence</MudTh>
                        <MudTh>Outcome</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="When">@FormatWhen(context.Timestamp)</MudTd>
                        <MudTd DataLabel="Requested">@(string.IsNullOrWhiteSpace(context.Request) ? context.Subject : context.Request)</MudTd>
                        <MudTd DataLabel="Mode">@context.Mode</MudTd>
                        <MudTd DataLabel="Deterministic">@context.DeterministicChoice</MudTd>
                        <MudTd DataLabel="AI pick" title="@context.Reason">@context.AiChoice</MudTd>
                        <MudTd DataLabel="AI context">
                            @if (string.IsNullOrWhiteSpace(context.Context))
                            {
                                <span>—</span>
                            }
                            else
                            {
                                <details>
                                    <summary>View</summary>
                                    <pre class="st-ai-context">@context.Context</pre>
                                </details>
                            }
                        </MudTd>
                        <MudTd DataLabel="Confidence" Align="Right">@($"{context.Confidence:P0}")</MudTd>
                        <MudTd DataLabel="Outcome">@(context.Outcome ?? (context.Applied ? "pending" : "not applied"))</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </SectionContainer>
    </div>

    <div class="mt-4">
        <SectionContainer Icon="@Icons.Material.Filled.History" Title="Recent calls">
            @if (_recent.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.History" Message="No calls recorded yet." />
            }
            else
            {
                <MudTable Items="_recent" Dense="true" Hover="true" Breakpoint="Breakpoint.Md">
                    <HeaderContent>
                        <MudTh>When</MudTh>
                        <MudTh>Feature</MudTh>
                        <MudTh>Operation</MudTh>
                        <MudTh>Model</MudTh>
                        <MudTh Align="Right">Tokens</MudTh>
                        <MudTh Align="Right">Time</MudTh>
                        <MudTh>Result</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="When">@FormatWhen(context.Timestamp)</MudTd>
                        <MudTd DataLabel="Feature">@context.Feature</MudTd>
                        <MudTd DataLabel="Operation">@context.Operation</MudTd>
                        <MudTd DataLabel="Model">@context.Model</MudTd>
                        <MudTd DataLabel="Tokens" Align="Right">@FormatTokens(context.PromptTokens + context.CompletionTokens)</MudTd>
                        <MudTd DataLabel="Time" Align="Right">@context.DurationMs ms</MudTd>
                        <MudTd DataLabel="Result">
                            <StChip Variant="@(context.Success ? "success" : "error")">
                                @(context.Success ? "ok" : "failed")
                            </StChip>
                            @if (context.CacheHit)
                            {
                                <StChip Variant="info">cached</StChip>
                            }
                            @if (!string.IsNullOrEmpty(context.Error))
                            {
                                <MudText Typo="Typo.caption">@context.Error</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </SectionContainer>
    </div>
}

@code {
    AiUsageSummary? _summary;
    AiDecisionSummary? _decisionSummary;
    IReadOnlyList<AiDecisionOutcome> _decisions = [];
    IReadOnlyList<AiUsageRecord> _recent = [];
    int? _remainingToday;
    bool _loading = true;
    bool _testing;
    string? _testResult;
    bool _testFailed;

    AiConfig config => AiOptions.CurrentValue;

    string BudgetText => _remainingToday is null
        ? (config.Limits.MaxRequestsPerDay <= 0 ? "Unlimited" : $"{config.Limits.MaxRequestsPerDay:N0}/day")
        : $"{_remainingToday:N0} of {config.Limits.MaxRequestsPerDay:N0} left today";

    string CostText
    {
        get
        {
            if (_summary is null
                || (config.Pricing.InputPerMillion <= 0 && config.Pricing.OutputPerMillion <= 0))
                return "Set ai.pricing to estimate";

            decimal input = _summary.PromptTokens / 1_000_000m * config.Pricing.InputPerMillion;
            decimal output = _summary.CompletionTokens / 1_000_000m * config.Pricing.OutputPerMillion;
            return (input + output).ToString("C4", CultureInfo.CurrentCulture);
        }
    }

    long AverageLatency => _summary is null || _summary.Calls == 0
        ? 0
        : _summary.DurationMs / _summary.Calls;

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        try
        {
            DateTime since = DateTime.UtcNow.AddDays(-30);
            _summary = await Usage.GetSummaryAsync(since);
            _recent = await Usage.GetRecentAsync(25);
            _decisionSummary = await Decisions.GetSummaryAsync(since);
            _decisions = await Decisions.GetRecentAsync(15);
            _remainingToday = await Budget.RemainingRequestsTodayAsync(config);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task TestAsync()
    {
        _testing = true;
        _testResult = null;
        try
        {
            using CancellationTokenSource timeout = new(TimeSpan.FromSeconds(30));
            string? answer = await Ai.AskAsync(
                "Reply with the single word: OK",
                AiModelRole.Chat,
                AiFeatureKeys.Assistant,
                "admin.test",
                userId: null,
                timeout.Token);

            _testFailed = string.IsNullOrWhiteSpace(answer);
            _testResult = _testFailed
                ? "AI returned no answer. Check the model and endpoint."
                : $"AI answered: {answer.Trim()}";
            Snackbar.Add(_testFailed ? "AI test failed." : "AI test passed.",
                _testFailed ? Severity.Warning : Severity.Success);
        }
        catch (OperationCanceledException)
        {
            _testFailed = true;
            _testResult = "AI test timed out (30s). Check the endpoint and model.";
            Snackbar.Add("AI test timed out.", Severity.Warning);
        }
        catch (Exception ex)
        {
            _testFailed = true;
            string message = ex.Message.Length > 300 ? ex.Message[..300] : ex.Message;
            _testResult = $"AI test failed: {message}";
            Snackbar.Add(message, Severity.Error);
        }
        finally
        {
            _testing = false;
            await LoadAsync();
        }
    }

    async Task PurgeCacheAsync()
    {
        int removed = await Cache.PurgeExpiredAsync();
        Snackbar.Add(removed == 0 ? "No expired cache entries." : $"Removed {removed} expired entries.",
            Severity.Info);
        await LoadAsync();
    }

    static string FormatTokens(long tokens) => tokens >= 1_000_000
        ? $"{tokens / 1_000_000.0:0.0}M"
        : tokens >= 1_000 ? $"{tokens / 1_000.0:0.0}k" : tokens.ToString("N0");

    static string FormatBytes(long bytes) => bytes >= 1_048_576
        ? $"{bytes / 1_048_576.0:0.0} MB"
        : $"{bytes / 1024.0:0.0} KB";

    static string FormatWhen(DateTime? at) =>
        at is null ? "—" : at.Value.ToLocalTime().ToString("MMM d, HH:mm");
}
