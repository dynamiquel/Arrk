@inject UiRegistry Registry
@implements IDisposable

@*
    Renders every slot contributed to this region, filtered by role and live availability, and
    isolated so a broken contribution can never take down the surrounding page. Modules inject
    here by decorating a component with [UiRegion("<Name>")] or by registering a UiSlot.
*@
@foreach (UiSlot slot in Registry.SlotsFor(Name))
{
    <ErrorBoundary @key="slot">
        <ChildContent>
            @if (slot.AdminOnly)
            {
                <AuthorizeView Policy="@ArrkPolicies.AdminOnly">
                    <DynamicComponent Type="slot.Component" Parameters="ParametersFor(slot)" />
                </AuthorizeView>
            }
            else
            {
                <DynamicComponent Type="slot.Component" Parameters="ParametersFor(slot)" />
            }
        </ChildContent>
        <ErrorContent Context="exception">
            <span class="st-uiregion-error" role="alert" title="@exception.Message">&#x26A0;</span>
        </ErrorContent>
    </ErrorBoundary>
}

@code {
    /// <summary>The region id modules target (e.g. <see cref="UiRegions.ShellOverlays"/>).</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Optional context handed to contributions that declare a matching <c>Context</c> parameter.</summary>
    [Parameter] public object? Context { get; set; }

    Dictionary<string, object?> ParametersFor(UiSlot slot)
    {
        Dictionary<string, object?> parameters = new();
        if (slot.Parameters is { Count: > 0 })
        {
            foreach (KeyValuePair<string, object?> parameter in slot.Parameters)
            {
                parameters[parameter.Key] = parameter.Value;
            }
        }

        // Only hand down context to components that actually declare it, so plain contributions
        // (buttons, badges) don't trip over an unexpected parameter.
        if (Context is not null && slot.Component.GetProperty("Context") is not null)
        {
            parameters["Context"] = Context;
        }

        return parameters;
    }

    protected override void OnInitialized() => Registry.Changed += OnRegistryChanged;

    void OnRegistryChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Registry.Changed -= OnRegistryChanged;
}
