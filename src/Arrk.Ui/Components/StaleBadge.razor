@* Compact lifecycle indicator for cards and dialogs: a stale/expiring warning, or a pin marker
   when an admin has pinned the item so it never goes stale. Renders nothing for a plain fresh item,
   so callers can drop it onto every card/dialog without conditional markup. *@
@using Arrk.Core.Lifecycle
@using MudBlazor

@if (IsPinned && ShowPinned)
{
    <span class="st-stale-badge st-stale-badge--pinned @Class" title="Pinned — this item is excluded from staleness and cleanup">
        <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Style="font-size:0.78rem;" />
        <span>Pinned</span>
    </span>
}
else if (Level != StaleLevel.Fresh)
{
    <span class="st-stale-badge st-stale-badge--@(Level == StaleLevel.Stale ? "stale" : "expiring") @Class"
          title="@Tooltip">
        <MudIcon Icon="@Icon" Size="Size.Small" Style="font-size:0.78rem;" />
        <span>@Label</span>
        @if (ShowBookmarked)
        {
            <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" Style="font-size:0.72rem;margin-left:2px;" />
        }
    </span>
}

@code {
    [Parameter] public StaleLevel Level { get; set; }
    [Parameter] public double? DaysRemaining { get; set; }
    [Parameter] public bool ShowBookmarked { get; set; }
    [Parameter] public string? BookmarkLabel { get; set; }
    [Parameter] public bool IsPinned { get; set; }

    /// <summary>Set false when a surrounding surface already shows the pin state (e.g. a Pin button).</summary>
    [Parameter] public bool ShowPinned { get; set; } = true;

    [Parameter] public string Class { get; set; } = "";

    string Label => Level == StaleLevel.Stale
        ? "Stale"
        : DaysRemaining is { } days && days > 0
            ? $"{days:0.#}d left"
            : "Leaving soon";

    string Icon => Level == StaleLevel.Stale
        ? Icons.Material.Filled.DeleteSweep
        : Icons.Material.Filled.HourglassBottom;

    string Tooltip => (Level == StaleLevel.Stale
        ? "This item is stale and can be reclaimed"
        : $"This item becomes stale in {DaysRemaining:0.#} days") + BookmarkedSuffix;

    string BookmarkedSuffix => ShowBookmarked
        ? $" · kept in {BookmarkLabel ?? "a list"}"
        : "";
}
