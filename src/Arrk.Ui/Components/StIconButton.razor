@* Small square action icon button, the single design for monitor / remove / close /
   pause / resume / delete / refresh controls (see .st-icon-btn in the theme). Set
   Overlay when the button sits on artwork so it keeps its glass backing. *@

<MudTooltip Text="@Title" Disabled="@(string.IsNullOrEmpty(Title))">
    <MudIconButton Icon="@Icon"
                   Size="@Size"
                   Disabled="@Disabled"
                   StopPropagation="@StopPropagation"
                   Href="@Href"
                   Target="@Target"
                   Class="@CssClass"
                   OnClick="OnClick"
                   title="@Title"
                   AriaLabel="@(string.IsNullOrEmpty(AriaLabel) ? Title : AriaLabel)" />
</MudTooltip>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>Tooltip + accessible label.</summary>
    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public ActionVariant Variant { get; set; } = ActionVariant.Neutral;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Glass backing for buttons placed over artwork.</summary>
    [Parameter] public bool Overlay { get; set; }

    [Parameter] public bool StopPropagation { get; set; }

    /// <summary>Renders the action as a link (opens the target when clicked).</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public string? Target { get; set; }

    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    [Parameter] public string Class { get; set; } = "";

    string CssClass =>
        $"st-icon-btn st-icon-btn--{Variant.ToString().ToLowerInvariant()}{(Overlay ? " st-icon-btn--overlay" : "")} {Class}".Trim();
}
