@* Key/value info grid row - use inside a div with class="st-info-grid" *@

<div>
    <span class="st-info-label">@Label</span>
    @if (Monospace)
    {
        <div class="@(Break ? "st-info-value--break" : "st-info-value")">@ChildContent</div>
    }
    else
    {
        <div>@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Monospace { get; set; } = true;
    [Parameter] public bool Break { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
