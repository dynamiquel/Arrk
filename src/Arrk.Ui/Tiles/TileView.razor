@namespace Arrk.Ui

@inject AuthenticationStateProvider AuthProvider
@inject TileRegistry Tiles

@*
    The shared frame for every tile: icon, contextual title and optional navigation. A module
    supplies only the body component; this keeps tiles visually identical on the dashboard and on
    their owning page, and makes the dashboard's category prefix automatic.
*@

@if (_loaded && _definition is not null && (!_definition.AdminOnly || _isAdmin))
{
    if (HasLink)
    {
        <a class="st-tile-link" href="@_definition.Href" aria-label="@_definition.TitleFor(Placement)">
            @Card(_definition)
        </a>
    }
    else
    {
        @Card(_definition)
    }
}

@code {
    /// <summary>The catalog definition this view renders. Pass it directly, or use <see cref="Id"/>.</summary>
    [Parameter] public TileDefinition? Definition { get; set; }

    /// <summary>Catalog id, resolved through <see cref="TileRegistry"/>. Used by pages that render a tile inline.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Dashboard tiles show the category prefix; page tiles keep their short title.</summary>
    [Parameter] public TilePlacement Placement { get; set; } = TilePlacement.Page;

    /// <summary>The signed-in account, passed to the body through <see cref="TileContext"/>.</summary>
    [Parameter] public int UserId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    TileDefinition? _definition;
    bool _loaded;
    bool _isAdmin;
    int _contextUserId;

    bool HasLink =>
        Placement == TilePlacement.Dashboard
        && _definition is not null
        && !string.IsNullOrWhiteSpace(_definition.Href)
        && (!_definition.LinkAdminOnly || _isAdmin);

    protected override async Task OnParametersSetAsync()
    {
        _definition = Definition ?? Tiles.Find(Id);
        _contextUserId = UserId;
        if (_loaded)
            return;

        if (AuthStateTask is not null)
        {
            AuthenticationState auth = await AuthStateTask;
            _isAdmin = auth.User.IsInRole(ArrkRoles.Admin);
            if (_contextUserId <= 0)
                int.TryParse(auth.User.FindFirst(ArrkClaims.UserIdClaim)?.Value, out _contextUserId);
        }

        _loaded = true;
    }

    RenderFragment Card(TileDefinition definition) =>
        @<div class="st-stat-card st-tile">
            <div class="st-stat-label st-tile-label">
                <MudIcon Icon="@definition.Icon" Size="Size.Small" Style="font-size:1rem;" />
                @if (Placement == TilePlacement.Dashboard)
                {
                    <span class="st-tile-category">@definition.Category.ToUpperInvariant()</span>
                    <span class="st-tile-separator" aria-hidden="true">-</span>
                }
                <span class="st-tile-title">@definition.Title</span>
            </div>
            <ErrorBoundary>
                <ChildContent>
                    <DynamicComponent Type="definition.Component" Parameters="BodyParameters(definition)" />
                </ChildContent>
                <ErrorContent Context="exception">
                    <span class="st-tile-error" role="alert" title="@exception.Message">Tile unavailable</span>
                </ErrorContent>
            </ErrorBoundary>
        </div>;

    Dictionary<string, object?> BodyParameters(TileDefinition definition)
    {
        Dictionary<string, object?> parameters = new();
        if (definition.Parameters is { Count: > 0 })
        {
            foreach (KeyValuePair<string, object?> parameter in definition.Parameters)
                parameters[parameter.Key] = parameter.Value;
        }

        if (definition.Component.GetProperty("Context") is not null)
            parameters["Context"] = new TileContext(definition, Placement, _isAdmin, _contextUserId);

        return parameters;
    }
}
