<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Auth contracts shared by the shell and every module that creates users, links an external
    identity or mirrors accounts into a media player. The implementation is Stackarr.Auth.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
