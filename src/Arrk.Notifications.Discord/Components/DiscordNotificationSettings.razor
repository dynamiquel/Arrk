@attribute [UiRegion("notifications.settings")]
@inject UserNotificationChannelService UserChannels
@inject IExternalIdentityStore Identities
@inject DiscordNotificationClient Discord
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<div class="st-notif-compact">
    <span class="st-discord-logo st-brand-mask"
          style="--st-brand-url:url('/img/discord-logo.svg')"></span>
    <div class="st-notif-compact-text">
        <div class="st-notif-compact-title">Discord</div>
        <div class="st-notif-compact-state">@DiscordState</div>
    </div>
    <div class="st-notif-compact-actions">
        @if (_dmConfigured && !_discordLinked)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/account"
                       StartIcon="@Icons.Material.Filled.Link">
                Link Discord
            </MudButton>
        }
        else if (_dmConfigured && _discordLinked)
        {
            <MudSwitch T="bool" Value="_dmEnabled" ValueChanged="SetDmEnabledAsync"
                       Color="Color.Primary" />
            <StIconButton Icon="@Icons.Material.Filled.Send" Title="Send test message"
                          OnClick="SendTestAsync" Disabled="@_testing" />
        }
    </div>
</div>

@code {
    int _userId;
    bool _discordLinked;
    bool _dmConfigured;
    bool _dmEnabled;
    bool _testing;

    string DiscordState => !_dmConfigured
        ? "Direct messages are not enabled."
        : !_discordLinked
            ? "Link Discord to receive direct messages."
            : _dmEnabled ? "On." : "Off.";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(ArrkClaims.UserIdClaim)?.Value, out _userId))
            return;

        _dmConfigured = Discord.CanSendDirectMessages;
        IReadOnlyList<Microsoft.AspNetCore.Identity.UserLoginInfo> logins =
            await Identities.GetExternalLoginsAsync(_userId);
        _discordLinked = logins.Any(login =>
            string.Equals(login.LoginProvider, ExternalLoginSchemes.Discord, StringComparison.OrdinalIgnoreCase));

        UserNotificationChannel? binding = await UserChannels.GetAsync(
            _userId, DiscordNotificationClient.ChannelName);
        _dmEnabled = binding is null || binding.Enabled;
    }

    async Task SetDmEnabledAsync(bool enabled)
    {
        _dmEnabled = enabled;
        try
        {
            await UserChannels.SetEnabledAsync(_userId, DiscordNotificationClient.ChannelName, enabled);
        }
        catch (Exception ex)
        {
            _dmEnabled = !enabled;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task SendTestAsync()
    {
        _testing = true;
        try
        {
            NotificationDeliveryResult result = await Discord.SendTestAsync(_userId);
            Snackbar.Add(
                result.Success ? "Test message sent. Check your Discord DMs." : result.Error ?? "Could not send the test message.",
                result.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _testing = false;
        }
    }
}
