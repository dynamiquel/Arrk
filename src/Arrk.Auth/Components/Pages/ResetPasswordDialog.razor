@inject UserService Users

<MudDialog>
    <TitleContent>
        <StDialogTitle Icon="@Icons.Material.Filled.Key" Title="Reset password" />
    </TitleContent>
    <DialogContent>
        <DialogCloseButton Class="st-dialog-close--floating" />
        <MudStack Spacing="3" Class="mt-2">
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            <MudText Typo="Typo.body2">Set a new password for <strong>@User.DisplayName</strong> (@User.Username).</MudText>
            <MudTextField @bind-Value="_password" Label="New password" Variant="Variant.Outlined" InputType="InputType.Password" />
            <MudTextField @bind-Value="_confirm" Label="Confirm password" Variant="Variant.Outlined" InputType="InputType.Password" />
            <MudText Typo="Typo.caption" Style="color:var(--st-text-muted);">
                This also updates the password in connected media players.
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="st-btn-gradient" StartIcon="@Icons.Material.Filled.Key" OnClick="SaveAsync" Disabled="@_busy">
            <span class="st-btn-label">Reset</span>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ArrkUser User { get; set; } = null!;

    string _password = "";
    string _confirm = "";
    string? _error;
    bool _busy;

    async Task SaveAsync()
    {
        if (_busy) return;
        if (_password != _confirm)
        {
            _error = "Passwords do not match.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Users.ResetPasswordAsync(User.Id, _password);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    void Cancel() => MudDialog.Cancel();
}
