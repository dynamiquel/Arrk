<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Authentication module: ASP.NET Core Identity, Arrk accounts, the OpenIddict provider,
    login/register endpoints and the account/users UI. The shell references this module only via
    the shared contracts and UI regions.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arrk.Core\Arrk.Core.csproj" />
    <ProjectReference Include="..\Arrk.Auth.Abstractions\Arrk.Auth.Abstractions.csproj" />
    <ProjectReference Include="..\Arrk.Ui\Arrk.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Arrk.Auth.Abstractions" />
    <Using Include="Arrk.Core" />
    <Using Include="Arrk.Core.Services" />
  </ItemGroup>
</Project>
