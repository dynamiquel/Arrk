@using Arrk.Notifications
@inject NotificationEventRegistry Registry

@* Unified event feed: every audit event, with notification events rendered as a special kind of
   event (emoji + topic badge) using the notification catalogue's styling. *@

<div class="st-event-feed @Class">
    @if (Loading)
    {
        <div class="st-event-feed-empty">
            <LoadingView Size="Size.Medium" Message="Loading events..." />
        </div>
    }
    else if (Items.Count == 0)
    {
        <div class="st-event-feed-empty">
            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">No events found</MudText>
            @if (!string.IsNullOrWhiteSpace(EmptyMessage))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@EmptyMessage</MudText>
            }
        </div>
    }
    else
    {
        @foreach (EventFeedItem item in Items)
        {
            NotificationStyle? style = item.IsNotification ? Registry.StyleFor(item.Topic!) : null;
            <div class="st-event-feed-item st-event-feed-item--@SeverityClass(item.Severity)">
                <div class="st-event-feed-icon">
                    @if (!string.IsNullOrEmpty(style?.Emoji))
                    {
                        <span class="st-event-feed-emoji" aria-hidden="true">@style.Emoji</span>
                    }
                    else
                    {
                        <MudIcon Icon="@SeverityIcon(item.Severity)" Size="Size.Small" />
                    }
                </div>
                <div class="st-event-feed-body">
                    <div class="st-event-feed-line">
                        @* Category leads the line so it can be scanned/filtered with the eye. *@
                        <span class="st-event-feed-cat">@item.Category</span>
                        @if (item.IsNotification)
                        {
                            <span class="st-event-feed-badge" title="@item.Topic">
                                <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Style="font-size:0.8rem;" />
                                @Registry.DisplayName(Registry.GroupOf(item.Topic!))
                            </span>
                        }
                        <span class="st-event-feed-message">@item.Message</span>
                    </div>
                    <div class="st-event-feed-meta">
                        @if (item.IsNotification)
                        {
                            <span class="st-event-feed-topic mono" title="Notification topic">@item.Topic</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.SourceName))
                        {
                            <span class="st-event-feed-source" title="@item.Source">
                                <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Style="font-size:0.75rem;" />
                                @item.SourceName
                            </span>
                        }
                        <span class="st-event-feed-time" title="@item.Timestamp.ToLocalTime().ToString("f")">
                            @FormatHelper.FormatRelativeTime(item.Timestamp)
                        </span>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<EventFeedItem> Items { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string EmptyMessage { get; set; } = "";

    static string SeverityClass(string severity) => severity.ToLowerInvariant() switch
    {
        "success" => "success",
        "warning" => "warning",
        "error" => "error",
        _ => "info"
    };

    static string SeverityIcon(string severity) => severity.ToLowerInvariant() switch
    {
        "success" => Icons.Material.Filled.CheckCircleOutline,
        "warning" => Icons.Material.Filled.WarningAmber,
        "error" => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.Info
    };
}
