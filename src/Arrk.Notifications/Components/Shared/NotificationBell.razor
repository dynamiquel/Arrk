@using Arrk.Core.Notifications
@inject INotificationService Notifications
@inject ActivityService Activity
@inject IDialogService DialogService
@implements IDisposable
@attribute [UiRegion(UiRegions.ShellAppBarActions, Order = 10)]

@* App-bar bell: shows the unread badge and opens the unified inbox card sheet. Injected into the
   app-bar action region by attribute, so the shell layout never references the module. *@

<MudBadge Content="@BadgeText" Color="@BadgeColor" Overlap="true" Bordered="true"
          Visible="@HasBadge" Class="st-notif-badge">
    <MudIconButton Icon="@BellIcon" Color="Color.Inherit" aria-label="@AriaLabel"
                   Class="@($"st-header-btn st-notif-trigger {(_unreadCount > 0 ? "st-notif-trigger--active" : "")}")"
                   OnClick="OpenInboxAsync" />
</MudBadge>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    int _unreadCount;
    int? _userId;
    Timer? _refreshTimer;
    CancellationTokenSource? _cts;

    bool HasBadge => _unreadCount > 0 || Activity.ActiveCount > 0;
    string BadgeText => _unreadCount > 0
        ? (_unreadCount > 99 ? "99+" : _unreadCount.ToString())
        : Activity.ActiveCount.ToString();
    Color BadgeColor => _unreadCount > 0 ? Color.Error : Color.Info;
    string BellIcon => _unreadCount > 0 ? Icons.Material.Filled.Notifications : Icons.Material.Filled.NotificationsNone;
    string AriaLabel => _unreadCount > 0 ? $"Activity and notifications, {_unreadCount} unread" : "Activity and notifications";

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        Activity.Changed += OnActivityChanged;
        await RefreshCountAsync();

        _refreshTimer = new Timer(async _ =>
        {
            if (_cts.IsCancellationRequested)
                return;

            try
            {
                await RefreshCountAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                // Circuit disposed or transient failure; the bell is best-effort.
            }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    void OnActivityChanged() => _ = InvokeAsync(StateHasChanged);

    async Task RefreshCountAsync()
    {
        try
        {
            if (_userId is null && AuthStateTask is not null)
            {
                ClaimsPrincipal user = (await AuthStateTask).User;
                if (int.TryParse(user.FindFirst(ArrkClaims.UserIdClaim)?.Value, out int id))
                    _userId = id;
            }

            _unreadCount = await Notifications.UnreadCountAsync(_userId);
        }
        catch
        {
            // The bell is a best-effort indicator; never break the app bar.
        }
    }

    async Task OpenInboxAsync()
    {
        await RefreshCountAsync();
        await DialogService.ShowAsync<NotificationInboxDialog>(null, StCardSheetOptions.CreateAnchored());
    }

    public void Dispose()
    {
        Activity.Changed -= OnActivityChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        _refreshTimer?.Dispose();
    }
}
