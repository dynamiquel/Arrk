<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The notifications module owns its own UI (Razor class library): the app-bar bell, the unified
    inbox card sheet, the shared event feed and the All Events page, contributed to the shell
    through the Arrk.Ui contracts. Delivery clients are independent modules referencing this one.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arrk.Auth.Abstractions\Arrk.Auth.Abstractions.csproj" />
    <ProjectReference Include="..\Arrk.Core\Arrk.Core.csproj" />
    <ProjectReference Include="..\Arrk.Ui\Arrk.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Arrk.Media.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
