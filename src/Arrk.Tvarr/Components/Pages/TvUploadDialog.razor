@inject TvImportService ImportService
@inject TvUploadStore UploadStore
@inject MediaCatalogService Catalog
@inject SonarrClient SonarrClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog Class="st-media-dialog">
    <DialogContent>
        <DialogCloseButton Class="st-dialog-close--floating" OnClick="CloseAsync" />
        <div class="st-upload-dialog">
        <StDialogTitle Icon="@Icons.Material.Filled.CloudUpload" Title="@TitleText" />

        @if (!IsAdmin)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                Only administrators can import local files into the library.
            </MudAlert>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" CloseIcon="@Icons.Material.Filled.Close"
                          OnClose="() => _error = null">@_error</MudAlert>
            }

            <input id="st-tv-upload-input" type="file" multiple accept="@TvUploadFormats.Accept"
                   class="st-upload-file-input" @ref="_fileInput" @onchange="OnFileInputChanged" />

            <label class="st-upload-drop" for="st-tv-upload-input" aria-label="Choose local media files">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                <span class="st-upload-drop-title">Choose a file from your computer</span>
                <span class="st-upload-hint">
                    Video: @TvUploadFormats.SupportedLabel.<br />
                    Optional sidecar subtitles are copied beside the imported file.
                </span>
            </label>

            @if (_pendingNames.Count > 0 && _stage is UploadStage.Uploading)
            {
                <div class="st-upload-files">
                    @foreach (UploadName file in _pendingNames)
                    {
                        <div class="st-upload-file-row">
                            <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                            <span class="st-upload-file-name">@file.Name</span>
                            <span class="st-upload-file-meta">@FormatHelper.FormatBytes(file.Size)</span>
                        </div>
                    }
                </div>
            }

            @if (_stage is UploadStage.Uploading or UploadStage.Analyzing or UploadStage.Importing)
            {
                <div class="st-upload-progress">
                    <MudText Typo="Typo.caption" Style="color:var(--st-text-secondary);">
                        @ProgressLabel
                    </MudText>
                    <MudProgressLinear Value="@ProgressPercent" Color="Color.Primary" Size="Size.Medium" Rounded="true" />
                </div>
            }

            @if (_analysis is not null && _stage is UploadStage.Confirm)
            {
                @if (_analysis.Warnings.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        @foreach (string warning in _analysis.Warnings)
                        {
                            <div>@warning</div>
                        }
                    </MudAlert>
                }

                @if (_selectedMatch is not null)
                {
                    <div class="st-upload-match">
                        @if (!string.IsNullOrEmpty(_selectedMatch.PosterUrl))
                        {
                            <img class="st-upload-match-art" src="@_selectedMatch.PosterUrl" alt="@_selectedMatch.Title" />
                        }
                        <div style="min-width:0;flex:1;">
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                <span class="st-upload-candidate-title">@_selectedMatch.Title</span>
                                @if (_selectedMatch.Year > 0)
                                {
                                    <span class="st-upload-candidate-sub">@_selectedMatch.Year</span>
                                }
                                <span class="st-upload-score @ScoreClass(_selectedMatch.Score)">@ScoreLabel(_selectedMatch.Score)</span>
                                @if (_selectedMatch.InLibrary)
                                {
                                    <StChip Variant="success">In Library</StChip>
                                }
                            </div>
                            <div class="st-upload-candidate-sub">
                                @(_selectedMatch.MediaType == "tv" ? "TV show" : "Movie")
                                @if (!string.IsNullOrEmpty(_selectedMatch.OriginalTitle) && _selectedMatch.OriginalTitle != _selectedMatch.Title)
                                {
                                    <span> · @_selectedMatch.OriginalTitle</span>
                                }
                            </div>
                            @if (_analysis.Ai is { } ai)
                            {
                                <div class="st-upload-ai">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                                    AI @(ai.Applied ? "chose" : "suggested") "@ai.Title" (@ai.Confidence.ToString("P0"))
                                    @if (!string.IsNullOrWhiteSpace(ai.Reason))
                                    {
                                        <span> · @ai.Reason</span>
                                    }
                                    @if (!ai.Applied && ai.WouldPickDifferent)
                                    {
                                        <span> · keeping the best match</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Arrk could not identify this file automatically. Search for the movie or show below, or pick another match.
                    </MudAlert>
                }

                @if (_analysis.Candidates.Count > 1)
                {
                    <div class="st-upload-candidates">
                        <MudText Typo="Typo.caption" Style="color:var(--st-text-muted);">Other matches</MudText>
                        @foreach (TvImportCandidate candidate in _analysis.Candidates.Where(c => !SameTarget(c, _selectedMatch)).Take(6))
                        {
                            <button type="button" class="st-upload-candidate" @onclick="() => SelectCandidate(candidate)">
                                <MudIcon Icon="@(candidate.MediaType == "tv" ? Icons.Material.Filled.Tv : Icons.Material.Filled.Movie)"
                                         Size="Size.Small" />
                                <span style="min-width:0;flex:1;">
                                    <span class="st-upload-candidate-title">@candidate.Title</span>
                                    @if (candidate.Year > 0)
                                    {
                                        <span class="st-upload-candidate-sub"> · @candidate.Year</span>
                                    }
                                </span>
                                <span class="st-upload-score @ScoreClass(candidate.Score)">@ScoreLabel(candidate.Score)</span>
                            </button>
                        }
                    </div>
                }

                <div style="display:flex;gap:8px;margin-top:10px;">
                    <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Search"
                               OnClick="() => _manualSearchVisible = !_manualSearchVisible">
                        <span class="st-btn-label">Search manually</span>
                    </MudButton>
                </div>

                @if (_manualSearchVisible)
                {
                    <div class="st-library-toolbar" style="margin-top:8px;">
                        <SearchBox @bind-Value="_manualQuery" Placeholder="Search TMDB for the right title..."
                                   DebounceInterval="400" OnSearch="SearchManualAsync" />
                    </div>

                    @if (_searching)
                    {
                        <div class="st-inline-status"><MudProgressCircular Size="Size.Small" Indeterminate="true" /> Searching…</div>
                    }
                    else if (_manualResults.Count > 0)
                    {
                        <div class="st-upload-candidates">
                            @foreach (MediaItem item in _manualResults.Take(8))
                            {
                                <button type="button" class="st-upload-candidate" @onclick="() => SelectManualAsync(item)">
                                    <MudIcon Icon="@(item.MediaType == "tv" ? Icons.Material.Filled.Tv : Icons.Material.Filled.Movie)"
                                             Size="Size.Small" />
                                    <span style="min-width:0;flex:1;">
                                        <span class="st-upload-candidate-title">@item.Title</span>
                                        @if (item.Year > 0)
                                        {
                                            <span class="st-upload-candidate-sub"> · @item.Year</span>
                                        }
                                    </span>
                                    @if (item.IsInLibrary)
                                    {
                                        <StChip Variant="success">In Library</StChip>
                                    }
                                </button>
                            }
                        </div>
                    }
                }

                @if (_selectedMatch?.MediaType == "tv" && _episodeChoices.Count > 0)
                {
                    <div style="margin-top:var(--st-space-md);">
                        <div class="st-detail-section-label">
                            <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Size="Size.Small" /> Episode mapping
                        </div>
                        @foreach (TvImportFileAnalysis file in _analysis.Files.Where(file => file.IsVideo))
                        {
                            <div class="st-upload-map-row">
                                <span class="st-upload-file-name" title="@file.FileName">@file.FileName</span>
                                <MudSelect T="int" Dense="true" Variant="Variant.Outlined"
                                           Value="@EpisodeSelection(file.UploadId)"
                                           ValueChanged="@((int id) => OnEpisodeSelected(file.UploadId, id))"
                                           Style="min-width:230px;">
                                    @foreach (TvEpisodeOption option in _episodeChoices)
                                    {
                                        <MudSelectItem T="int" Value="@option.Id">@option.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        }
                    </div>
                }

                @if (_analysis.Files.Any(file => file.IsSubtitle))
                {
                    <MudSwitch T="bool" @bind-Value="_importSubtitles" Color="Color.Primary"
                               Label="Copy subtitles beside the imported video" Class="mt-2" />
                }

                @if (NeedsReplaceSwitch)
                {
                    <MudSwitch T="bool" @bind-Value="_replaceExisting" Color="Color.Warning"
                               Label="Replace the existing file in the library" Class="mt-2" />
                }

                <div style="display:flex;justify-content:flex-end;margin-top:var(--st-space-md);">
                    <MudButton OnClick="ImportAsync" Variant="Variant.Filled" Color="Color.Primary"
                               Class="st-btn-gradient" Disabled="@(_selectedMatch is null || !HasVideo)"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        <span class="st-btn-label">Import</span>
                    </MudButton>
                </div>
            }

            @if (_stage is UploadStage.Done or UploadStage.Error)
            {
                @if (_results.Count > 0)
                {
                    <div style="margin-top:var(--st-space-sm);">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:600;margin-bottom:6px;">@_summary</MudText>
                        @foreach (TvImportFileResult result in _results)
                        {
                            <div class="st-upload-result">
                                <MudIcon Icon="@(result.Status == TvUploadStatus.Imported ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)"
                                         Size="Size.Small"
                                         Style="@($"color:{(result.Status == TvUploadStatus.Imported ? "var(--st-green)" : "var(--st-red)")};margin-top:2px;")" />
                                <div style="min-width:0;flex:1;">
                                    <div class="st-upload-candidate-title">@result.FileName</div>
                                    <div class="st-upload-result-msg">@result.Message</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(_summary))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_summary</MudAlert>
                }
            }
        }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool AutoDetect { get; set; } = true;
    [Parameter] public string MediaType { get; set; } = "auto";
    [Parameter] public int TmdbId { get; set; }
    [Parameter] public int TvdbId { get; set; }
    [Parameter] public int LibraryId { get; set; }
    [Parameter] public int SeasonNumber { get; set; }
    [Parameter] public int EpisodeNumber { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int Year { get; set; }
    [Parameter] public string PosterUrl { get; set; } = "";
    [Parameter] public bool HasExistingFile { get; set; }
    [Parameter] public List<int> Seasons { get; set; } = [];

    enum UploadStage
    {
        Select,
        Uploading,
        Analyzing,
        Confirm,
        Importing,
        Done,
        Error
    }

    sealed record UploadName(string Name, long Size);
    sealed record TvEpisodeOption(int Id, int SeasonNumber, int EpisodeNumber, string Label);

    UploadStage _stage = UploadStage.Select;
    ElementReference _fileInput;
    DotNetObjectReference<TvUploadDialog>? _dotNetRef;
    string _batchId = Guid.NewGuid().ToString("N");
    List<UploadName> _pendingNames = [];
    TvImportAnalysis? _analysis;
    TvImportCandidate? _selectedMatch;
    List<TvImportFileResult> _results = [];
    List<MediaItem> _manualResults = [];
    List<TvEpisodeOption> _episodeChoices = [];
    readonly Dictionary<long, int> _episodeSelection = new();
    readonly Dictionary<long, TvImportFileMapping> _mappings = new();
    string _manualQuery = "";
    string? _error;
    string? _summary;
    bool _manualSearchVisible;
    bool _searching;
    bool _replaceExisting;
    bool _importSubtitles = true;
    int _uploadIndex;
    int _uploadCount;
    long _uploadedBytes;
    long _uploadTotalBytes;

    bool HasVideo => _analysis?.Files.Any(file => file.IsVideo) == true;
    bool NeedsReplaceSwitch => HasExistingFile || _selectedMatch?.InLibrary == true;

    string TitleText => MediaType switch
    {
        "movie" => "Upload Movie",
        "tv" => "Upload Episodes",
        _ => "Upload Local Media"
    };

    string ProgressLabel => _stage switch
    {
        UploadStage.Uploading => _uploadCount > 0
            ? $"Uploading file {Math.Min(_uploadIndex + 1, _uploadCount)} of {_uploadCount}…"
            : "Uploading…",
        UploadStage.Analyzing => "Identifying the file…",
        UploadStage.Importing => "Importing into the library. This can take a moment for a large file…",
        _ => ""
    };

    double ProgressPercent => _stage switch
    {
        UploadStage.Uploading => _uploadTotalBytes > 0
            ? Math.Clamp((double)_uploadedBytes / _uploadTotalBytes * 100, 0, 100)
            : 0,
        UploadStage.Analyzing => 100,
        UploadStage.Importing => 100,
        _ => 0
    };

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    string KindForContext()
    {
        if (AutoDetect)
            return "auto";
        if (EpisodeNumber > 0)
            return "episode";
        if (SeasonNumber > 0)
            return "season";
        return MediaType == "tv" ? "series" : "movie";
    }

    async Task OnFileInputChanged(ChangeEventArgs args)
    {
        if (!IsAdmin)
            return;

        _error = null;
        _batchId = Guid.NewGuid().ToString("N");
        _results = [];
        _analysis = null;
        _selectedMatch = null;
        _episodeChoices = [];
        _episodeSelection.Clear();
        _mappings.Clear();
        _stage = UploadStage.Uploading;
        _uploadedBytes = 0;
        _uploadTotalBytes = 0;
        _uploadIndex = 0;
        _uploadCount = 0;
        StateHasChanged();

        try
        {
            _pendingNames = await JS.InvokeAsync<List<UploadName>>("arrkTvUpload.names", _fileInput);
            _uploadCount = _pendingNames.Count;
            _uploadTotalBytes = _pendingNames.Sum(file => file.Size);
            if (_uploadCount == 0)
            {
                _stage = UploadStage.Select;
                return;
            }

            List<TvUploadResponse> uploads = await JS.InvokeAsync<List<TvUploadResponse>>(
                "arrkTvUpload.uploadFiles",
                _fileInput,
                _batchId,
                KindForContext(),
                MediaType == "auto" ? "" : MediaType,
                _dotNetRef);
            if (uploads.Count == 0)
                throw new TvUploadException("No files were uploaded.");

            _stage = UploadStage.Analyzing;
            StateHasChanged();

            TvImportContext context = new(
                AutoDetect,
                MediaType,
                TmdbId,
                TvdbId,
                LibraryId,
                SeasonNumber,
                EpisodeNumber,
                Title,
                Year,
                PosterUrl);

            _analysis = await ImportService.AnalyzeAsync(_batchId, context);
            _selectedMatch = _analysis.Match;
            _stage = UploadStage.Confirm;
            await LoadEpisodeChoicesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _summary = ex.Message;
            _stage = UploadStage.Error;
            await UploadStore.CancelBatchAsync(_batchId);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnUploadProgress(int index, int count, long loaded, long total)
    {
        _uploadIndex = index;
        _uploadCount = count;
        _uploadedBytes = loaded;
        _uploadTotalBytes = total;
        return InvokeAsync(StateHasChanged);
    }

    async Task LoadEpisodeChoicesAsync()
    {
        _episodeChoices = [];
        _episodeSelection.Clear();
        _mappings.Clear();

        if (_selectedMatch?.MediaType != "tv" || _analysis is null)
            return;

        int seriesId = _selectedMatch.LibraryId ?? (LibraryId > 0 ? LibraryId : 0);
        if (seriesId <= 0)
            return;

        try
        {
            List<EpisodeDto> dtos = await SonarrClient.GetEpisodes(seriesId);
            List<TvEpisode> episodes = dtos.Select(ToEpisode).ToList();

            _episodeChoices = episodes
                .Where(episode => episode.SeasonNumber > 0)
                .OrderBy(episode => episode.SeasonNumber)
                .ThenBy(episode => episode.EpisodeNumber)
                .Select(episode => new TvEpisodeOption(
                    episode.Id,
                    episode.SeasonNumber,
                    episode.EpisodeNumber,
                    $"S{episode.SeasonNumber:00}E{episode.EpisodeNumber:00} · {episode.Title}"))
                .ToList();

            if (_episodeChoices.Count == 0)
                return;

            HashSet<int> claimed = [];
            foreach (TvImportFileAnalysis file in _analysis.Files.Where(file => file.IsVideo))
            {
                TvEpisodeOption? choice = FindChoice(file);
                if (choice is null)
                    choice = _episodeChoices.FirstOrDefault(option => !claimed.Contains(option.Id));
                if (choice is null)
                    continue;

                claimed.Add(choice.Id);
                _episodeSelection[file.UploadId] = choice.Id;
                _mappings[file.UploadId] = new TvImportFileMapping(
                    file.UploadId,
                    choice.SeasonNumber,
                    choice.EpisodeNumber,
                    EpisodeId: choice.Id);
            }
        }
        catch
        {
            /* Mapping is a convenience; Sonarr still parses the file name on import. */
        }
    }

    TvEpisodeOption? FindChoice(TvImportFileAnalysis file)
    {
        int season = file.Parsed.SeasonNumber ?? SeasonNumber;
        int episode = file.Parsed.EpisodeNumber ?? EpisodeNumber;
        if (season <= 0 || episode <= 0)
            return null;

        return _episodeChoices.FirstOrDefault(option =>
            option.SeasonNumber == season && option.EpisodeNumber == episode);
    }

    static TvEpisode ToEpisode(EpisodeDto dto) => new()
    {
        Id = dto.Id,
        SeriesId = dto.SeriesId,
        SeasonNumber = dto.SeasonNumber,
        EpisodeNumber = dto.EpisodeNumber,
        Title = dto.Title,
        Overview = dto.Overview,
        Monitored = dto.Monitored,
        HasFile = dto.HasFile,
        EpisodeFileId = dto.EpisodeFileId
    };

    int EpisodeSelection(long uploadId) =>
        _episodeSelection.TryGetValue(uploadId, out int id) ? id : 0;

    void OnEpisodeSelected(long uploadId, int episodeId)
    {
        TvEpisodeOption? choice = _episodeChoices.FirstOrDefault(option => option.Id == episodeId);
        if (choice is null)
        {
            _episodeSelection.Remove(uploadId);
            _mappings.Remove(uploadId);
            return;
        }

        _episodeSelection[uploadId] = episodeId;
        _mappings[uploadId] = new TvImportFileMapping(
            uploadId,
            choice.SeasonNumber,
            choice.EpisodeNumber,
            EpisodeId: choice.Id);
    }

    async Task SearchManualAsync(string query)
    {
        _manualQuery = query?.Trim() ?? "";
        _manualResults = [];
        if (_manualQuery.Length < 2)
            return;

        _searching = true;
        StateHasChanged();
        try
        {
            string type = MediaType == "auto" ? (_selectedMatch?.MediaType ?? "movie") : MediaType;
            _manualResults = type == "tv"
                ? await Catalog.SearchShowsAsync(_manualQuery, 1)
                : await Catalog.SearchMoviesAsync(_manualQuery, 1);
        }
        catch (Exception ex)
        {
            _error = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
            StateHasChanged();
        }
    }

    async Task SelectManualAsync(MediaItem item)
    {
        int tvdb = item.TvdbId;
        if (item.MediaType == "tv" && tvdb <= 0 && item.TmdbId > 0)
            tvdb = await Catalog.ResolveTvdbIdAsync(item.TmdbId);

        _selectedMatch = TvImportMatcher.ManualCandidate(
            item.MediaType == "tv" ? "tv" : "movie",
            item.Title,
            item.Year,
            item.TmdbId,
            tvdb,
            item.Overview,
            item.PosterUrl,
            item.IsInLibrary ? item.Id : null,
            item.AvailableSeasonNumbers ?? []);

        _manualSearchVisible = false;
        _manualResults = [];
        await LoadEpisodeChoicesAsync();
        StateHasChanged();
    }

    void SelectCandidate(TvImportCandidate candidate)
    {
        _selectedMatch = candidate;
        _ = LoadEpisodeChoicesAsync();
        StateHasChanged();
    }

    async Task ImportAsync()
    {
        if (_selectedMatch is null || _analysis is null)
        {
            _error = "Choose a movie or show before importing.";
            return;
        }

        _stage = UploadStage.Importing;
        _error = null;
        StateHasChanged();

        TvImportRequest request = new()
        {
            BatchId = _batchId,
            MediaType = _selectedMatch.MediaType,
            Title = _selectedMatch.Title,
            Year = _selectedMatch.Year,
            TmdbId = _selectedMatch.TmdbId,
            TvdbId = _selectedMatch.TvdbId,
            LibraryId = _selectedMatch.LibraryId ?? 0,
            SeasonNumber = _selectedMatch.MediaType == "tv"
                ? (_mappings.Values.FirstOrDefault()?.SeasonNumber ?? SeasonNumber)
                : 0,
            EpisodeNumber = _selectedMatch.MediaType == "tv"
                ? (_mappings.Values.FirstOrDefault()?.EpisodeNumber ?? EpisodeNumber)
                : 0,
            MonitoredSeasons = [.. Seasons],
            ReplaceExisting = _replaceExisting,
            ImportSubtitles = _importSubtitles,
            Mappings = [.. _mappings.Values]
        };

        try
        {
            TvImportResult result = await ImportService.ImportAsync(request, CancellationToken.None);
            _results = [.. result.Files];
            _summary = result.Summary;
            _stage = UploadStage.Done;
            Snackbar.Add(result.Summary, result.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _summary = ex.Message;
            _stage = UploadStage.Error;
        }

        StateHasChanged();
    }

    void Finish() => MudDialog.Close(DialogResult.Ok(new TvUploadOutcome(
        _summary ?? "",
        _results.Count(result => result.Status == TvUploadStatus.Imported) > 0)));

    async Task CloseAsync()
    {
        if (_stage is UploadStage.Done)
        {
            Finish();
            return;
        }

        if (_stage is UploadStage.Confirm or UploadStage.Error or UploadStage.Select)
            await UploadStore.CancelBatchAsync(_batchId);

        MudDialog.Cancel();
    }

    static bool SameTarget(TvImportCandidate candidate, TvImportCandidate? other)
    {
        if (other is null)
            return false;
        return candidate.MediaType == other.MediaType
            && candidate.TmdbId == other.TmdbId
            && candidate.TvdbId == other.TvdbId;
    }

    static string ScoreLabel(double score) => $"{score:0}% match";

    static string ScoreClass(double score) => score >= 85 ? "st-upload-score--high"
        : score >= TvImportMatcher.AutoPickThreshold ? "st-upload-score--medium"
        : "st-upload-score--low";

    public async ValueTask DisposeAsync()
    {
        if (_stage is UploadStage.Select or UploadStage.Uploading or UploadStage.Analyzing or UploadStage.Confirm or UploadStage.Error)
        {
            try
            {
                await UploadStore.CancelBatchAsync(_batchId);
            }
            catch
            {
                /* component is going away */
            }
        }

        _dotNetRef?.Dispose();
    }
}
