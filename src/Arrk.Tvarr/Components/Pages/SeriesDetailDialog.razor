    async Task CancelDownload(SonarrQueueItemDto queueItem)    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can cancel downloads.", Severity.Warning);
            return;
        }

        try
        {
            await SonarrService.DeleteQueueItem(queueItem.Id, blocklist: false);
            Snackbar.Add("Download cancelled.", Severity.Info);
            await LoadQueue();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

    async Task RetryEpisode(SonarrQueueItemDto queueItem)
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can retry searches.", Severity.Warning);
            return;
        }

        try
        {
            await SonarrService.DeleteQueueItem(queueItem.Id, blocklist: true);
            Snackbar.Add("Download cancelled & blocklisted. Searching again...", Severity.Info);
            await SonarrService.CommandSearchSeries(_series.Id);
            await Task.Delay(1000);
            await LoadQueue();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

    async Task DeleteEpisode(TvEpisode ep)
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can delete content.", Severity.Warning);
            return;
        }

        try
        {
            SonarrQueueItemDto? queueItem = GetEpisodeQueueItem(ep.Id);
            if (queueItem != null)
            {
                await SonarrService.DeleteQueueItem(queueItem.Id, blocklist: false);
            }
            await SonarrService.DeleteEpisode(ep.EpisodeFileId);
            Snackbar.Add("Episode deleted.", Severity.Info);
            await RefreshSeries();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

