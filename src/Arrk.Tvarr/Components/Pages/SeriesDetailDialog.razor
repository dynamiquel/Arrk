    async Task Search()
    {
        if (!SearchEnabled)
            return;

        _loading = true;
        StateHasChanged();
        try
        {
            await SonarrService.CommandSearchSeries(_series.Id);
            Snackbar.Add("Search started.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
        _loading = false;
        StateHasChanged();
    }

    async Task Delete()
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Only administrators can delete content.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            foreach (SonarrQueueItemDto q in _queueItems)
            {
                await SonarrService.DeleteQueueItem(q.Id, blocklist: false);
            }
            await SonarrService.DeleteSeries(_series.Id, true);
            Snackbar.Add("Series deleted.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        _loading = false;
        MudDialog.Close();
    }

    async Task ToggleMonitored()
    {
        if (!IsAdmin && _series.Monitored)
        {
            Snackbar.Add("Only administrators can unmonitor content.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        await SonarrService.ToggleMonitored(_series.Id, !_series.Monitored);
        await RefreshSeries();
        _loading = false;
        StateHasChanged();
    }

    async Task ToggleSeasonMonitored(int seasonNumber)
    {
        TvSeason? season = _series.Seasons.FirstOrDefault(s => s.SeasonNumber == seasonNumber);
        if (season == null)
        {
            return;
        }
        if (!IsAdmin && season.Monitored)
        {
            Snackbar.Add("Only administrators can unmonitor content.", Severity.Warning);
            return;
        }
        _loading = true;
        StateHasChanged();
        await SonarrService.ToggleSeasonMonitored(_series.Id, seasonNumber, !season.Monitored);
        await RefreshSeries();
        _loading = false;
        StateHasChanged();
    }

    async Task ToggleEpisodeMonitored(TvEpisode episode)
    {
        if (!IsAdmin && episode.Monitored)
        {
            Snackbar.Add("Only administrators can unmonitor content.", Severity.Warning);
            return;
        }

        _loading = true;
        StateHasChanged();
        await SonarrService.ToggleEpisodeMonitored(episode.Id, !episode.Monitored);
        await RefreshSeries();
        _loading = false;
        StateHasChanged();
    }
