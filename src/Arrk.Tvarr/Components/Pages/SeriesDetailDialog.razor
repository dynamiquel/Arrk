@using Arrk.Core.Enums
@using Arrk.Core.Lifecycle
@using Arrk.Core.Playback
@inject SonarrService SonarrService
@inject SonarrReleaseProvider SonarrReleases
@inject TmdbService TmdbService
@inject ITvPlayerLinks JellyfinLinkService
@inject WatchStateService Watch
@inject StaleMediaEnricher Stale
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IOptionsMonitor<TvConfig> TvOptions

<MudDialog Class="st-media-dialog">
    <DialogContent>
        @if (_loading)
        {
            <div style="padding:32px;"><LoadingView /></div>
        }
        else
        {
        <MediaDetailHero Title="@_series.Title"
                         Year="_series.Year"
                         EndYear="@(_series.Status == SeriesStatus.Ended && _series.LastAired.HasValue ? _series.LastAired.Value.Year : 0)"
                         PosterUrl="@_series.PosterUrl"
                         BackdropUrl="@(!string.IsNullOrEmpty(_backdropUrl) ? _backdropUrl : _series.FanartUrl)"
                         LogoUrl="@_logoUrl"
                         Rating="_rating"
                         RuntimeMinutes="@(_runtime ?? _series.RuntimeMinutes)"
                         Certification="@(!string.IsNullOrEmpty(_certification) ? _certification : _series.Certification)"
                         ExtraMeta="@(_network)"
                         Tagline="@_tagline"
                         TmdbId="_series.TmdbId"
                         ImdbId="@_series.ImdbId"
                         TrailerKey="@(_trailerKey ?? string.Empty)"
                         PlayUrl="@SeriesPlayHref()"
                         IsTrailerPlaying="_showTrailer"
                         MediaType="tv"
                         OnClose="() => MudDialog.Cancel()"
                         OnPlayTrailer="() => _showTrailer = !_showTrailer">
            <Badges>
                <StaleBadge Level="_staleLevel" DaysRemaining="_staleDays" ShowBookmarked="_staleBookmarked"
                            BookmarkLabel="_staleBookmark" IsPinned="_stalePinned" ShowPinned="false" />
                @if (IsSearchResult)
                {
                    <StatusPill Variant="remote" Icon="@Icons.Material.Filled.AddCircleOutline" Label="Not in Library" />
                }
                else
                {
                    <StatusPill Variant="@SeriesStatusVariant"
                                     Icon="@SeriesStatusIcon"
                                     Label="@SeriesStatusLabel" />
                    @if (NotYetReleased)
                    {
                        <StatusPill Variant="unreleased" Icon="@Icons.Material.Filled.Schedule" Label="Not Released" />
                    }
                    <StatusPill Variant="@(_series.Monitored ? "info" : "neutral")"
                                     Icon="@(_series.Monitored ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.VisibilityOff)"
                                     Label="@(_series.Monitored ? "Monitored" : "Unmonitored")" />
                }
            </Badges>
            <Links>
                <UiRegion Name="tv.series.links" Context="new TvSeriesActionContext(_series)" />
            </Links>
        </MediaDetailHero>

            <div class="st-detail-body">
                @if (_showTrailer)
                {
                    <MediaTrailer TrailerKey="@_trailerKey" Title="@_series.Title" />
                }

                @if (!string.IsNullOrEmpty(_series.Overview))
                {
                    <MudText Typo="Typo.body2" Class="st-detail-overview">@_series.Overview</MudText>
                }

                @if (_series.Genres.Count > 0)
                {
                    <div class="st-detail-chips">
                        @foreach (string genre in _series.Genres)
                        {
                            <StChip Variant="neutral">@genre</StChip>
                        }
                    </div>
                }

                <MetaGrid>
                    @if (!string.IsNullOrEmpty(_releaseDate))
                    {
                        <MetaItem Label="First Aired" Value="@_releaseDate" />
                    }
                    @if (!string.IsNullOrEmpty(_lastAirDate))
                    {
                        <MetaItem Label="Last Aired" Value="@_lastAirDate" />
                    }
                    @if ((_runtime ?? _series.RuntimeMinutes) is > 0)
                    {
                        <MetaItem Label="Runtime" Value="@FormatRuntime((_runtime ?? _series.RuntimeMinutes)!.Value)" />
                    }
                    <MetaItem Label="Status" Value="@_series.Status.ToString()" />
                    <MetaItem Label="Age Rating" Value="@(string.IsNullOrEmpty(_certification) && string.IsNullOrEmpty(_series.Certification) ? "Unknown" : FormatHelper.ToUkCertification(!string.IsNullOrEmpty(_certification) ? _certification : _series.Certification))" />
                    <MetaItem Label="Language" Value="@FormatHelper.LanguageName(!string.IsNullOrEmpty(_language) ? _language : _series.OriginalLanguage)" />
                    @if (!string.IsNullOrEmpty(_network))
                    {
                        <MetaItem Label="Network" Value="@_network" />
                    }
                    @if (_series.SeasonCount is > 0)
                    {
                        <MetaItem Label="Seasons" Value="@_series.SeasonCount.Value.ToString()" />
                    }
                    @if (!IsSearchResult)
                    {
                        int totalDownloading = GetTotalDownloadingCount();
                        <MetaItem Label="Episodes">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="font-size:0.85rem;color:var(--st-green);" /> @_series.DownloadedEpisodes
                            @if (totalDownloading > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" Style="font-size:0.85rem;color:var(--st-blue);margin-left:4px;" /> @totalDownloading
                            }
                            <span style="color:var(--st-text-secondary);"> / @_series.TotalEpisodes</span>
                        </MetaItem>
                    }
                    @if (_series.SizeOnDisk is > 0)
                    {
                        <MetaItem Label="Size on Disk" Value="@FormatHelper.FormatBytes(_series.SizeOnDisk.Value)" />
                    }
                    @if (!IsSearchResult)
                    {
                        <MetaItem Label="Added" Value="@_series.Added.ToString("MMM dd, yyyy")" />
                    }
                </MetaGrid>

                @if (SeasonTabs.Count > 0)
                {
                    <div class="st-season-section">
                        <div class="st-detail-section-label">
                            <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Size="Size.Small" /> Seasons
                        </div>

                        <StTabs Items="SeasonTabs" Value="_selectedSeason" ValueChanged="@((int number) => SelectSeason(number))"
                                Variant="segmented" Class="st-season-tabs" />

                        @if (SelectedSeason is { } season)
                        {
                            <div class="st-season-bar">
                                <MudText Class="st-season-bar-title">Season @season.SeasonNumber</MudText>

                                @if (!IsSearchResult)
                                {
                                    int downloading = GetSeasonDownloadingCount(season.SeasonNumber);
                                    @if (downloading > 0)
                                    {
                                        <span class="st-season-bar-meta st-season-bar-meta--info">
                                            <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" />@downloading downloading
                                        </span>
                                    }
                                    @if (season.SizeOnDisk > 0)
                                    {
                                        <span class="st-season-bar-meta">
                                            <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />@FormatHelper.FormatBytes(season.SizeOnDisk)
                                        </span>
                                    }
                                    @if (season.TotalEpisodeCount > season.EpisodeCount)
                                    {
                                        <span class="st-season-bar-meta">@season.TotalEpisodeCount episodes incl. unaired</span>
                                    }
                                }

                                <MudSpacer />

                                @if (IsAdmin && !IsSearchResult)
                                {
                                    <MudTooltip Text="Upload episodes">
                                        <MudIconButton Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Color="Color.Primary"
                                                       OnClick="@(() => UploadSeason(season.SeasonNumber))"
                                                       StopPropagation="true" Class="st-season-monitor-btn" />
                                    </MudTooltip>
                                    @if (SearchEnabled)
                                    {
                                        <MudTooltip Text="Interactive search">
                                            <MudIconButton Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Small" Color="Color.Primary"
                                                           OnClick="@(() => OpenSeasonInteractiveSearch(season.SeasonNumber))"
                                                           StopPropagation="true" Class="st-season-monitor-btn" />
                                        </MudTooltip>
                                    }
                                }
                                @if (!IsSearchResult && (IsAdmin || !season.Monitored))
                                {
                                    <MudTooltip Text="@(season.Monitored ? "Unmonitor season" : "Monitor season")">
                                        <MudIconButton Icon="@(season.Monitored ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.VisibilityOff)"
                                                       Size="Size.Small"
                                                       Color="@(season.Monitored ? Color.Primary : Color.Default)"
                                                       OnClick="@(() => ToggleSeasonMonitored(season.SeasonNumber))"
                                                       StopPropagation="true"
                                                       Class="st-season-monitor-btn" />
                                    </MudTooltip>
                                }
                                @if (!IsSearchResult && MediaEntityRefs.Season(_series, season.SeasonNumber) is { } seasonFollow)
                                {
                                    <FollowButton Entity="seasonFollow" IncludeDescendants="true" />
                                }
                            </div>

                            <UiRegion Name="tv.series.season" Context="new TvSeriesSeasonContext(_series, season)" />

                            @if (!IsSearchResult)
                            {
                                @if (_seasonEpisodes.TryGetValue(season.SeasonNumber, out List<TvEpisode>? episodes))
                                {
                                    @if (episodes.Count > 0)
                                    {
                                        <div class="st-ep-grid">
                                            @foreach (TvEpisode ep in episodes.OrderBy(e => e.EpisodeNumber))
                                            {
                                                TmdbTvEpisode? tmdbEp = GetTmdbEpisode(season.SeasonNumber, ep.EpisodeNumber);
                                                string episodeImage = tmdbEp?.StillPath != null ? TmdbService.GetStillUrl(tmdbEp.StillPath)
                                                    : !string.IsNullOrEmpty(ep.ImageUrl) ? ep.ImageUrl : "";
                                                string episodeOverview = !string.IsNullOrEmpty(ep.Overview) ? ep.Overview
                                                    : tmdbEp?.Overview ?? "";
                                                SonarrQueueItemDto? queueItem = GetEpisodeQueueItem(ep.Id);
                                                <StEpisodeTile Episode="ep"
                                                               TmdbEpisode="tmdbEp"
                                                               QueueItem="queueItem"
                                                               ImageUrl="@episodeImage"
                                                               Overview="@episodeOverview"
                                                               PlayHref="@EpisodePlayHref(ep.SeasonNumber, ep.EpisodeNumber)"
                                                               IsWatched="@EpisodeWatched(ep.SeasonNumber, ep.EpisodeNumber)"
                                                               IsAdmin="IsAdmin"
                                                               SearchEnabled="SearchEnabled"
                                                               OnCancelDownload="@(() => CancelDownload(queueItem!))"
                                                               OnRetryDownload="@(() => RetryEpisode(queueItem!))"
                                                               OnDelete="@(() => DeleteEpisode(ep))"
                                                               OnMediaInfo="@(() => OpenEpisodeMediaInfo(ep))"
                                                               OnToggleMonitored="@(() => ToggleEpisodeMonitored(ep))"
                                                               OnInteractiveSearch="@(() => OpenEpisodeInteractiveSearch(ep))"
                                                               OnUpload="@(() => UploadEpisode(ep))" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Style="color:var(--st-text-muted);">No episodes aired yet</MudText>
                                    }
                                }
                                else
                                {
                                    <div style="display:flex;align-items:center;justify-content:center;padding:var(--st-space-md);">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    </div>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color:var(--st-text-muted);">Season available for monitoring</MudText>
                            }
                        }
                    </div>
                }

                <MediaRecommendations MediaType="@TmdbMediaType.Tv" TmdbId="_series.TmdbId" />

                <MediaCastRow Cast="@_cast" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (IsSearchResult && SearchEnabled)
        {
            <MudButton OnClick="AddFromSearch" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_loading"
                       Class="st-btn-gradient"
                       StartIcon="@Icons.Material.Filled.Add" title="Add to library" AriaLabel="Add to library">
                <span class="st-btn-label">Add</span>
            </MudButton>
        }
        else
        {
            @if (IsAdmin)
            {
                <MudButton OnClick="Edit" Variant="Variant.Outlined" Disabled="@_loading"
                           StartIcon="@Icons.Material.Filled.Edit" title="Edit series" AriaLabel="Edit series">
                    <span class="st-btn-label">Edit</span>
                </MudButton>
            }
            @if (SearchEnabled)
            {
                <StSearchButton OnSearch="Search" Disabled="_loading" />
            }
            <WatchlistButton ProviderKey="@WatchActivityServices.Tv" Domain="@TvMediaDomains.Tv"
                             ItemKey="@MediaItemKeys.Series(_series.TvdbId, _series.TmdbId)"
                             Title="@_series.Title"
                             Subtitle="@(!string.IsNullOrEmpty(_network) ? _network : null)"
                             PosterUrl="@_series.PosterUrl" Year="_series.Year"
                             TmdbId="_series.TmdbId" TvdbId="_series.TvdbId"
                             AsButton="true" />
            @if (MediaEntityRefs.Series(_series) is { } followEntity)
            {
                <FollowButton Entity="followEntity" IncludeDescendants="true" AsButton="true" />
            }
            @if (IsAdmin || !_series.Monitored)
            {
                <MudButton OnClick="ToggleMonitored" Variant="@(_series.Monitored ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" Disabled="@_loading"
                           StartIcon="@(_series.Monitored ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.VisibilityOff)"
                           title="@(_series.Monitored ? "Unmonitor future seasons" : "Monitor future seasons")"
                           AriaLabel="@(_series.Monitored ? "Unmonitor future seasons" : "Monitor future seasons")">
                    <span class="st-btn-label">@(_series.Monitored ? "Monitoring Future" : "Monitor Future Seasons")</span>
                </MudButton>
            }
            @if (IsAdmin)
            {
                <PinButton ProviderKey="tv" ItemKey="@MediaItemKeys.Series(_series.TvdbId, _series.TmdbId)"
                           Title="@_series.Title" IsPinned="_stalePinned" OnToggled="OnPinToggled"
                           AsButton="true" Disabled="_loading" />
                <MudButton OnClick="Delete" Variant="Variant.Outlined" Color="Color.Error" Disabled="@_loading"
                           StartIcon="@Icons.Material.Filled.Delete" title="Delete series" AriaLabel="Delete series">
                    <span class="st-btn-label">Delete</span>
                </MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TvSeries Series { get; set; } = new();
    [Parameter] public bool IsSearchResult { get; set; }

    /// <summary>Non-admins get a read-only view: they can search/add but cannot delete or unmonitor.</summary>
    [Parameter] public bool IsAdmin { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    TvSeries _series = new();
    bool _loading = true;
    List<QualityProfile> _profiles = [];
    List<SonarrQueueItemDto> _queueItems = [];
    readonly Dictionary<int, List<TvEpisode>> _seasonEpisodes = new();
    readonly Dictionary<string, TmdbTvEpisode> _tmdbEpisodes = new();
    /// <summary>Season currently shown in the selector; 0 until the first load resolves it.</summary>
    int _selectedSeason;
    List<TmdbCreditPerson> _cast = [];
    bool _showTrailer;
    TvSeriesLinks? _jellyfinLinks;
    string? _trailerKey;
    string _tagline = "";
    string _backdropUrl = "";
    string _logoUrl = "";
    double? _rating;
    int? _runtime;
    string _certification = "";
    string _releaseDate = "";
    string _lastAirDate = "";
    string _language = "";
    string _network = "";

    readonly Dictionary<(int Season, int Episode), WatchState> _watchStates = new();
    string _username = "";
    StaleLevel _staleLevel = StaleLevel.Fresh;
    double? _staleDays;
    bool _staleBookmarked;
    string? _staleBookmark;
    bool _stalePinned;

    bool EpisodeWatched(int season, int episode) =>
        _watchStates.TryGetValue((season, episode), out WatchState? state) && state.IsPlayed;

    /// <summary>
    /// Play target for an episode: the in-site player when enabled, otherwise the Jellyfin deep
    /// link. Returns null when the episode has not been resolved in Jellyfin yet.
    /// </summary>
    string? EpisodePlayHref(int season, int episode)
    {
        if (JellyfinLinkService.GetEpisodeUrl(_jellyfinLinks, season, episode) is not string url)
            return null;

        if (JellyfinLinkService.WebPlayerEnabled && JellyfinLinkService.ExtractItemId(url) is string id)
            return JellyfinLinkService.BuildWatchUrl(id, $"{_series.Title} S{season}E{episode}", "/tv", EpisodeArt(season, episode));

        return url;
    }

    /// <summary>
    /// Arrk's own artwork for the media session (lock screen) of an episode: the episode
    /// still when we have one, otherwise the series poster. Never taken from Jellyfin.
    /// </summary>
    string EpisodeArt(int season, int episode)
    {
        if (_seasonEpisodes.TryGetValue(season, out List<TvEpisode>? episodes))
        {
            TvEpisode? match = episodes.FirstOrDefault(e => e.EpisodeNumber == episode);
            if (match is not null && !string.IsNullOrEmpty(match.ImageUrl))
                return match.ImageUrl;
        }
        return _series.PosterUrl;
    }

    /// <summary>
    /// The series-level Play target: the next unwatched episode with a file (falling back to the
    /// first available episode) so a show plays in-site instead of opening Jellyfin's details page.
    /// </summary>
    string SeriesPlayHref()
    {
        string? jellyfinSeriesUrl = _jellyfinLinks?.SeriesUrl;

        if (!JellyfinLinkService.WebPlayerEnabled)
            return jellyfinSeriesUrl ?? "";

        foreach (TvEpisode ep in OrderedEpisodes())
        {
            if (ep.HasFile && !EpisodeWatched(ep.SeasonNumber, ep.EpisodeNumber) && EpisodeWatchHref(ep) is string next)
                return next;
        }

        foreach (TvEpisode ep in OrderedEpisodes())
        {
            if (ep.HasFile && EpisodeWatchHref(ep) is string first)
                return first;
        }

        return jellyfinSeriesUrl ?? "";
    }

    IEnumerable<TvEpisode> OrderedEpisodes() =>
        _seasonEpisodes.OrderBy(pair => pair.Key).SelectMany(pair => pair.Value.OrderBy(ep => ep.EpisodeNumber));

    string? EpisodeWatchHref(TvEpisode ep) =>
        JellyfinLinkService.ExtractItemId(JellyfinLinkService.GetEpisodeUrl(_jellyfinLinks, ep.SeasonNumber, ep.EpisodeNumber)) is string id
            ? JellyfinLinkService.BuildWatchUrl(id, $"{_series.Title} S{ep.SeasonNumber}E{ep.EpisodeNumber}", "/tv", !string.IsNullOrEmpty(ep.ImageUrl) ? ep.ImageUrl : _series.PosterUrl)
            : null;

    async Task LoadWatchStatesAsync()
    {
        _watchStates.Clear();
        if (!Watch.IsAvailable || string.IsNullOrWhiteSpace(_username) || _series.TvdbId <= 0)
            return;

        List<MediaKey> keys = _seasonEpisodes.Values
            .SelectMany(e => e)
            .Where(e => e.SeasonNumber > 0)
            .Select(e => new MediaKey(TvMediaDomains.Tv, 0, _series.TvdbId, e.SeasonNumber, e.EpisodeNumber))
            .ToList();

        if (keys.Count == 0)
            return;

        try
        {
            IReadOnlyDictionary<MediaKey, WatchState> states = await Watch.GetStatesAsync(_username, keys);
            foreach ((MediaKey key, WatchState state) in states)
                _watchStates[(key.SeasonNumber, key.EpisodeNumber)] = state;
        }
        catch
        {
            /* watch state is non-critical */
        }
    }

    string SeriesStatusLabel => IsSearchResult ? "Not in Library" : MediaItem.FromSeries(_series).LibraryStatus;

    string SeriesStatusVariant => SeriesStatusLabel switch
    {
        "Downloaded" => "success",
        "Downloaded Monitored" => "success",
        "Partial" => "warning",
        "Missing" => "error",
        _ => "neutral"
    };

    string SeriesStatusIcon => SeriesStatusLabel switch
    {
        "Downloaded" or "Downloaded Monitored" => Icons.Material.Filled.CheckCircle,
        "Partial" => Icons.Material.Filled.IncompleteCircle,
        "Missing" => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.Tv
    };

    /// <summary>True while the show has not started airing yet.</summary>
    bool NotYetReleased => !IsSearchResult && ReleaseStatus.SeriesNotYetReleased(_series.Status, _series.FirstAired);

    bool SearchEnabled => TvOptions.CurrentValue.Search.Enabled;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null && (await AuthStateTask).User.IsInRole(ArrkRoles.Admin))
            IsAdmin = true;
        if (AuthStateTask is not null)
            _username = (await AuthStateTask).User.Identity?.Name ?? "";

        _series = Series;
        EnsureSelectedSeason();
        _rating = _series.Rating;
        _runtime = _series.RuntimeMinutes;
        _certification = _series.Certification;
        _network = _series.Network;
        try
        {
            _profiles = await SonarrService.GetQualityProfiles();
        }
        catch
        {
        }
        await LoadQueue();
        await LoadStaleAsync();

        // Wait briefly for TMDB so the hero renders once with the final artwork/logo.
        // If TMDB is slow we fall back to the Sonarr data and refresh when it lands.
        Task loader = Task.WhenAll(LoadAllEpisodesAndTmdb(), LoadJellyfinLinksAsync());
        Task finished = await Task.WhenAny(loader, Task.Delay(1800));
        if (finished != loader)
        {
            _ = loader.ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);
        }
        _loading = false;
    }

    async Task LoadJellyfinLinksAsync()
    {
        if (IsSearchResult)
            return;

        _jellyfinLinks = await JellyfinLinkService.GetSeriesLinksAsync(_series);
    }

    async Task LoadQueue()
    {
        if (IsSearchResult) return;
        try
        {
            List<SonarrQueueItemDto> queue = await SonarrService.GetQueue();
            _queueItems = queue.Where(q => q.SeriesId == _series.Id).ToList();
        }
        catch
        {
            /* non-critical */
        }
    }

    void OnPinToggled(bool pinned) => _stalePinned = pinned;

    async Task LoadStaleAsync()
    {
        if (!Stale.IsAvailable)
            return;
        try
        {
            MediaStaleState? status = await Stale.GetSeriesStatusAsync(_series.TvdbId, _series.TmdbId);
            if (status is not null)
            {
                _staleLevel = status.Level;
                _staleDays = status.DaysRemaining;
                _staleBookmarked = status.IsBookmarked;
                _staleBookmark = status.BookmarkLabel;
                _stalePinned = status.IsPinned;
            }
        }
        catch
        {
            /* non-critical */
        }
    }

    async Task RefreshSeries()
    {
        TvSeries? refreshed = await SonarrService.GetSeries(_series.Id);
        if (refreshed != null)
        {
            _series = refreshed;
            EnsureSelectedSeason();
            await Task.WhenAll(LoadAllEpisodesAndTmdb(), LoadJellyfinLinksAsync());
        }
    }

    async Task LoadAllEpisodesAndTmdb()
    {
        _seasonEpisodes.Clear();
        _tmdbEpisodes.Clear();

        // TMDB detail first so the hero artwork/logo is ready before the slower episode/season work.
        if (TmdbService.IsConfigured && _series.TmdbId > 0)
        {
            try
            {
                TmdbTvDetail? detail = await TmdbService.GetTvDetailAsync(_series.TmdbId);
                if (detail != null)
                {
                    _cast = detail.Credits?.Cast.Take(20).ToList() ?? [];
                    _trailerKey = TmdbService.FindYouTubeTrailer(detail.Videos?.Results);
                    _backdropUrl = !string.IsNullOrEmpty(detail.BackdropPath) ? TmdbService.GetBackdropUrl(detail.BackdropPath, "w1280") : "";
                    _logoUrl = TmdbService.FindBestLogo(detail.Images?.Logos);
                    _tagline = detail.Tagline;
                    _rating = detail.VoteAverage > 0 ? detail.VoteAverage : _rating;
                    _runtime = detail.Runtime ?? _runtime;
                    _certification = ResolveCertification(detail.ContentRatings?.Results?.Select(r => (r.Country, r.Rating)).ToList());
                    _releaseDate = detail.FirstAirDate ?? "";
                    _lastAirDate = detail.LastAirDate ?? "";
                    _language = detail.OriginalLanguage;
                    _network = detail.Networks.FirstOrDefault()?.Name ?? _network;
                }
            }
            catch
            {
                /* non-critical enrichment */
            }
        }

        try
        {
            List<TvEpisode> episodes = await SonarrService.GetEpisodes(_series.Id);
            foreach (TvEpisode ep in episodes)
            {
                if (!_seasonEpisodes.ContainsKey(ep.SeasonNumber))
                {
                    _seasonEpisodes[ep.SeasonNumber] = new();
                }
                _seasonEpisodes[ep.SeasonNumber].Add(ep);
            }
        }
        catch
        {
            /* ignore */
        }

        await LoadWatchStatesAsync();

        if (!TmdbService.IsConfigured || _series.TmdbId <= 0) return;

        foreach (TvSeason season in _series.Seasons.Where(s => s.SeasonNumber > 0))
        {
            try
            {
                TmdbTvSeason? tmdbSeason = await TmdbService.GetTvSeasonAsync(_series.TmdbId, season.SeasonNumber);
                if (tmdbSeason?.Episodes != null)
                {
                    foreach (TmdbTvEpisode ep in tmdbSeason.Episodes)
                    {
                        string key = $"{season.SeasonNumber}_{ep.EpisodeNumber}";
                        _tmdbEpisodes[key] = ep;
                    }
                }
            }
            catch
            {
                /* ignore individual season failures */
            }
        }

        EnsureSelectedSeason();
    }

    static string ResolveCertification(List<(string Country, string Rating)>? ratings)
    {
        if (ratings == null) return "";
        (string Country, string Rating)? gb = ratings.FirstOrDefault(r => r.Country == "GB" && !string.IsNullOrWhiteSpace(r.Rating));
        if (gb is { Rating.Length: > 0 }) return gb.Value.Rating;
        (string Country, string Rating)? us = ratings.FirstOrDefault(r => r.Country == "US" && !string.IsNullOrWhiteSpace(r.Rating));
        if (us is { Rating.Length: > 0 }) return us.Value.Rating;
        return ratings.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.Rating)).Rating ?? "";
    }

    static string FormatRuntime(int minutes)
    {
        if (minutes <= 0) return "";
        if (minutes < 60) return $"{minutes}m";
        int h = minutes / 60;
        int m = minutes % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    TmdbTvEpisode? GetTmdbEpisode(int seasonNumber, int episodeNumber)
    {
        _tmdbEpisodes.TryGetValue($"{seasonNumber}_{episodeNumber}", out TmdbTvEpisode? ep);
        return ep;
    }

    int GetSeasonAvailableCount(int seasonNumber)
    {
        return _seasonEpisodes.TryGetValue(seasonNumber, out List<TvEpisode>? eps) ? eps.Count : 0;
    }

    int GetSeasonDownloadedCount(int seasonNumber)
    {
        return _seasonEpisodes.TryGetValue(seasonNumber, out List<TvEpisode>? eps) ? eps.Count(e => e.HasFile) : 0;
    }

    int GetSeasonDownloadingCount(int seasonNumber)
    {
        if (!_seasonEpisodes.TryGetValue(seasonNumber, out List<TvEpisode>? eps))
            return 0;
        return eps.Count(e => !e.HasFile && _queueItems.Any(q => q.EpisodeId == e.Id));
    }

    /// <summary>
    /// Compact season selector: one tab per season, each badged with the downloaded/available
    /// episode count (green when complete, amber when partial).
    /// </summary>
    IReadOnlyList<StTabItem<int>> SeasonTabs =>
        _series.Seasons
            .Where(s => s.SeasonNumber > 0)
            .OrderBy(s => s.SeasonNumber)
            .Select(s =>
            {
                (string? count, string? variant) = IsSearchResult
                    ? (null, null)
                    : SeasonSummary.Progress(GetSeasonDownloadedCount(s.SeasonNumber), GetSeasonAvailableCount(s.SeasonNumber));
                return new StTabItem<int>(s.SeasonNumber, $"Season {s.SeasonNumber}", null, count, false, variant);
            })
            .ToList();

    TvSeason? SelectedSeason => _series.Seasons.FirstOrDefault(s => s.SeasonNumber == _selectedSeason);

    void SelectSeason(int seasonNumber) => _selectedSeason = seasonNumber;

    /// <summary>
    /// Keeps the open season valid across loads and refreshes; on first load it defaults to the
    /// lowest season that already has episodes.
    /// </summary>
    void EnsureSelectedSeason()
    {
        if (_series.Seasons.Any(s => s.SeasonNumber == _selectedSeason && s.SeasonNumber > 0))
            return;

        _selectedSeason = SeasonSummary.DefaultSeason(
            _series.Seasons.Where(s => s.SeasonNumber > 0).Select(s => s.SeasonNumber),
            _seasonEpisodes.Keys) ?? 0;
    }

    int GetTotalDownloadingCount()
    {
        return _queueItems.Count;
    }

    SonarrQueueItemDto? GetEpisodeQueueItem(int episodeId)
    {
        return _queueItems.FirstOrDefault(q => q.EpisodeId == episodeId)
            ?? _queueItems.FirstOrDefault(q => q.EpisodeId == 0);
    }

