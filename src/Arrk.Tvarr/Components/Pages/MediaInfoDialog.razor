@using System.Globalization
@inject MediaInfoService MediaInfoService

<MudDialog Class="st-media-dialog">
    <DialogContent>
        <DialogCloseButton Class="st-dialog-close--floating" />
        <div class="st-media-info-dialog">
            <StDialogTitle Icon="@Icons.Material.Filled.Info" Title="Media Info" Subtitle="@Title" />

            @if (_loading && _info is null)
            {
                <div style="padding:32px;">
                    <LoadingView Message="Scanning media…" />
                </div>
            }
            else if (_info is null || !_info.HasData)
            {
                <EmptyState Icon="@Icons.Material.Filled.Info" Message="No technical media information is available for this file yet." />
            }
            else
            {
            <div class="st-media-info">
                <div class="st-media-info-head">
                    <div class="st-media-info-title">
                        <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Color="Color.Primary" />
                        <span class="st-media-info-filename">@_info.FileName</span>
                    </div>
                    <div class="st-media-info-tags">
                        <MediaFormatLine Info="_info" />
                        @if (!_info.Probed)
                        {
                            <MudTooltip Text="The file is not reachable from Arrk, so only the library scanner's metadata is shown.">
                                <StChip Variant="neutral" Class="ml-2">Library scanner</StChip>
                            </MudTooltip>
                        }
                    </div>
                </div>

                <div class="st-media-info-section">
                    <div class="st-detail-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /> File
                    </div>
                    <MetaGrid>
                        <MetaItem Label="Container" Value="@Dash(_info.Container)" />
                        <MetaItem Label="Size" Value="@FormatHelper.FormatBytes(_info.SizeBytes)" />
                        <MetaItem Label="Duration" Value="@Dash(_info.Duration)" />
                        <MetaItem Label="Overall Bitrate" Value="@Dash(MediaFormatSummary.FormatBitrate(_info.OverallBitrate))" />
                        <MetaItem Label="Subtitles" Value="@_info.Subtitles.Count.ToString()" />
                        <MetaItem Label="Audio Tracks" Value="@_info.Audio.Count.ToString()" />
                    </MetaGrid>
                    @if (!string.IsNullOrEmpty(_info.FilePath))
                    {
                        <div class="st-media-info-path">
                            <div class="st-info-label">Path</div>
                            <div class="st-info-value st-info-value--break">@_info.FilePath</div>
                        </div>
                    }
                </div>

                @if (_info.Video is { } video)
                {
                    <div class="st-media-info-section">
                        <div class="st-detail-section-label">
                            <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" /> Video
                        </div>
                        <MetaGrid>
                            <MetaItem Label="Codec" Value="@Dash(video.CodecDisplay)" />
                            @if (!string.IsNullOrEmpty(video.Profile))
                            {
                                <MetaItem Label="Profile" Value="@video.Profile" />
                            }
                            @if (!string.IsNullOrEmpty(video.Level))
                            {
                                <MetaItem Label="Level" Value="@video.Level" />
                            }
                            <MetaItem Label="Resolution" Value="@Dash(!string.IsNullOrEmpty(video.Resolution) ? $"{video.Resolution} ({MediaFormatSummary.ResolutionFromDimensions(video.Width, video.Height)})".Replace(" ()", "") : "")" />
                            <MetaItem Label="Aspect Ratio" Value="@Dash(video.AspectRatio)" />
                            @if (video.FrameRate > 0)
                            {
                                <MetaItem Label="Frame Rate" Value="@($"{video.FrameRate.ToString("0.###", CultureInfo.InvariantCulture)} fps")" />
                            }
                            @if (video.BitDepth > 0)
                            {
                                <MetaItem Label="Bit Depth" Value="@($"{video.BitDepth}-bit")" />
                            }
                            <MetaItem Label="Dynamic Range" Value="@Dash(video.HdrFormat)" />
                            <MetaItem Label="Bitrate" Value="@Dash(MediaFormatSummary.FormatBitrate(video.Bitrate))" />
                            @if (!string.IsNullOrEmpty(video.ColorSpace))
                            {
                                <MetaItem Label="Colour Space" Value="@video.ColorSpace" />
                            }
                            @if (!string.IsNullOrEmpty(video.ColorPrimaries))
                            {
                                <MetaItem Label="Primaries" Value="@video.ColorPrimaries" />
                            }
                            @if (!string.IsNullOrEmpty(video.ColorTransfer))
                            {
                                <MetaItem Label="Transfer" Value="@video.ColorTransfer" />
                            }
                            @if (!string.IsNullOrEmpty(video.ChromaSubsampling))
                            {
                                <MetaItem Label="Chroma" Value="@video.ChromaSubsampling" />
                            }
                            @if (!string.IsNullOrEmpty(video.ScanType))
                            {
                                <MetaItem Label="Scan Type" Value="@video.ScanType" />
                            }
                        </MetaGrid>
                    </div>
                }

                <div class="st-media-info-section">
                    <div class="st-detail-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Size="Size.Small" /> Audio
                    </div>
                    @if (_info.Audio.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--st-text-muted);">No audio tracks reported.</MudText>
                    }
                    else
                    {
                        @for (int i = 0; i < _info.Audio.Count; i++)
                        {
                            AudioStreamInfo stream = _info.Audio[i];
                            <div class="st-media-info-stream">
                                <div class="st-media-info-stream-title">
                                    <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" />
                                    <span>@Dash(stream.Format)</span>
                                    @if (stream.IsDefault)
                                    {
                                        <StChip Variant="success">Default</StChip>
                                    }
                                    <span class="st-media-info-track">@($"Track {i + 1}")</span>
                                </div>
                                <MetaGrid GridTemplate="repeat(auto-fit, minmax(120px, 1fr))">
                                    <MetaItem Label="Codec" Value="@Dash(stream.Codec.ToUpperInvariant())" />
                                    @if (!string.IsNullOrEmpty(stream.Profile))
                                    {
                                        <MetaItem Label="Profile" Value="@stream.Profile" />
                                    }
                                    <MetaItem Label="Channels" Value="@Dash(!string.IsNullOrEmpty(stream.ChannelLayout) ? stream.ChannelLayout : MediaFormatSummary.FormatChannels(stream.Channels))" />
                                    @if (stream.SampleRate > 0)
                                    {
                                        <MetaItem Label="Sample Rate" Value="@MediaFormatSummary.FormatSampleRate(stream.SampleRate)" />
                                    }
                                    <MetaItem Label="Bitrate" Value="@Dash(MediaFormatSummary.FormatBitrate(stream.Bitrate))" />
                                    <MetaItem Label="Language" Value="@Dash(!string.IsNullOrEmpty(stream.LanguageName) ? stream.LanguageName : stream.Language)" />
                                    @if (!string.IsNullOrEmpty(stream.Title))
                                    {
                                        <MetaItem Label="Title" Value="@stream.Title" />
                                    }
                                </MetaGrid>
                            </div>
                        }
                    }
                </div>

                <div class="st-media-info-section">
                    <div class="st-detail-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.Subtitles" Size="Size.Small" /> Subtitles
                    </div>
                    @if (_info.Subtitles.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--st-text-muted);">No subtitle tracks reported.</MudText>
                    }
                    else
                    {
                        @foreach (SubtitleStreamInfo subtitle in _info.Subtitles)
                        {
                            <div class="st-media-info-subtitle">
                                <MudIcon Icon="@Icons.Material.Filled.ClosedCaption" Size="Size.Small" />
                                <span class="st-media-info-subtitle-lang">@Dash(!string.IsNullOrEmpty(subtitle.LanguageName) ? subtitle.LanguageName : subtitle.Language)</span>
                                @if (!string.IsNullOrEmpty(subtitle.Title))
                                {
                                    <span class="st-media-info-subtitle-title">@subtitle.Title</span>
                                }
                                @if (!string.IsNullOrEmpty(subtitle.Codec))
                                {
                                    <StChip Variant="neutral">@subtitle.Codec</StChip>
                                }
                                @if (subtitle.IsForced)
                                {
                                    <StChip Variant="warning">Forced</StChip>
                                }
                                @if (subtitle.IsDefault)
                                {
                                    <StChip Variant="info">Default</StChip>
                                }
                            </div>
                        }
                    }
                </div>

                @if (!_info.Probed)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Info">
                        Detailed stream data (container, profile, colour, sample rate, subtitle titles) displays when the file is reachable by Arrk's media scanner.
                    </MudAlert>
                }
            </div>
        }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Title of the movie/episode this media info belongs to.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Radarr movie id to load; mutually exclusive with <see cref="EpisodeId"/>.</summary>
    [Parameter] public int MovieId { get; set; }

    /// <summary>Sonarr episode id to load; mutually exclusive with <see cref="MovieId"/>.</summary>
    [Parameter] public int EpisodeId { get; set; }

    /// <summary>Optional pre-loaded summary shown immediately while the scan runs.</summary>
    [Parameter] public MediaTechnicalInfo? Initial { get; set; }

    MediaTechnicalInfo? _info;
    bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _info = Initial;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        try
        {
            MediaTechnicalInfo? loaded = MovieId > 0
                ? await MediaInfoService.GetMovieMediaInfoAsync(MovieId)
                : EpisodeId > 0
                    ? await MediaInfoService.GetEpisodeMediaInfoAsync(EpisodeId)
                    : null;

            if (loaded is { HasData: true })
                _info = loaded;
        }
        catch
        {
            /* keep whatever baseline we already have */
        }
        finally
        {
            _loading = false;
        }
    }

    static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
