@* TV discovery surface (Movies / Shows / Anime). Hosted by the shell's Discover page, one instance
   per registered TV discover source, told which section to show through the Section parameter. *@
@inject MediaCatalogService Catalog
@inject TmdbService Tmdb
@inject RadarrService RadarrService
@inject SonarrService SonarrService
@inject RequestService RequestService
@inject IDialogService DialogService
@inject ActivityService Activity
@inject ILogger<TvDiscover> Logger
@implements IDisposable

@if (!Tmdb.IsConfigured)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.Key">
        TMDB is not configured. Add a <code>TmdbApiKey</code> or <code>TmdbReadToken</code> to your config to enable search, trending, categories and anime discovery. Library browsing still works.
    </MudAlert>
}

<div class="st-discover-controls">
    <SearchBox @bind-Value="_searchTerm" Placeholder="@($"Search {SectionNoun}...")"
               DebounceInterval="350" OnSearch="OnSearchDebounced" OnKeyDown="OnSearchKeyDown"
               Class="st-discover-search" />
    @if (!string.IsNullOrEmpty(_searchTerm))
    {
        <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="ClearSearch" />
    }

    @if (!_isSearching)
    {
        <MudSelect T="string" Value="@_genreId" ValueChanged="OnGenreChanged" Label="Genre"
                   Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="st-discover-genre">
            <MudSelectItem T="string" Value="@("")">All genres</MudSelectItem>
            @foreach (TmdbGenre genre in _genres)
            {
                <MudSelectItem T="string" Value="@genre.Id.ToString()">@genre.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Value="_year" ValueChanged="OnYearChanged" Label="Year"
                   Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="st-discover-year">
            <MudSelectItem T="int" Value="0">Any year</MudSelectItem>
            @foreach (int y in _years)
            {
                <MudSelectItem T="int" Value="@y">@y</MudSelectItem>
            }
        </MudSelect>
    }
</div>

@if (!_isSearching)
{
    <StTabs T="DiscoverCategory" Items="CategoryTabs"
            Value="_category" ValueChanged="SelectCategory" />

    @if (_section == MediaSection.Anime)
    {
        <div class="st-anime-season">
            <MudText Typo="Typo.caption" Class="st-anime-season-label">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /> Seasonal
            </MudText>
            <StTabs T="string" Variant="segmented" Class="st-tabs--sm"
                    Items="_seasonTabs"
                    Value="@(_useSeasonal ? _animeSeason : "")"
                    ValueChanged="SelectSeason" />
            <MudSelect T="int" Value="_animeYear" ValueChanged="OnAnimeYearChanged" Dense="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Class="st-anime-year">
                @foreach (int y in _years)
                {
                    <MudSelectItem T="int" Value="@y">@y</MudSelectItem>
                }
            </MudSelect>
        </div>
    }
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close"
              OnClose="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if (_loading)
{
    <LoadingView />
}
else if (_isSearching && _results.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Message="@($"No results for \"{_searchTerm}\"")" />
}
else if (_results.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Explore"
                Message="Nothing to show here yet" />
}
else
{
    @if (_featured != null && !_isSearching && string.IsNullOrEmpty(_genreId) && !_useSeasonal)
    {
        <div class="st-featured" style="background-image:linear-gradient(90deg, rgba(15,10,24,0.95) 0%, rgba(15,10,24,0.6) 45%, rgba(15,10,24,0.15) 100%), url('@_featured.BackdropUrl');">
            <div class="st-featured-body">
                <StatusPill Variant="@(_featured.IsInLibrary ? "success" : "remote")"
                                 Icon="@(_featured.IsInLibrary ? Icons.Material.Filled.LibraryAddCheck : Icons.Material.Filled.Public)"
                                 Label="@(_featured.IsInLibrary ? "In Library" : "Not in Library")" />
                @if (!string.IsNullOrEmpty(_featuredLogoUrl))
                {
                    <img src="@_featuredLogoUrl" class="st-featured-logo" alt="@_featured.Title" title="@_featured.Title" />
                }
                else
                {
                    <MudText Typo="Typo.h4" Class="st-featured-title">@_featured.Title</MudText>
                }
                <div class="st-featured-meta">
                    @if (_featured.Year > 0) { <span>@_featured.Year</span> }
                    @if (_featured.Rating is > 0)
                    {
                        <span><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" Style="font-size:0.9rem;" /> @_featured.Rating.Value.ToString("F1")</span>
                    }
                    @if (_featured.Genres.Count > 0) { <span>@string.Join(" · ", _featured.Genres.Take(3))</span> }
                </div>
                @if (!string.IsNullOrEmpty(_featured.Overview))
                {
                    <MudText Typo="Typo.body2" Class="st-featured-overview">@_featured.Overview</MudText>
                }
                <div style="display:flex;gap:var(--st-space-sm);margin-top:var(--st-space-md);">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_featured.IsInLibrary ? Icons.Material.Filled.Info : (_isAdmin ? Icons.Material.Filled.Add : Icons.Material.Filled.Inbox))"
                               Class="@(_featured.IsInLibrary ? "" : "st-btn-gradient")"
                               OnClick="() => OpenDetail(_featured)"
                               title="@(_featured.IsInLibrary ? "View details" : (_isAdmin ? "Add to library" : "Request"))"
                               AriaLabel="@(_featured.IsInLibrary ? "View details" : (_isAdmin ? "Add to library" : "Request"))">
                        <span class="st-btn-label">@(_featured.IsInLibrary ? "View Details" : (_isAdmin ? "Add to Library" : "Request"))</span>
                    </MudButton>
                </div>
            </div>
        </div>
    }

    <div class="st-results-header">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@ResultsHeading</MudText>
        <MudText Typo="Typo.caption" Style="color:var(--st-text-secondary);">@_results.Count results</MudText>
    </div>

    <MediaCardGrid Size="MediaCardSize.Large" Class="st-results-grid">
        @foreach (MediaItem item in GridItems)
        {
            <MediaPosterCard Item="item"
                             CardSize="MediaCardSize.Large"
                             IsAdmin="_isAdmin"
                             CanRequest="CanRequest"
                             OnClick="OpenDetail"
                             OnAdd="OpenDetail"
                             OnRequest="OpenRequest"
                             OnMonitorToggle="ToggleMonitored"
                             OnDelete="DeleteItem" />
        }
    </MediaCardGrid>

    @if (_hasMore)
    {
        <InfiniteScroll OnReached="LoadMore"
                        Enabled="@(_hasMore && !_loading && !_loadingMore)"
                        ShowSpinner="@_loadingMore" />
    }
}

@code {
    static readonly StTabItem<string>[] _seasonTabs =
    [
        new("winter", "Winter"),
        new("spring", "Spring"),
        new("summer", "Summer"),
        new("fall", "Fall")
    ];

    /// <summary>Which TV section to show: "movies", "shows" or "anime".</summary>
    [Parameter] public string Section { get; set; } = "movies";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    bool _isAdmin;

    MediaSection _section = MediaSection.Movies;
    DiscoverCategory _category = DiscoverCategory.Trending;
    bool _useSeasonal;
    string _animeSeason = MediaCatalogService.CurrentSeason(DateTime.UtcNow);
    int _animeYear = DateTime.UtcNow.Year;
    string _genreId = "";
    int _year;
    string _searchTerm = "";
    bool _isSearching;
    bool _loading = true;
    bool _loadingMore;
    bool _hasMore = true;
    const int PageSize = 20;
    string? _errorMessage;
    int _page = 1;
    List<MediaItem> _results = [];
    List<TmdbGenre> _genres = [];
    MediaItem? _featured;
    string _featuredLogoUrl = "";
    int _featuredLogoId;
    CancellationTokenSource? _cts;

    readonly List<int> _years = Enumerable.Range(DateTime.UtcNow.Year - 60, 61).Reverse().ToList();

    MediaSection SectionFor(string section) => section?.ToLowerInvariant() switch
    {
        "shows" or "tv" => MediaSection.Shows,
        "anime" => MediaSection.Anime,
        _ => MediaSection.Movies
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
            _isAdmin = (await AuthStateTask).User.IsInRole(ArrkRoles.Admin);

        MediaSection section = SectionFor(Section);
        if (section != _section)
        {
            _section = section;
            _category = DiscoverCategory.Trending;
            _useSeasonal = false;
            _genreId = "";
            _year = 0;
            _searchTerm = "";
            _isSearching = false;
            _genres = [];
        }

        _cts ??= new CancellationTokenSource();
        await LoadAsync(reset: true);
    }

    string SectionNoun => _section switch
    {
        MediaSection.Shows => "shows",
        MediaSection.Anime => "anime",
        _ => "movies"
    };

    List<CategoryOption> CurrentCategories => _section switch
    {
        MediaSection.Shows =>
        [
            new(DiscoverCategory.Trending, "Trending", Icons.Material.Filled.TrendingUp),
            new(DiscoverCategory.Popular, "Popular", Icons.Material.Filled.LocalFireDepartment),
            new(DiscoverCategory.TopRated, "Top Rated", Icons.Material.Filled.Star),
            new(DiscoverCategory.NewReleases, "New", Icons.Material.Filled.NewReleases),
            new(DiscoverCategory.OnTheAir, "On The Air", Icons.Material.Filled.Podcasts),
            new(DiscoverCategory.AiringToday, "Airing Today", Icons.Material.Filled.Today)
        ],
        MediaSection.Anime =>
        [
            new(DiscoverCategory.Trending, "Trending", Icons.Material.Filled.TrendingUp),
            new(DiscoverCategory.Popular, "Popular", Icons.Material.Filled.LocalFireDepartment),
            new(DiscoverCategory.TopRated, "Top Rated", Icons.Material.Filled.Star),
            new(DiscoverCategory.NewReleases, "New", Icons.Material.Filled.NewReleases),
            new(DiscoverCategory.AiringToday, "Airing", Icons.Material.Filled.Today)
        ],
        _ =>
        [
            new(DiscoverCategory.Trending, "Trending", Icons.Material.Filled.TrendingUp),
            new(DiscoverCategory.Popular, "Popular", Icons.Material.Filled.LocalFireDepartment),
            new(DiscoverCategory.TopRated, "Top Rated", Icons.Material.Filled.Star),
            new(DiscoverCategory.NewReleases, "New", Icons.Material.Filled.NewReleases),
            new(DiscoverCategory.Upcoming, "Upcoming", Icons.Material.Filled.Event),
            new(DiscoverCategory.NowPlaying, "In Cinemas", Icons.Material.Filled.Theaters)
        ]
    };

    IReadOnlyList<StTabItem<DiscoverCategory>> CategoryTabs =>
        CurrentCategories.Select(c => new StTabItem<DiscoverCategory>(c.Category, c.Label, c.Icon)).ToList();

    string ResultsHeading
    {
        get
        {
            if (_isSearching) return $"Results for \"{_searchTerm}\"";
            if (_useSeasonal) return $"{SeasonLabel(_animeSeason)} {_animeYear} anime";
            string label = CurrentCategories.FirstOrDefault(c => c.Category == _category).Label ?? "Discover";
            if (!string.IsNullOrEmpty(_genreId))
            {
                string? genre = _genres.FirstOrDefault(g => g.Id.ToString() == _genreId)?.Name;
                if (genre != null) label = $"{label} · {genre}";
            }
            if (_year > 0) label = $"{label} · {_year}";
            return label;
        }
    }

    IEnumerable<MediaItem> GridItems =>
        _featured != null && !_isSearching && string.IsNullOrEmpty(_genreId) && !_useSeasonal
            ? _results.Skip(1)
            : _results;

    async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            _page = 1;
            _results = [];
            _featured = null;
            _featuredLogoUrl = "";
            _featuredLogoId = 0;
        }

        _loading = reset;
        if (reset) _errorMessage = null;
        StateHasChanged();

        ActivityHandle? handle = null;
        if (!reset)
        {
            _loadingMore = true;
        }
        else if (_isSearching)
        {
            handle = Activity.Begin($"Searching {SectionNoun}", _searchTerm, Icons.Material.Filled.Search);
        }

        try
        {
            await EnsureGenresAsync();

            List<MediaItem> items;
            if (_isSearching && !string.IsNullOrWhiteSpace(_searchTerm))
            {
                items = await Catalog.SearchAsync(_section, _searchTerm, _page, _cts!.Token);
            }
            else if (_useSeasonal && _section == MediaSection.Anime)
            {
                items = await Catalog.GetAnimeSeasonalAsync(_animeSeason, _animeYear, _page, _cts!.Token);
            }
            else if (!string.IsNullOrEmpty(_genreId) || _year > 0)
            {
                items = await Catalog.DiscoverAsync(_section, _genreId, SortForCategory(_category), _year > 0 ? _year : null, _page, _cts!.Token);
            }
            else
            {
                items = await Catalog.GetCategoryAsync(_section, _category, _page, _cts!.Token);
            }

            _results = reset ? items : [.. _results, .. items];
            _hasMore = items.Count >= PageSize;

            await EnrichRequestStateAsync(_results);

            if (reset && !_isSearching && string.IsNullOrEmpty(_genreId) && !_useSeasonal && _results.Count > 0)
            {
                _featured = _results[0];
                _ = LoadFeaturedLogoAsync(_featured);
            }

            handle?.Complete($"{_results.Count} results");
        }
        catch (OperationCanceledException)
        {
            handle?.Info("Cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Discover load failed for {Section}/{Category}", _section, _category);
            _errorMessage = $"Could not load results: {ex.Message}";
            handle?.Fail(ex.Message);
        }
        finally
        {
            _loading = false;
            _loadingMore = false;
            StateHasChanged();
        }
    }

    async Task LoadFeaturedLogoAsync(MediaItem item)
    {
        _featuredLogoUrl = "";
        _featuredLogoId = item.TmdbId;
        if (item.TmdbId <= 0 || !Catalog.IsTmdbConfigured)
            return;

        try
        {
            string logo = await Catalog.GetLogoUrlAsync(item.MediaType, item.TmdbId);
            if (_featuredLogoId == item.TmdbId && !string.IsNullOrEmpty(logo))
            {
                _featuredLogoUrl = logo;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            /* non-critical featured artwork */
        }
    }

    static string SortForCategory(DiscoverCategory category) => category switch
    {
        DiscoverCategory.TopRated => "vote_average.desc",
        DiscoverCategory.NewReleases => "primary_release_date.desc",
        DiscoverCategory.Upcoming => "primary_release_date.asc",
        _ => "popularity.desc"
    };

    async Task EnsureGenresAsync()
    {
        if (_genres.Count > 0 || !Tmdb.IsConfigured)
            return;
        _genres = await Catalog.GetGenresAsync(_section, _cts!.Token);
    }

    async Task OnSearchDebounced(string value)
    {
        _searchTerm = value;
        bool searching = !string.IsNullOrWhiteSpace(value) && value.Trim().Length >= 2;
        if (searching != _isSearching || searching)
        {
            _isSearching = searching;
            _featured = null;
            await LoadAsync(reset: true);
        }
    }

    async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _isSearching = !string.IsNullOrWhiteSpace(_searchTerm);
            await LoadAsync(reset: true);
        }
    }

    async Task ClearSearch()
    {
        _searchTerm = "";
        _isSearching = false;
        await LoadAsync(reset: true);
    }

    async Task SelectCategory(DiscoverCategory category)
    {
        _category = category;
        _useSeasonal = false;
        await LoadAsync(reset: true);
    }

    async Task SelectSeason(string season)
    {
        _animeSeason = season;
        _useSeasonal = true;
        await LoadAsync(reset: true);
    }

    async Task OnGenreChanged(string value)
    {
        _genreId = value ?? "";
        await LoadAsync(reset: true);
    }

    async Task OnYearChanged(int value)
    {
        _year = value;
        await LoadAsync(reset: true);
    }

    async Task OnAnimeYearChanged(int value)
    {
        _animeYear = value;
        if (_useSeasonal) await LoadAsync(reset: true);
    }

    async Task LoadMore()
    {
        if (_loadingMore || _loading || !_hasMore)
            return;

        _page++;
        await LoadAsync(reset: false);
    }

    static string SeasonLabel(string season) => char.ToUpper(season[0]) + season[1..];

    async Task OpenDetail(MediaItem item)
    {
        if (item.IsInLibrary)
        {
            if (string.Equals(item.MediaType, TmdbMediaType.Tv, StringComparison.OrdinalIgnoreCase))
            {
                TvSeries? series = await Catalog.GetLibrarySeriesAsync(item.TmdbId);
                if (series != null)
                {
                    DialogParameters<SeriesDetailDialog> p = new() { { x => x.Series, series }, { x => x.IsAdmin, _isAdmin } };
                    IDialogReference d = await DialogService.ShowAsync<SeriesDetailDialog>(series.Title, p, DetailOptions());
                    await d.Result;
                    await LoadAsync(reset: true);
                    return;
                }
            }
            else
            {
                TvMovie? movie = await Catalog.GetLibraryMovieAsync(item.TmdbId);
                if (movie != null)
                {
                    DialogParameters<MovieDetailDialog> p = new() { { x => x.Movie, movie }, { x => x.IsAdmin, _isAdmin } };
                    IDialogReference d = await DialogService.ShowAsync<MovieDetailDialog>(movie.Title, p, DetailOptions());
                    await d.Result;
                    await LoadAsync(reset: true);
                    return;
                }
            }
        }

        DialogParameters<RemoteMediaDialog> parameters = new() { { x => x.Item, item }, { x => x.IsAdmin, _isAdmin } };
        IDialogReference dialog = await DialogService.ShowAsync<RemoteMediaDialog>(item.Title, parameters, DetailOptions());
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Catalog.InvalidateLibraryCache();
            await LoadAsync(reset: true);
        }
    }

    static DialogOptions DetailOptions() => new()
    {
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = true,
        Position = DialogPosition.Center
    };

    bool CanRequest => !_isAdmin && RequestService.Enabled;

    async Task OpenRequest(MediaItem item)
    {
        DialogParameters<RequestMediaDialog> parameters = new() { { x => x.Item, item } };
        IDialogReference dialog = await DialogService.ShowAsync<RequestMediaDialog>(null, parameters, DetailOptions());
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync(reset: true);
    }

    async Task EnrichRequestStateAsync(List<MediaItem> items)
    {
        if (!RequestService.Enabled || items.Count == 0)
            return;

        try
        {
            List<RequestStatus> ranked = [RequestStatus.Pending, RequestStatus.Approved, RequestStatus.Denied, RequestStatus.Blacklisted];
            IReadOnlyList<Arrk.Requests.Models.MediaRequest> requests = await RequestService.QueryAsync(
                new MediaRequestQuery { Limit = 2000 });

            Dictionary<int, (int Rank, string State)> byTmdb = [];
            Dictionary<int, (int Rank, string State)> byTvdb = [];

            foreach (Arrk.Requests.Models.MediaRequest request in requests)
            {
                int rank = ranked.IndexOf(request.Status);
                if (rank < 0)
                    continue;

                string state = StateFor(request.Status);
                IReadOnlyDictionary<string, string> ids = ProviderIdMap.Deserialize(request.ProviderIds);

                if (ids.TryGetValue("tmdb", out string? tmdb) && int.TryParse(tmdb, out int tmdbId))
                    Consider(byTmdb, tmdbId, rank, state);
                if (ids.TryGetValue("tvdb", out string? tvdb) && int.TryParse(tvdb, out int tvdbId))
                    Consider(byTvdb, tvdbId, rank, state);
            }

            for (int i = 0; i < items.Count; i++)
            {
                string state = "";
                if (items[i].TmdbId > 0 && byTmdb.TryGetValue(items[i].TmdbId, out (int Rank, string State) tm))
                    state = tm.State;
                else if (items[i].TvdbId > 0 && byTvdb.TryGetValue(items[i].TvdbId, out (int Rank, string State) tv))
                    state = tv.State;

                if (!string.IsNullOrEmpty(state))
                    items[i] = items[i] with { RequestState = state };
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Request-state enrichment skipped");
        }
    }

    static void Consider(Dictionary<int, (int Rank, string State)> map, int id, int rank, string state)
    {
        if (id <= 0)
            return;
        if (!map.TryGetValue(id, out (int Rank, string State) existing) || rank < existing.Rank)
            map[id] = (rank, state);
    }

    static string StateFor(RequestStatus status) => status switch
    {
        RequestStatus.Pending => "pending",
        RequestStatus.Approved => "approved",
        RequestStatus.Denied => "denied",
        RequestStatus.Blacklisted => "blacklisted",
        _ => ""
    };

    async Task ToggleMonitored(MediaItem item)
    {
        if (!item.IsInLibrary) return;
        if (!_isAdmin && item.IsMonitored)
        {
            return;
        }

        try
        {
            if (string.Equals(item.MediaType, TmdbMediaType.Tv, StringComparison.OrdinalIgnoreCase))
                await SonarrService.ToggleMonitored(item.Id, !item.IsMonitored);
            else
                await RadarrService.ToggleMonitored(item.Id, !item.IsMonitored);
            Catalog.InvalidateLibraryCache();
            await LoadAsync(reset: true);
        }
        catch
        {
            /* surfaced via activity elsewhere */
        }
    }

    async Task DeleteItem(MediaItem item)
    {
        if (!item.IsInLibrary) return;
        if (!_isAdmin) return;

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Remove from library",
            $"Remove \"{item.Title}\" and delete all downloaded files?",
            yesText: "Remove", cancelText: "Cancel");
        if (confirm != true) return;

        ActivityHandle handle = Activity.Begin($"Removing {item.Title}", null, Icons.Material.Filled.Delete);
        try
        {
            if (string.Equals(item.MediaType, TmdbMediaType.Tv, StringComparison.OrdinalIgnoreCase))
                await SonarrService.DeleteSeries(item.Id, deleteFiles: true);
            else
                await RadarrService.DeleteMovie(item.Id, deleteFiles: true);
            Catalog.InvalidateLibraryCache();
            handle.Complete("Removed");
            await LoadAsync(reset: true);
        }
        catch (Exception ex)
        {
            handle.Fail(ex.Message);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    record CategoryOption(DiscoverCategory Category, string Label, string Icon);
}
