@inject TvLibrarySummaryService Summary
@using Arrk.Ui.Components
@implements IDisposable

@if (_loading)
{
    <MudSkeleton Width="70px" Height="32px" />
}
else
{
    <div class="st-stat-value st-stat-value--@ValueColor">@Value</div>
    <div class="st-stat-sub">@Sub</div>
    @if (Metric == "episodes")
    {
        <MudProgressLinear Value="@(TotalEpisodes == 0 ? 0 : DownloadedEpisodes * 100.0 / TotalEpisodes)" Color="Color.Success"
                           Size="Size.Small" Rounded="true" Style="height:4px;margin-top:10px;" />
    }
}

@code {
    [Parameter] public TileContext? Context { get; set; }

    /// <summary>One of <c>shows</c>, <c>seasons</c>, <c>episodes</c>, <c>missing</c>, <c>downloading</c> or <c>ondisk</c>.</summary>
    [Parameter] public string Metric { get; set; } = "shows";

    const int RefreshSeconds = 30;

    ShowLibrarySummary? _summary;
    bool _loading = true;
    Timer? _timer;
    CancellationTokenSource? _cts;

    int TotalEpisodes => _summary?.Series.Sum(s => s.TotalEpisodes) ?? 0;
    int DownloadedEpisodes => _summary?.Series.Sum(s => s.DownloadedEpisodes) ?? 0;

    string Value => Metric switch
    {
        "seasons" => (_summary?.Series.Sum(s => s.Seasons.Count(x => x.SeasonNumber > 0)) ?? 0).ToString(),
        "episodes" => DownloadedEpisodes.ToString(),
        "missing" => Math.Max(0, TotalEpisodes - DownloadedEpisodes).ToString(),
        "downloading" => (_summary?.Downloading ?? 0).ToString(),
        "ondisk" => FormatHelper.FormatBytes(_summary?.Series.Sum(s => s.SizeOnDisk ?? 0) ?? 0),
        _ => (_summary?.Series.Count ?? 0).ToString()
    };

    string Sub => Metric switch
    {
        "seasons" => "Tracked seasons",
        "episodes" => $"of {TotalEpisodes} aired",
        "missing" => "Episodes to grab",
        "downloading" => "Active in queue",
        "ondisk" => "Across all shows",
        _ => $"{_summary?.Series.Count(s => s.Monitored) ?? 0} monitored"
    };

    string ValueColor => Metric switch
    {
        "seasons" => "purple",
        "episodes" => "green",
        "missing" => "red",
        "downloading" => "blue",
        "ondisk" => "yellow",
        _ => "pink"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);

        (Timer Timer, CancellationTokenSource Cts) result = AsyncTimerHelper.Create(
            async ct =>
            {
                await LoadAsync(ct);
                await InvokeAsync(StateHasChanged);
            },
            TimeSpan.FromSeconds(RefreshSeconds),
            TimeSpan.FromSeconds(RefreshSeconds));
        _timer = result.Timer;
        _cts = result.Cts;
    }

    async Task LoadAsync(CancellationToken ct)
    {
        try
        {
            _summary = await Summary.GetShowsAsync(ct);
            _loading = false;
        }
        catch
        {
            // Keep the last snapshot and stop showing the loading skeleton.
            _loading = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
