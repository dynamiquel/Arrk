@inject TvLibrarySummaryService Summary
@using Arrk.Ui.Components
@implements IDisposable

@if (_loading)
{
    <MudSkeleton Width="70px" Height="32px" />
}
else
{
    <div class="st-stat-value st-stat-value--@ValueColor">@Value</div>
    <div class="st-stat-sub">@Sub</div>
}

@code {
    [Parameter] public TileContext? Context { get; set; }

    /// <summary>One of <c>library</c>, <c>downloaded</c>, <c>missing</c>, <c>downloading</c>, <c>ondisk</c> or <c>monitored</c>.</summary>
    [Parameter] public string Metric { get; set; } = "library";

    const int RefreshSeconds = 30;

    MovieLibrarySummary? _summary;
    bool _loading = true;
    Timer? _timer;
    CancellationTokenSource? _cts;

    int Downloaded => _summary?.Movies.Count(m => m.HasFile) ?? 0;
    int Monitored => _summary?.Movies.Count(m => m.Monitored) ?? 0;
    int Missing => _summary?.Movies.Count(m => !m.HasFile) ?? 0;

    string Value => Metric switch
    {
        "downloaded" => Downloaded.ToString(),
        "missing" => Missing.ToString(),
        "downloading" => (_summary?.Downloading ?? 0).ToString(),
        "ondisk" => FormatHelper.FormatBytes(_summary?.Movies.Sum(m => m.SizeOnDisk) ?? 0),
        "monitored" => Monitored.ToString(),
        _ => (_summary?.Movies.Count ?? 0).ToString()
    };

    string Sub => Metric switch
    {
        "downloaded" => _summary is null || _summary.Movies.Count == 0
            ? "0% of library"
            : $"{(int)Math.Round(Downloaded * 100.0 / _summary.Movies.Count)}% of library",
        "missing" => "Awaiting download",
        "downloading" => "Active in queue",
        "ondisk" => $"{_summary?.Movies.Count ?? 0} files tracked",
        "monitored" => "Being watched for releases",
        _ => $"{Monitored} monitored"
    };

    string ValueColor => Metric switch
    {
        "downloaded" => "green",
        "missing" => "red",
        "downloading" => "blue",
        "ondisk" => "purple",
        "monitored" => "yellow",
        _ => "pink"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);

        (Timer Timer, CancellationTokenSource Cts) result = AsyncTimerHelper.Create(
            async ct =>
            {
                await LoadAsync(ct);
                await InvokeAsync(StateHasChanged);
            },
            TimeSpan.FromSeconds(RefreshSeconds),
            TimeSpan.FromSeconds(RefreshSeconds));
        _timer = result.Timer;
        _cts = result.Cts;
    }

    async Task LoadAsync(CancellationToken ct)
    {
        try
        {
            _summary = await Summary.GetMoviesAsync(ct);
            _loading = false;
        }
        catch
        {
            // Keep the last snapshot and stop showing the loading skeleton.
            _loading = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
