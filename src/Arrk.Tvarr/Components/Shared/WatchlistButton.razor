@using Arrk.Core.Enums
@using Arrk.Core.Playback
@inject WatchlistService Watchlists
@inject IEnumerable<IExternalWatchlist> ExternalWatchlists
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div @onclick:stopPropagation="@StopPropagation" class="st-watchlist-button @Class">
    <MudMenu Open="@_open" OpenChanged="SetOpen" Disabled="@(!_ready)"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
             PopoverClass="st-watchlist-menu">
        <ActivatorContent>
            @if (AsButton)
            {
                <MudButton OnClick="@context.ToggleAsync"
                           Variant="@(_tracked ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@(_tracked ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                           title="@(_tracked ? "Manage watchlists" : "Add to watchlist")"
                           AriaLabel="@(_tracked ? "Manage watchlists" : "Add to watchlist")">
                    <span class="st-btn-label">@(_tracked ? "In Watchlist" : "Add to Watchlist")</span>
                </MudButton>
            }
            else
            {
                <MudIconButton OnClick="@context.ToggleAsync"
                               Icon="@(_tracked ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                               Size="Size.Small"
                               Class="@CssClass"
                               StopPropagation="@StopPropagation"
                               title="@(_tracked ? "In a watchlist" : "Add to watchlist")"
                               AriaLabel="@(_tracked ? "In a watchlist" : "Add to watchlist")" />
            }
        </ActivatorContent>
        <ChildContent>
            @foreach (WatchlistEntry list in _lists)
            {
                <MudMenuItem OnClick="@(() => ToggleAsync(list))"
                             Icon="@(list.Contains ? Icons.Material.Filled.Check : Icons.Material.Outlined.BookmarkBorder)">
                    @list.Name
                </MudMenuItem>
            }
            @if (_lists.Count > 0)
            {
                <MudDivider />
            }
            <MudMenuItem Icon="@Icons.Material.Filled.PlaylistAdd" OnClick="CreateAsync">New watchlist…</MudMenuItem>
        </ChildContent>
    </MudMenu>
</div>

@code {
    [Parameter] public string ProviderKey { get; set; } = WatchActivityServices.Tv;
    [Parameter] public MediaDomain Domain { get; set; } = TvMediaDomains.Movie;
    [Parameter] public string ItemKey { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? PosterUrl { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public int TmdbId { get; set; }
    [Parameter] public int TvdbId { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool StopPropagation { get; set; } = true;

    /// <summary>Render as a full-size action button (media popups) instead of the compact card icon.</summary>
    [Parameter] public bool AsButton { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    int _userId;
    bool _ready;
    bool _tracked;
    bool _open;
    string _loadedKey = "";
    List<WatchlistEntry> _lists = [];

    string CssClass => $"st-icon-btn st-icon-btn--neutral st-icon-btn--overlay {Class}".Trim();

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && _userId > 0 && string.Equals(_loadedKey, ItemKey, StringComparison.Ordinal))
            return;

        await LoadAsync();
    }

    async Task LoadAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(ArrkClaims.UserIdClaim)?.Value, out int userId) || string.IsNullOrEmpty(ItemKey))
            return;

        _userId = userId;
        _loadedKey = ItemKey;
        List<WatchlistSummary> summaries = (await Watchlists.GetForUserAsync(_userId)).ToList();
        IReadOnlyList<int> containing = await Watchlists.GetContainingAsync(_userId, ProviderKey, ItemKey);
        List<WatchlistEntry> lists = summaries
            .Select(x => new WatchlistEntry($"user:{x.Id}", x.Name, containing.Contains(x.Id), false))
            .ToList();

        WatchlistItemRef item = ToRef();
        foreach (IExternalWatchlist external in ExternalWatchlists.OrderBy(x => x.Order))
        {
            try
            {
                if (!await external.IsAvailableAsync(_userId) || !await external.CanHandleAsync(_userId, item))
                    continue;
                bool contains = await external.ContainsAsync(_userId, item);
                lists.Add(new WatchlistEntry($"ext:{external.Key}", external.Name, contains, true));
            }
            catch
            {
                /* an unavailable external list must not break the local picker */
            }
        }

        _lists = lists;
        _tracked = containing.Count > 0 || lists.Any(x => x.Contains && x.IsExternal);
        _ready = true;
    }

    async Task SetOpen(bool open)
    {
        _open = open;
        await OpenChanged.InvokeAsync(open);
    }

    async Task ToggleAsync(WatchlistEntry list)
    {
        if (list.IsExternal)
        {
            IExternalWatchlist? external = ExternalWatchlists.FirstOrDefault(x =>
                $"ext:{x.Key}" == list.Key);
            if (external is null)
                return;

            try
            {
                if (list.Contains)
                    await external.RemoveAsync(_userId, ToRef());
                else
                    await external.AddAsync(_userId, ToRef());
                list.Contains = !list.Contains;
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        else if (list.Contains)
        {
            await Watchlists.RemoveItemAsync(_userId, UserListId(list), ItemKey);
            list.Contains = false;
        }
        else
        {
            await Watchlists.AddItemAsync(_userId, UserListId(list), ToRef());
            list.Contains = true;
        }

        _tracked = _lists.Any(x => x.Contains);
    }

    async Task CreateAsync()
    {
        if (_lists.Count(x => !x.IsExternal) >= WatchlistLimits.MaxListsPerUser)
        {
            Snackbar.Add($"You can have at most {WatchlistLimits.MaxListsPerUser} watchlists.", Severity.Warning);
            return;
        }

        DialogParameters<CreateWatchlistDialog> parameters = new();
        DialogOptions options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<CreateWatchlistDialog>("New watchlist", parameters, options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false, Data: WatchlistDetail created })
        {
            await Watchlists.AddItemAsync(_userId, created.Id, ToRef());
            _lists.Add(new WatchlistEntry($"user:{created.Id}", created.Name, true, false));
            _tracked = true;
        }
    }

    static int UserListId(WatchlistEntry list) => int.Parse(list.Key.Replace("user:", ""));

    WatchlistItemRef ToRef() => new(
        ProviderKey,
        Domain,
        ItemKey,
        Title,
        Subtitle,
        PosterUrl,
        Year,
        TmdbId,
        TvdbId);

    sealed class WatchlistEntry(string key, string name, bool contains, bool isExternal)
    {
        public string Key { get; } = key;
        public string Name { get; } = name;
        public bool Contains { get; set; } = contains;
        public bool IsExternal { get; } = isExternal;
    }
}
