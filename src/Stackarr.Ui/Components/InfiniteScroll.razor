@* Reusable infinite-scroll sentinel. Fires OnReached when scrolled near the viewport bottom,
   replacing a manual "Load more" button with the auto-load behaviour users expect. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="st-infinite-scroll-sentinel" @ref="_element" aria-hidden="true"></div>

@if (ShowSpinner)
{
    <div class="st-infinite-scroll-spinner">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
    </div>
}

@code {
    [Parameter] public EventCallback OnReached { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool ShowSpinner { get; set; }

    ElementReference _element;
    IJSObjectReference? _module;
    DotNetObjectReference<InfiniteScroll>? _self;
    bool _attached;
    bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (!Enabled)
        {
            await DetachAsync();
            return;
        }

        await AttachAsync();
    }

    async Task AttachAsync()
    {
        if (_disposed)
            return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Stackarr.Ui/js/infiniteScroll.js");
            _self ??= DotNetObjectReference.Create(this);

            // Re-observing on each render re-evaluates visibility, so a sentinel that is still in
            // view after a page loads keeps loading until the viewport is filled.
            await _module.InvokeVoidAsync("observe", _element, _self);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (ObjectDisposedException) { }
    }

    async Task DetachAsync()
    {
        if (!_attached || _module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("unobserve", _element);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        _attached = false;
    }

    [JSInvokable]
    public async Task OnIntersect()
    {
        if (_disposed || !Enabled)
            return;

        await OnReached.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DetachAsync();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch { /* best effort */ }
        }

        _self?.Dispose();
    }
}
