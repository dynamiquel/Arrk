@* Reusable search input: leading search icon, immediate typing with debounce, Enter-to-search.
   Replaces the hand-rolled search MudTextFields that had drifted across the pages. *@
<MudTextField T="string"
              Value="@Value"
              ValueChanged="@ValueChanged"
              Placeholder="@Placeholder"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true"
              DebounceInterval="@DebounceInterval"
              OnDebounceIntervalElapsed="HandleDebounce"
              OnKeyDown="HandleKeyDown"
              Margin="@Margin"
              Variant="@Variant"
              Dense="@Dense"
              Clearable="@Clearable"
              Class="@Class"
              Style="@Style" />

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";

    /// <summary>Invoked with the current text after <see cref="DebounceInterval"/> (and on Enter).</summary>
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    /// <summary>Optional key handler. When omitted, Enter triggers <see cref="OnSearch"/>.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter] public int DebounceInterval { get; set; } = 300;
    [Parameter] public Margin Margin { get; set; } = Margin.Normal;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    Task HandleDebounce(string value) => OnSearch.InvokeAsync(value);

    async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (OnKeyDown.HasDelegate)
        {
            await OnKeyDown.InvokeAsync(args);
            return;
        }

        if (args.Key == "Enter")
        {
            await OnSearch.InvokeAsync(Value);
        }
    }
}
