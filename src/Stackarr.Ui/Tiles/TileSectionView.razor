@namespace Stackarr.Ui

@inject TileRegistry Tiles
@implements IDisposable

@*
    A dashboard tile section: a named group with its own grid. The YAML owns the section list;
    this component only resolves each stored tile id to its catalog definition.
*@

<div class="st-tile-section">
    <div class="st-tile-section-head">
        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Color="Color.Primary" />
        <span class="st-tile-section-title">@Section.Title</span>
    </div>
    <div class="st-tile-grid">
        @foreach (DashboardTile entry in Section.Tiles)
        {
            TileDefinition? definition = Tiles.Find(entry.Id);
            if (definition is null)
            {
                <div class="st-tile-cell st-tile-cell--@SizeClass(entry.Size ?? TileSize.Medium)">
                    <div class="st-stat-card st-tile st-tile--missing">
                        <div class="st-stat-label"><MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" /> Unavailable tile</div>
                        <div class="st-stat-sub">@entry.Id</div>
                    </div>
                </div>
            }
            else if (!definition.AdminOnly || IsAdmin)
            {
                <div class="st-tile-cell st-tile-cell--@SizeClass(entry.Size ?? definition.DefaultSize)">
                    <TileView Definition="definition" Placement="TilePlacement.Dashboard" UserId="UserId" />
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TileSection Section { get; set; } = null!;

    [Parameter] public int UserId { get; set; }

    [Parameter] public bool IsAdmin { get; set; }

    static string SizeClass(TileSize size) => size switch
    {
        TileSize.Medium => "medium",
        TileSize.Large => "large",
        TileSize.VeryLarge => "verylarge",
        _ => "small",
    };

    protected override void OnInitialized() => Tiles.Changed += OnTilesChanged;

    void OnTilesChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Tiles.Changed -= OnTilesChanged;
}
