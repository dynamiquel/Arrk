@namespace Stackarr.Ui

@inject UserCssService Css
@implements IDisposable

@* Applies the account's custom CSS after the shared theme. Rendered from the layout so it covers
   every page, and kept live so the Account editor updates the running shell immediately. *@
@if (!string.IsNullOrWhiteSpace(_css))
{
    <style id="st-user-css">@((MarkupString)_css)</style>
}

@code {
    [Parameter] public int UserId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    string _css = "";
    int _userId;

    protected override async Task OnParametersSetAsync()
    {
        _userId = UserId;
        if (_userId <= 0 && AuthStateTask is not null)
        {
            AuthenticationState auth = await AuthStateTask;
            int.TryParse(auth.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId);
        }

        _css = _userId > 0 ? await Css.GetAsync(_userId) : "";
    }

    protected override void OnInitialized() => Css.Changed += OnCssChanged;

    async void OnCssChanged(int userId)
    {
        if (userId != _userId)
            return;

        try
        {
            _css = await Css.GetAsync(_userId);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            /* Custom CSS is cosmetic; never break the shell over it. */
        }
    }

    public void Dispose() => Css.Changed -= OnCssChanged;
}
