@inject UserService Users

<MudDialog>
    <TitleContent>
        <StDialogTitle Icon="@Icons.Material.Filled.PersonAdd" Title="Create user" />
    </TitleContent>
    <DialogContent>
        <DialogCloseButton Class="st-dialog-close--floating" />
        <MudStack Spacing="3" Class="mt-2">
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" MaxLength="64"
                          HelperText="Letters, numbers, dots, underscores and hyphens." />
            <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                          InputType="InputType.Password" />
            <MudSelect T="UserRole" @bind-Value="_role" Label="Role" Variant="Variant.Outlined">
                <MudSelectItem Value="UserRole.User">User</MudSelectItem>
                <MudSelectItem Value="UserRole.Admin">Administrator</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Style="color:var(--st-text-muted);">
                The account is created in Stackarr and in every connected media player (e.g. Jellyfin).
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="st-btn-gradient" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateAsync" Disabled="@_busy">
            <span class="st-btn-label">Create</span>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    string _username = "";
    string _password = "";
    UserRole _role = UserRole.User;
    string? _error;
    bool _busy;

    async Task CreateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            await Users.CreateAsync(_username, _password, _role, _username);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    void Cancel() => MudDialog.Cancel();
}
