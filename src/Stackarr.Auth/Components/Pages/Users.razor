@page "/users"
@attribute [Authorize(Policy = StackarrPolicies.AdminOnly)]
@inject UserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Stackarr - Users</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.ManageAccounts" Title="Users">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="st-btn-gradient"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateAsync">
            New user
        </MudButton>
    </Actions>
</PageHeader>

@if (_users is null)
{
    <LoadingView />
}
else
{
    <div class="mb-4">
        <PendingAccounts />
    </div>

    <div class="st-card" style="overflow:hidden;">
        <MudTable Items="_users" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>User</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Active</MudTh>
                <MudTh>Last login</MudTh>
                <MudTh Align="Right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="User">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span class="st-user-avatar st-user-avatar--initials" style="width:32px;height:32px;font-size:.875rem;">
                            @Initials(context)
                        </span>
                        <div>
                            <div style="font-weight:600;">@context.Username</div>
                            @if (context.Id == _currentUserId)
                            {
                                <div style="color:var(--st-text-muted);font-size:.8125rem;">you</div>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Role">
                    <StChip Variant="@(context.Role == UserRole.Admin ? "info" : "neutral")">
                        @(context.Role == UserRole.Admin ? "Administrator" : "User")
                    </StChip>
                </MudTd>
                <MudTd DataLabel="Active">
                    <MudSwitch T="bool" Value="@context.IsActive" Color="Color.Success"
                               Disabled="@(context.Id == _currentUserId)"
                               ValueChanged="@(v => SetActiveAsync(context, v))" />
                </MudTd>
                <MudTd DataLabel="Last login">
                    @(context.LastLoginAt is { } t ? t.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Never")
                </MudTd>
                <MudTd DataLabel="Actions" Align="Right">
                    <StIconButton Icon="@Icons.Material.Filled.Edit" Title="Edit user"
                                  OnClick="@(() => EditAsync(context))" />
                    <StIconButton Icon="@Icons.Material.Filled.Key" Title="Reset password"
                                  OnClick="@(() => ResetPasswordAsync(context))" />
                    <StIconButton Icon="@Icons.Material.Filled.Delete" Title="Delete user" Variant="ActionVariant.Danger"
                                  Disabled="@(context.Id == _currentUserId)"
                                  OnClick="@(() => DeleteAsync(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
}

@code {
    List<StackarrUser>? _users;
    int _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out int id))
            _currentUserId = id;

        await ReloadAsync();
    }

    async Task ReloadAsync()
        => _users = [.. (await UserService.GetAllAsync()).Where(u => u.Role != UserRole.Pending)];

    static string Initials(StackarrUser user)
        => string.IsNullOrWhiteSpace(user.Username) ? "?" : user.Username[..1].ToUpperInvariant();

    async Task CreateAsync()
    {
        IDialogReference dialog = await DialogService.ShowAsync<UserCreateDialog>("Create user");
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("User created.", Severity.Success);
            await ReloadAsync();
        }
    }

    async Task EditAsync(StackarrUser user)
    {
        DialogParameters parameters = new()
        {
            ["User"] = user,
            ["IsSelf"] = user.Id == _currentUserId
        };
        IDialogReference dialog = await DialogService.ShowAsync<UserEditDialog>("Edit user", parameters);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("User updated.", Severity.Success);
            await ReloadAsync();
        }
    }

    async Task ResetPasswordAsync(StackarrUser user)
    {
        DialogParameters parameters = new() { ["User"] = user };
        IDialogReference dialog = await DialogService.ShowAsync<ResetPasswordDialog>("Reset password", parameters);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
            Snackbar.Add("Password reset.", Severity.Success);
    }

    async Task SetActiveAsync(StackarrUser user, bool active)
    {
        try
        {
            await UserService.SetActiveAsync(user.Id, active);
            Snackbar.Add(active ? $"{user.Username} enabled." : $"{user.Username} disabled.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task DeleteAsync(StackarrUser user)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete user",
            $"Delete {user.Username}? This also removes their account from connected media players.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await UserService.DeleteAsync(user.Id);
            Snackbar.Add("User deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
