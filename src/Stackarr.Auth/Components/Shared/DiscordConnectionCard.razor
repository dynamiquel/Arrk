@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using Stackarr.Auth.Abstractions
@inject UserService Users
@inject AuthenticationStateProvider AuthProvider
@inject IOptionsMonitor<AuthConfig> AuthSettings
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@if (_loaded)
{
    <div class="st-connection-row">
        <div class="st-connection-icon">
            <span class="st-discord-logo st-brand-mask"
                  style="--st-brand-url:url('/img/discord-logo.svg')"></span>
        </div>
        <div class="st-connection-body">
            <div class="st-connection-name">Discord</div>
            @if (_login is not null)
            {
                <div class="st-connection-state">Linked. You can sign in with Discord.</div>
            }
            else if (_configured)
            {
                <div class="st-connection-state">Not linked. Use it to sign in to Stackarr.</div>
            }
            else
            {
                <div class="st-connection-state">An administrator has not enabled Discord sign-in.</div>
            }
        </div>
        <div class="st-connection-actions">
            @if (_login is not null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="UnlinkAsync"
                           Disabled="@_changing">
                    Unlink
                </MudButton>
            }
            else if (_configured)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddLink"
                           OnClick="Link">
                    Link Discord
                </MudButton>
            }
        </div>
    </div>
}

@code {
    int _userId;
    bool _loaded;
    bool _configured;
    bool _changing;
    UserLoginInfo? _login;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId))
            return;

        List<UserLoginInfo> logins = [.. await Users.GetExternalLoginsAsync(_userId)];
        _login = logins.FirstOrDefault(x => x.LoginProvider == LoginProviderRegistry.DiscordScheme);

        AuthConfig auth = AuthSettings.CurrentValue;
        _configured = auth.External.Discord.Enabled && !string.IsNullOrWhiteSpace(auth.External.Discord.ClientId);
        _loaded = true;
        ShowMessages();
    }

    void ShowMessages()
    {
        Dictionary<string, StringValues> query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("linked", out StringValues linked) && linked == LoginProviderRegistry.DiscordScheme)
            Snackbar.Add("Discord linked. You can now sign in with it.", Severity.Success);

        if (query.TryGetValue("linkError", out StringValues error) && error == "taken")
            Snackbar.Add("That Discord account is already linked to another Stackarr user.", Severity.Error);
        else if (query.TryGetValue("linkError", out StringValues failed) && failed == "failed")
            Snackbar.Add("Could not link Discord. Please try again.", Severity.Error);
    }

    // A full navigation is required: the endpoint challenges Discord with a cross-origin redirect.
    void Link() => Nav.NavigateTo("/account/link/discord", forceLoad: true);

    async Task UnlinkAsync()
    {
        if (_login is null)
            return;

        _changing = true;
        try
        {
            bool hasPassword = await Users.HasPasswordAsync(_userId);
            List<UserLoginInfo> logins = [.. await Users.GetExternalLoginsAsync(_userId)];
            if (!hasPassword && logins.Count <= 1)
            {
                Snackbar.Add("Set a password before unlinking your only sign-in method.", Severity.Warning);
                return;
            }

            await Users.RemoveExternalLoginAsync(_userId, _login.LoginProvider, _login.ProviderKey);
            _login = null;
            Snackbar.Add("Discord unlinked.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _changing = false;
        }
    }
}
