  <ItemGroup>
    <Content Remove="wwwroot/img/logo.svg;wwwroot/favicon.svg" />
    <Content Include="wwwroot/img/logo.svg;wwwroot/favicon.svg" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyBrandAssets" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="../../site/assets/logo.svg;../../site/assets/favicon.svg"
          DestinationFiles="wwwroot/img/logo.svg;wwwroot/favicon.svg" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

