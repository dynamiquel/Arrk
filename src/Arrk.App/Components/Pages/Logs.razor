@page "/logs"
@attribute [Authorize(Policy = ArrkPolicies.AdminOnly)]
@inject LogCaptureService LogCapture
@inject ServiceProvisioner Provisioner
@inject ServiceRegistry ServiceRegistry
@inject IConfiguration Configuration
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Arrk - Logs</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Article" Title="Logs">
    <Actions>
        <LogSourceSelector Value="_selectedSource" ValueChanged="@OnSourceChanged" Services="_enabledServices" Class="st-log-source-select" />
    </Actions>
</PageHeader>

<SectionContainer Icon="@Icons.Material.Filled.Tune" Title="Controls" Class="mb-4">
    <div class="st-controls-row">
        <MudSwitch T="bool" Checked="@_autoRefresh" CheckedChanged="@OnAutoRefreshChanged" Color="Color.Primary" Label="Auto-refresh (5s)" LabelPlacement="Placement.Start" />
        <MudSelect T="int" @bind-Value="_tailLines" Label="Tail Lines" Class="st-control-select" Dense="true" Variant="Variant.Outlined">
            <MudSelectItem T="int" Value="100">100</MudSelectItem>
            <MudSelectItem T="int" Value="200">200</MudSelectItem>
            <MudSelectItem T="int" Value="500">500</MudSelectItem>
            <MudSelectItem T="int" Value="1000">1000</MudSelectItem>
            <MudSelectItem T="int" Value="2000">2000</MudSelectItem>
        </MudSelect>
        <SearchBox @bind-Value="_search" Placeholder="Filter logs..." Class="st-control-search" DebounceInterval="300" Clearable="true" Dense="true" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@LoadLogsSync" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading"
                   title="Refresh logs" AriaLabel="Refresh logs">
            <span class="st-btn-label">Refresh</span>
        </MudButton>
    </div>
</SectionContainer>

<SectionContainer Icon="@Icons.Material.Filled.Terminal" Title="Log Output" Class="h-100">
    <ChildContent>
        <LogViewer @ref="_logViewer" Entries="_displayEntries" Loading="_loading" HighlightText="@_search" AutoScroll="_autoRefresh" Class="h-100" EmptyMessage="@GetEmptyMessage()" ReverseOrder="true" />
    </ChildContent>
</SectionContainer>

@code {
    private LogSource _selectedSource = LogSource.Arrk;
    private List<Service> _enabledServices = [];
    private List<LogEntry> _displayEntries = [];
    private bool _loading = false;
    private bool _autoRefresh = false;
    private int _tailLines = 200;
    private string _search = "";
    private Timer? _refreshTimer;
    private CancellationTokenSource? _cts;
    private LogViewer? _logViewer;
    private bool _initialized = false;

    protected override async Task OnInitializedAsync()
    {
        _enabledServices = [.. ServiceRegistry.All
            .Where(s => s.Definition.IsEnabled(Configuration))
            .OrderBy(s => s.Definition.DisplayName)];

        _displayEntries = [.. LogCapture.GetLogs(_tailLines, _search)];
        _initialized = true;

        (_refreshTimer, _cts) = AsyncTimerHelper.Create(
            async ct =>
            {
                if (_autoRefresh && !_loading && _initialized)
                {
                    await InvokeAsync(() => LoadLogs(ct));
                }
            },
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    private async Task LoadLogs(CancellationToken ct = default)
    {
        if (_loading || !_initialized)
            return;

        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (_selectedSource.IsArrk)
            {
                // Fast path - in-memory, no await needed
                _displayEntries = [.. LogCapture.GetLogs(_tailLines, _search)];
            }
            else if (_selectedSource.IsContainer)
            {
                using CancellationTokenSource timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
                timeoutCts.CancelAfter(TimeSpan.FromSeconds(10));

                try
                {
                    string log = await Provisioner.GetContainerLogs(_selectedSource.ContainerName!, _tailLines, timeoutCts.Token);
                    _displayEntries = ParseContainerLog(log, _selectedSource.ContainerName!);
                }
                catch (OperationCanceledException)
                {
                    _displayEntries = [new LogEntry
                    {
                        Timestamp = DateTime.Now,
                        Level = "WARNING",
                        Message = "Timeout loading container logs (10s)"
                    }];
                }
            }
        }
        catch (OperationCanceledException)
        {
            _displayEntries = [new LogEntry
            {
                Timestamp = DateTime.Now,
                Level = "WARNING",
                Message = "Log loading cancelled"
            }];
        }
        catch (Exception ex)
        {
            _displayEntries = [new LogEntry
            {
                Timestamp = DateTime.Now,
                Level = "ERROR",
                Message = $"Failed to load logs: {ex.Message}",
                Exception = ex.ToString()
            }];
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void LoadLogsSync() => _ = LoadLogs();

    private List<LogEntry> ParseContainerLog(string rawLog, string containerName)
    {
        List<LogEntry> entries = [];
        string[] lines = rawLog.Split('\n', StringSplitOptions.RemoveEmptyEntries);

        foreach (string line in lines)
        {
            LogEntry entry = ParseLogLine(line, containerName);
            entries.Add(entry);
        }

        return entries;
    }

    private LogEntry ParseLogLine(string line, string container)
    {
        DateTime timestamp = DateTime.Now;
        string level = "INFO";
        string message = line;

        string[] parts = line.Split(' ', 4, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 3 && DateTime.TryParseExact($"{parts[0]} {parts[1]}", "yyyy-MM-dd HH:mm:ss.fff", null, System.Globalization.DateTimeStyles.None, out DateTime parsed))
        {
            timestamp = parsed;
            level = parts[2].Trim('[', ']');
            message = parts.Length > 3 ? parts[3] : "";
        }

        return new LogEntry
        {
            Timestamp = timestamp,
            Level = level,
            Message = message,
            SourceContext = container
        };
    }

    private string GetEmptyMessage() => _selectedSource.IsArrk
        ? "No application logs captured yet."
        : $"No logs available for container '{_selectedSource.ContainerName}'.";

    private async Task OnSourceChanged(LogSource source)
    {
        _selectedSource = source;
        _logViewer?.ResetUserScrolled();
        await LoadLogs();
    }

    private async Task OnAutoRefreshChanged(bool enabled)
    {
        _autoRefresh = enabled;
        if (enabled && _initialized && !_loading)
        {
            await LoadLogs();
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _refreshTimer?.Dispose();
    }
}