<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The download-management module owns its own UI (Razor class library): the unified Downloads page
    listing Transmission torrents and slskd transfers, and the shared download card/mapping, all
    contributed to the shell through the Arrk.Ui contracts.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arrk.Core\Arrk.Core.csproj" />
    <ProjectReference Include="..\Arrk.Ui\Arrk.Ui.csproj" />
    <ProjectReference Include="..\Arrk.Docker\Arrk.Docker.csproj" />
    <ProjectReference Include="..\Arrk.Slskd\Arrk.Slskd.csproj" />
    <ProjectReference Include="..\Arrk.Ai\Arrk.Ai.csproj" />
    <ProjectReference Include="..\Arrk.Downloads.Abstractions\Arrk.Downloads.Abstractions.csproj" />
    <ProjectReference Include="..\Arrk.Media.Abstractions\Arrk.Media.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Arrk.Downloads.Abstractions" />
  </ItemGroup>
</Project>
