@page "/requests"
@attribute [Authorize]
@using Stackarr.Core.Requests
@using Stackarr.Requests
@using Stackarr.Requests.Models
@inject RequestService RequestService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Stackarr - Requests</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Inbox" Title="Requests">
    <Actions>
        <MudButton Href="/discover" Variant="Variant.Filled" Color="Color.Primary" Class="st-btn-gradient"
                   StartIcon="@Icons.Material.Filled.Explore" title="Discover" AriaLabel="Discover">
            <span class="st-btn-label">Discover</span>
        </MudButton>
    </Actions>
</PageHeader>

@if (!_enabled)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">The request system is disabled.</MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="4" md="2">
            <TileView Id="requests.open" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <TileView Id="requests.accepted" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <TileView Id="requests.denied" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <TileView Id="requests.blacklisted" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <TileView Id="requests.total" Placement="TilePlacement.Page" />
        </MudItem>
    </MudGrid>

    <StTabs T="RequestStatus?" Variant="segmented"
            Items="FilterTabs"
            Value="_filter"
            ValueChanged="SetFilter" />

    @if (_loading)
    {
        <LoadingView />
    }
    else if (_requests.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Inbox" Message="No requests to show" />
    }
    else
    {
        <MudGrid Class="st-results-grid">
            @foreach (MediaRequest request in _requests)
            {
                <MudItem xs="6" sm="4" md="3" lg="2">
                    <div class="st-media-card st-request-surface st-media-card--request st-media-card--request-@StateClass(request.Status)">
                        <div class="st-media-card-poster">
                            @if (!string.IsNullOrEmpty(request.PosterUrl))
                            {
                                <img src="@request.PosterUrl" alt="@request.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="st-media-card-poster-placeholder">
                                    <MudIcon Icon="@MediaIcon(request)" Size="Size.Large" />
                                </div>
                            }
                            <div class="st-media-card-badge st-media-card-badge--@StateClass(request.Status)">
                                <MudIcon Icon="@StatusIcon(request.Status)" Size="Size.Small" Style="font-size:0.8rem;" />
                                <span>@StatusLabel(request.Status)</span>
                            </div>
                        </div>
                        <div class="st-media-card-info">
                            <div class="st-request-title-row">
                                <span class="st-request-type">@TypeLabel(request)</span>
                                <span class="st-media-card-title" title="@request.Title">@request.Title</span>
                            </div>
                            <div class="st-request-card-meta">
                                @if (ScopeLabel(request) is { Length: > 0 } scope)
                                {
                                    <StChip Variant="neutral">@scope</StChip>
                                }
                                @if (!string.IsNullOrEmpty(request.QualityName))
                                {
                                    <StChip Variant="info">@request.QualityName</StChip>
                                }
                            </div>
                            <div class="st-request-card-sub">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="font-size:0.8rem;" />
                                <span>@request.RequestedByUsername</span>
                                <span class="st-meta-sep">·</span>
                                <span>@FormatHelper.FormatRelativeTime(request.RequestedAt)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(request.DecisionReason) && request.Status is RequestStatus.Denied or RequestStatus.Blacklisted or RequestStatus.Failed)
                            {
                                <div class="st-request-card-reason">@request.DecisionReason</div>
                            }

                            <div class="st-request-card-actions">
                                @if (_isAdmin && request.Status == RequestStatus.Pending)
                                {
                                    <StIconButton Icon="@Icons.Material.Filled.Check" Title="Accept" Variant="ActionVariant.Neutral"
                                                  OnClick="() => Approve(request)" />
                                    <StIconButton Icon="@Icons.Material.Filled.Close" Title="Deny" Variant="ActionVariant.Danger"
                                                  OnClick="() => Deny(request)" />
                                    <StIconButton Icon="@Icons.Material.Filled.Block" Title="Blacklist" Variant="ActionVariant.Danger"
                                                  OnClick="() => Blacklist(request)" />
                                }
                                else if (_isAdmin && request.Status is not RequestStatus.Approved and not RequestStatus.Cancelled)
                                {
                                    <StIconButton Icon="@Icons.Material.Filled.Block" Title="Blacklist" Variant="ActionVariant.Danger"
                                                  OnClick="() => Blacklist(request)" />
                                }

                                @if (!_isAdmin && request.Status == RequestStatus.Pending && request.RequestedByUserId == _userId)
                                {
                                    <StIconButton Icon="@Icons.Material.Filled.Undo" Title="Revoke" Variant="ActionVariant.Neutral"
                                                  OnClick="() => Revoke(request)" />
                                }
                            </div>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    RequestStatus? _filter = RequestStatus.Pending;
    List<MediaRequest> _requests = [];
    bool _loading = true;
    bool _enabled = true;
    bool _isAdmin;
    int _userId;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    static readonly StTabItem<RequestStatus?>[] FilterTabs =
    [
        new(RequestStatus.Pending, "Pending", Icons.Material.Filled.PendingActions),
        new(RequestStatus.Approved, "Approved", Icons.Material.Filled.CheckCircle),
        new(RequestStatus.Available, "Available", Icons.Material.Filled.PlayCircle),
        new(RequestStatus.Denied, "Denied", Icons.Material.Filled.Cancel),
        new(RequestStatus.Blacklisted, "Blacklisted", Icons.Material.Filled.Block),
        new(RequestStatus.Cancelled, "Cancelled", Icons.Material.Filled.Undo),
    ];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            System.Security.Claims.ClaimsPrincipal user = (await AuthStateTask).User;
            _isAdmin = user.IsInRole(StackarrRoles.Admin);
            int.TryParse(user.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId);
        }

        _enabled = RequestService.Enabled;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _requests = (await RequestService.QueryAsync(new MediaRequestQuery { Status = _filter })).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SetFilter(RequestStatus? status)
    {
        _filter = status;
        await LoadAsync();
    }

    async Task Approve(MediaRequest request)
    {
        RequestOperationResult result = await RequestService.ApproveAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? (result.Success ? "Approved." : "Failed."), result.Success ? Severity.Success : Severity.Error);
        await LoadAsync();
    }

    async Task Deny(MediaRequest request)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Deny request", $"Deny the request for \"{request.Title}\"?", yesText: "Deny", cancelText: "Cancel");
        if (confirm != true) return;

        RequestOperationResult result = await RequestService.DenyAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? "Denied.", result.Success ? Severity.Normal : Severity.Error);
        await LoadAsync();
    }

    async Task Blacklist(MediaRequest request)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Blacklist title", $"Blacklist \"{request.Title}\"? It can no longer be requested.", yesText: "Blacklist", cancelText: "Cancel");
        if (confirm != true) return;

        RequestOperationResult result = await RequestService.BlacklistAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? "Blacklisted.", result.Success ? Severity.Warning : Severity.Error);
        await LoadAsync();
    }

    async Task Revoke(MediaRequest request)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Revoke request", $"Withdraw your request for \"{request.Title}\"?", yesText: "Revoke", cancelText: "Cancel");
        if (confirm != true) return;

        RequestOperationResult result = await RequestService.RevokeAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? "Revoked.", result.Success ? Severity.Normal : Severity.Error);
        await LoadAsync();
    }

    static string MediaIcon(MediaRequest request) => request.Domain.Value switch
    {
        "tv" => Icons.Material.Filled.Tv,
        "music" => Icons.Material.Filled.MusicNote,
        _ => Icons.Material.Filled.Movie
    };

    static string TypeLabel(MediaRequest request) => request.Domain.Value switch
    {
        "tv" => "Show",
        "music" => "Music",
        _ => "Movie"
    };

    static string ScopeLabel(MediaRequest request) => request.Kind switch
    {
        RequestKind.Season => $"Season {request.SeasonNumber}",
        RequestKind.Episode => $"S{request.SeasonNumber}E{request.EpisodeNumber}",
        _ => ""
    };

    static string StatusLabel(RequestStatus status) => status switch
    {
        RequestStatus.Pending => "Pending",
        RequestStatus.Approved => "Approved",
        RequestStatus.Denied => "Denied",
        RequestStatus.Blacklisted => "Blacklisted",
        RequestStatus.Available => "Available",
        RequestStatus.Failed => "Failed",
        RequestStatus.Cancelled => "Cancelled",
        _ => status.ToString()
    };

    static string StatusIcon(RequestStatus status) => status switch
    {
        RequestStatus.Approved => Icons.Material.Filled.CheckCircle,
        RequestStatus.Denied => Icons.Material.Filled.Cancel,
        RequestStatus.Blacklisted => Icons.Material.Filled.Block,
        RequestStatus.Failed => Icons.Material.Filled.ErrorOutline,
        RequestStatus.Cancelled => Icons.Material.Filled.Undo,
        _ => Icons.Material.Filled.HourglassTop
    };

    static string StateClass(RequestStatus status) => status switch
    {
        RequestStatus.Approved or RequestStatus.Available => "approved",
        RequestStatus.Denied or RequestStatus.Failed => "denied",
        RequestStatus.Blacklisted => "blacklisted",
        RequestStatus.Cancelled => "cancelled",
        _ => "pending"
    };
}
