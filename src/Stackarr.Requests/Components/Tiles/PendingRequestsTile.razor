@using Stackarr.Requests.Components.Shared

@* Dashboard tile body: the pending queue as a scrolling shelf, with the same actions as the
   Requests page. *@
@inject RequestService Requests
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

@if (_loading)
{
    <LoadingView />
}
else if (_requests.Count == 0)
{
    <div class="st-stat-sub">Nothing is waiting for a decision.</div>
}
else
{
    <ScrollRow TrackClass="st-request-scroll-row">
        @foreach (MediaRequest request in _requests)
        {
            <div class="st-request-card-slot" @key="request.Id">
                <RequestCard Request="request" IsAdmin="_isAdmin" UserId="_userId"
                             OnApprove="ApproveAsync" OnDeny="DenyAsync"
                             OnBlacklist="BlacklistAsync" OnRevoke="RevokeAsync" />
            </div>
        }
    </ScrollRow>
}

@code {
    const int Limit = 12;

    List<MediaRequest> _requests = [];
    bool _loading = true;
    bool _isAdmin;
    int _userId;
    Timer? _timer;
    CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole(StackarrRoles.Admin);
        int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId);

        await LoadAsync(CancellationToken.None);

        (Timer Timer, CancellationTokenSource Cts) result = AsyncTimerHelper.Create(
            async ct =>
            {
                await LoadAsync(ct);
                await InvokeAsync(StateHasChanged);
            },
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
        _timer = result.Timer;
        _cts = result.Cts;
    }

    async Task LoadAsync(CancellationToken ct)
    {
        try
        {
            _requests = (await Requests.QueryAsync(
                new MediaRequestQuery { Status = RequestStatus.Pending, Limit = Limit }, ct)).ToList();
        }
        catch
        {
            // Keep the last known queue.
        }
        finally
        {
            _loading = false;
        }
    }

    async Task ApproveAsync(MediaRequest request)
    {
        RequestOperationResult result = await Requests.ApproveAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? (result.Success ? "Approved." : "Failed."),
            result.Success ? Severity.Success : Severity.Error);
        await LoadAsync(CancellationToken.None);
    }

    async Task DenyAsync(MediaRequest request)
    {
        bool? confirm = await Dialogs.ShowMessageBoxAsync(
            "Deny request", $"Deny the request for \"{request.Title}\"?",
            yesText: "Deny", cancelText: "Cancel");
        if (confirm != true)
            return;

        RequestOperationResult result = await Requests.DenyAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? "Denied.", result.Success ? Severity.Normal : Severity.Error);
        await LoadAsync(CancellationToken.None);
    }

    async Task BlacklistAsync(MediaRequest request)
    {
        bool? confirm = await Dialogs.ShowMessageBoxAsync(
            "Blacklist title", $"Blacklist \"{request.Title}\"? It can no longer be requested.",
            yesText: "Blacklist", cancelText: "Cancel");
        if (confirm != true)
            return;

        RequestOperationResult result = await Requests.BlacklistAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? "Blacklisted.", result.Success ? Severity.Warning : Severity.Error);
        await LoadAsync(CancellationToken.None);
    }

    async Task RevokeAsync(MediaRequest request)
    {
        bool? confirm = await Dialogs.ShowMessageBoxAsync(
            "Revoke request", $"Withdraw your request for \"{request.Title}\"?",
            yesText: "Revoke", cancelText: "Cancel");
        if (confirm != true)
            return;

        RequestOperationResult result = await Requests.RevokeAsync(request.Id, _userId);
        Snackbar.Add(result.Message ?? "Revoked.", result.Success ? Severity.Normal : Severity.Error);
        await LoadAsync(CancellationToken.None);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
