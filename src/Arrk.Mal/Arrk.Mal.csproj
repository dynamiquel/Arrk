<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- MyAnimeList is a specific integration, not a generic anime abstraction. The module owns its
       OAuth flow, list cache, watch-progress sync and the Plan to Watch watchlist contribution. -->
  <ItemGroup>
    <ProjectReference Include="..\Arrk.Core\Arrk.Core.csproj" />
    <ProjectReference Include="..\Arrk.Ui\Arrk.Ui.csproj" />
    <ProjectReference Include="..\Arrk.Tvarr\Arrk.Tvarr.csproj" />
    <ProjectReference Include="..\Arrk.Ai\Arrk.Ai.csproj" />
    <ProjectReference Include="..\Arrk.Media.Abstractions\Arrk.Media.Abstractions.csproj" />
    <ProjectReference Include="..\Arrk.Tv.Abstractions\Arrk.Tv.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arrk.Mal.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Arrk.Media.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Arrk.Tv.Abstractions" />
  </ItemGroup>
</Project>