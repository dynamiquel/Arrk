@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using Microsoft.Extensions.Options
@using Arrk.Mal.Models
@using Arrk.Mal.Services
@attribute [UiRegion(UiRegions.AccountConnections, EnabledConfigPath = "services:mal")]
@inject MalAccountService Accounts
@inject MalSyncService Sync
@inject IExternalIdentityStore Users
@inject AuthenticationStateProvider AuthProvider
@inject IOptionsMonitor<MalConfig> Config
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@if (_loaded)
{
    <div class="st-connection-row">
        <div class="st-connection-icon">
            <span class="mal-logo-avatar st-brand-mask"
                  style="--st-brand-url:url('/_content/Arrk.Mal/img/mal-logo.svg')"></span>
        </div>
        <div class="st-connection-body">
            <div class="st-connection-name">
                MyAnimeList
                @if (_account is not null && Config.CurrentValue.AllowLogin && Config.CurrentValue.IsConfigured)
                {
                    <span class="st-connection-badge">Sign-in</span>
                }
            </div>
            @if (!_configured)
            {
                <div class="st-connection-state">An administrator has not configured the MyAnimeList API client yet.</div>
            }
            else if (_account is null)
            {
                <div class="st-connection-state">
                    Link your account to sync watch progress and show your Plan to Watch list here.
                </div>
            }
            else if (_account.NeedsReauth)
            {
                <div class="st-connection-state st-connection-state--error">
                    @(_account.LastError ?? "The MyAnimeList session expired.")
                </div>
            }
            else
            {
                <div class="st-connection-state">
                    Linked as <strong>@_account.MalUsername</strong>
                    @if (_account.LastSyncedAt is { } synced)
                    {
                        <span> · synced @FormatHelper.FormatRelativeTime(synced)</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_account.LastSyncSummary))
                {
                    <div class="st-connection-caption">@_account.LastSyncSummary</div>
                }
            }
        </div>
        <div class="st-connection-actions">
            @if (!_configured)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/mal">Setup</MudButton>
            }
            else if (_account is null || _account.NeedsReauth)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddLink"
                           OnClick="Link" Disabled="@_busy">
                    @(_account?.NeedsReauth == true ? "Reconnect" : "Link")
                </MudButton>
            }
            else
            {
                <MudTooltip Text="@(_account.SyncEnabled ? "Pause watch sync" : "Resume watch sync")">
                    <MudIconButton Icon="@(_account.SyncEnabled ? Icons.Material.Filled.Sync : Icons.Material.Outlined.PauseCircle)"
                                   Size="Size.Small" OnClick="ToggleSync" Disabled="@_busy" />
                </MudTooltip>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SyncNow" Disabled="@_busy"
                           StartIcon="@Icons.Material.Filled.Sync">
                    Sync now
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Unlink" Disabled="@_busy"
                           Color="Color.Error">
                    Unlink
                </MudButton>
            }
        </div>
    </div>
}

@code {
    int _userId;
    bool _loaded;
    bool _configured;
    bool _busy;
    MalAccount? _account;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(ArrkClaims.UserIdClaim)?.Value, out _userId))
            return;

        _configured = Config.CurrentValue.IsConfigured;
        await LoadAsync();
        ShowMessages();
    }

    async Task LoadAsync()
    {
        _account = await Accounts.GetAsync(_userId);
        _loaded = true;
    }

    void ShowMessages()
    {
        Dictionary<string, StringValues> query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("linked", out StringValues linked) && linked == "mal")
            Snackbar.Add("MyAnimeList linked.", Severity.Success);

        if (query.TryGetValue("linkError", out StringValues error) && error == "mal-taken")
            Snackbar.Add("That MyAnimeList account is already linked to another Arrk user.", Severity.Error);
        else if (query.TryGetValue("linkError", out StringValues failed) && failed == "mal-failed")
            Snackbar.Add("Could not link MyAnimeList. Please try again.", Severity.Error);
    }

    void Link() => Nav.NavigateTo("/account/link/mal", forceLoad: true);

    async Task ToggleSync()
    {
        if (_account is null)
            return;
        _busy = true;
        try
        {
            await Accounts.SetSyncSettingsAsync(_userId, !_account.SyncEnabled, _account.ProtectProgress);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    async Task SyncNow()
    {
        _busy = true;
        try
        {
            string result = await Sync.SyncUserAsync(_userId);
            Snackbar.Add(result, Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    async Task Unlink()
    {
        _busy = true;
        try
        {
            List<UserLoginInfo> logins = [.. await Users.GetExternalLoginsAsync(_userId)];
            bool hasPassword = await Users.HasPasswordAsync(_userId);
            UserLoginInfo? mal = logins.FirstOrDefault(x => x.LoginProvider == "mal");
            if (mal is not null && !hasPassword && logins.Count <= 1)
            {
                Snackbar.Add("Set a password before unlinking your only sign-in method.", Severity.Warning);
                return;
            }

            if (mal is not null)
                await Users.RemoveExternalLoginAsync(_userId, mal.LoginProvider, mal.ProviderKey);
            await Accounts.UnlinkAsync(_userId);
            Snackbar.Add("MyAnimeList unlinked.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
