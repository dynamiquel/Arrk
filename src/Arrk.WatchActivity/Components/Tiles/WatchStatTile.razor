@inject WatchActivityService Watch
@using Arrk.Core.Playback
@using Arrk.Ui.Components
@implements IDisposable

@if (Metric == "latest")
{
    <div class="st-stat-value st-stat-value--blue">@_latest</div>
    <div class="st-stat-sub">last playback</div>
}
else
{
    <div class="st-stat-value st-stat-value--purple">@_count</div>
    <div class="st-stat-sub">for this account</div>
}

@code {
    [Parameter] public TileContext? Context { get; set; }

    /// <summary><c>plays</c> or <c>latest</c>.</summary>
    [Parameter] public string Metric { get; set; } = "plays";

    const int RefreshSeconds = 60;

    int _count;
    string _latest = "—";
    Timer? _timer;
    CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);

        (Timer Timer, CancellationTokenSource Cts) result = AsyncTimerHelper.Create(
            async ct =>
            {
                await LoadAsync(ct);
                await InvokeAsync(StateHasChanged);
            },
            TimeSpan.FromSeconds(RefreshSeconds),
            TimeSpan.FromSeconds(RefreshSeconds));
        _timer = result.Timer;
        _cts = result.Cts;
    }

    async Task LoadAsync(CancellationToken ct)
    {
        if (Context is null || Context.UserId <= 0)
            return;

        try
        {
            WatchActivityQuery query = new() { UserId = Context.UserId, Limit = 1 };
            if (Metric == "latest")
            {
                IReadOnlyList<WatchActivityEntry> rows = await Watch.GetHistoryAsync(query, ct);
                _latest = rows.Count > 0 ? FormatHelper.FormatRelativeTime(rows[0].StartedAt) : "—";
            }
            else
            {
                _count = await Watch.CountHistoryAsync(query, ct);
            }
        }
        catch
        {
            // Keep the last known value.
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
