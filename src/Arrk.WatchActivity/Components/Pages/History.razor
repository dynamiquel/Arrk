@page "/history"
@attribute [Authorize]
@inject WatchActivityService Watch
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Arrk - History</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.History" Title="History">
    <Actions>
        @if (_isAdmin)
        {
            <MudSelect T="string" Value="@_username" ValueChanged="SelectUser" Dense="true"
                       Variant="Variant.Outlined" Class="st-history-user-select" Label="User">
                <MudSelectItem T="string" Value="@("all")">Everyone</MudSelectItem>
                @foreach (string name in _usernames)
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
        }
    </Actions>
</PageHeader>

<div class="st-tile-grid st-history-stats">
    <div class="st-tile-cell st-tile-cell--half">
        <TileView Id="history.plays" Placement="TilePlacement.Page" />
    </div>
    <div class="st-tile-cell st-tile-cell--half">
        <TileView Id="history.latest" Placement="TilePlacement.Page" />
    </div>
</div>

<div class="st-history-toolbar">
    <StTabs T="string" Variant="segmented" Items="_serviceTabs" Value="@_service" ValueChanged="SelectService" />
    <div class="st-history-filters">
        <MudSelect T="string" Value="@_source" ValueChanged="SelectSource" Dense="true" Variant="Variant.Outlined"
                   Label="Source" Class="st-history-source-select">
            <MudSelectItem T="string" Value="@("all")">All sources</MudSelectItem>
            <MudSelectItem T="string" Value="@WatchActivitySources.Arrk">Arrk</MudSelectItem>
            <MudSelectItem T="string" Value="@WatchActivitySources.Jellyfin">Jellyfin</MudSelectItem>
            <MudSelectItem T="string" Value="@WatchActivitySources.Navidrome">Navidrome</MudSelectItem>
        </MudSelect>
        <SearchBox @bind-Value="_search" OnSearch="SearchAsync"
                   Placeholder="Search titles" Clearable="true" Dense="true" DebounceInterval="350"
                   Class="st-history-search" />
    </div>
</div>

@if (_loading && _entries.Count == 0)
{
    <LoadingView />
}
else if (_entries.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.History" Message="No history yet"
                Detail="Watch something in Jellyfin or play music in Arrk and it will show up here." />
}
else
{
    @foreach ((DateTime Day, List<WatchActivityEntry> Entries) group in Groups)
    {
        <div class="st-history-day">
            <MudText Typo="Typo.overline" Class="st-history-day-header">@DayLabel(group.Day)</MudText>
            <div class="st-history-list">
                @foreach (WatchActivityEntry entry in group.Entries)
                {
                    <StMediaRow ImageUrl="@entry.ImageUrl" Icon="@ServiceIcon(entry.ProviderKey)" Title="@entry.Title">
                        <Badges>
                            <StChip Variant="@ServiceVariant(entry.ProviderKey)">@ServiceName(entry.ProviderKey)</StChip>
                            <StChip Variant="neutral">@entry.Source</StChip>
                            @if (!string.IsNullOrEmpty(entry.Device) || !string.IsNullOrEmpty(entry.Client))
                            {
                                <StChip Variant="info">
                                    <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Small" />
                                    @DeviceLabel(entry)
                                </StChip>
                            }
                            @if (entry.Completed)
                            {
                                <StChip Variant="success">Finished</StChip>
                            }
                        </Badges>
                        <Info>
                            @if (!string.IsNullOrEmpty(entry.Subtitle))
                            {
                                <span>@entry.Subtitle</span>
                            }
                            @if (!string.IsNullOrEmpty(entry.ScopeLabel))
                            {
                                <span>· @entry.ScopeLabel</span>
                            }
                            <span>· @entry.Username</span>
                        </Info>
                        <Trailing>
                            <div>@entry.StartedAt.ToLocalTime().ToString("HH:mm")</div>
                            <div class="st-history-ago">@TimeAgo(entry.StartedAt)</div>
                        </Trailing>
                    </StMediaRow>
                }
            </div>
        </div>
    }

    <InfiniteScroll OnReached="LoadMoreAsync" Enabled="_hasMore" ShowSpinner="_loading" />
}

@code {
    const int PageSize = 50;

    List<WatchActivityEntry> _entries = [];
    List<string> _usernames = [];
    string _currentUsername = "";
    bool _isAdmin;
    string _username = "all";
    string _service = "all";
    string _source = "all";
    string _search = "";
    int _limit = PageSize;
    bool _hasMore;
    bool _loading;

    List<StTabItem<string>> _serviceTabs =
    [
        new StTabItem<string>("all", "Everything"),
        new StTabItem<string>(WatchActivityServices.Tv, "TV"),
        new StTabItem<string>(WatchActivityServices.Music, "Music")
    ];

    IEnumerable<(DateTime Day, List<WatchActivityEntry> Entries)> Groups =>
        _entries
            .GroupBy(x => x.StartedAt.ToLocalTime().Date)
            .OrderByDescending(x => x.Key)
            .Select(x => (x.Key, x.OrderByDescending(e => e.StartedAt).ToList()));

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name ?? "";
        _isAdmin = state.User.IsInRole(ArrkRoles.Admin);
        if (_isAdmin)
            _usernames = (await Watch.GetUsernamesAsync()).ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            string? username = _isAdmin
                ? (_username == "all" ? null : _username)
                : _currentUsername;

            WatchActivityQuery query = new()
            {
                Username = username,
                ProviderKey = _service == "all" ? null : _service,
                Source = _source == "all" ? null : _source,
                Search = string.IsNullOrWhiteSpace(_search) ? null : _search,
                Limit = _limit + 1
            };

            List<WatchActivityEntry> rows = (await Watch.GetHistoryAsync(query)).ToList();
            _hasMore = rows.Count > _limit;
            _entries = rows.Take(_limit).ToList();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    async Task SelectUser(string value)
    {
        _username = value;
        _limit = PageSize;
        await LoadAsync();
    }

    async Task SelectService(string value)
    {
        _service = value;
        _limit = PageSize;
        await LoadAsync();
    }

    async Task SelectSource(string value)
    {
        _source = value;
        _limit = PageSize;
        await LoadAsync();
    }

    async Task SearchAsync(string value)
    {
        _search = value;
        _limit = PageSize;
        await LoadAsync();
    }

    async Task LoadMoreAsync()
    {
        if (_loading || !_hasMore)
            return;
        _limit += PageSize;
        await LoadAsync();
    }

    static string TimeAgo(DateTime at)
    {
        TimeSpan age = DateTime.UtcNow - at.ToUniversalTime();
        if (age.TotalSeconds < 60) return "just now";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalHours < 24) return $"{(int)age.TotalHours}h ago";
        if (age.TotalDays < 30) return $"{(int)age.TotalDays}d ago";
        return at.ToLocalTime().ToString("yyyy-MM-dd");
    }

    static string DayLabel(DateTime day)
    {
        DateTime today = DateTime.Today;
        if (day == today) return "Today";
        if (day == today.AddDays(-1)) return "Yesterday";
        return day.ToString("dddd, d MMMM yyyy");
    }

    static string ServiceName(string key) => key switch
    {
        WatchActivityServices.Tv => "TV",
        WatchActivityServices.Music => "Music",
        _ => key
    };

    static string ServiceIcon(string key) => key switch
    {
        WatchActivityServices.Tv => Icons.Material.Filled.Tv,
        WatchActivityServices.Music => Icons.Material.Filled.MusicNote,
        _ => Icons.Material.Filled.PermMedia
    };

    static string ServiceVariant(string key) => key switch
    {
        WatchActivityServices.Tv => "purple",
        WatchActivityServices.Music => "info",
        _ => "neutral"
    };

    static string DeviceLabel(WatchActivityEntry entry)
    {
        if (!string.IsNullOrEmpty(entry.Device) && !string.IsNullOrEmpty(entry.Client))
            return $"{entry.Device} · {entry.Client}";
        return entry.Device ?? entry.Client ?? "";
    }
}
