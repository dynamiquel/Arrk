@attribute [UiRegion("tv.series.links")]
@inject IDialogService Dialogs
@inject SubtitleService Subtitles

@if (Subtitles.IsAvailable && IsLibraryContext(Context))
{
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="st-hero-link"
               StartIcon="@Icons.Material.Filled.Subtitles" OnClick="OpenAsync">
        Subtitles
    </MudButton>
}

@code {
    // Accepts every context the links region hands out (library and remote media) so the remote
    // dialog does not fail parameter binding; the action simply renders only for library items.
    [Parameter] public object? Context { get; set; }

    internal static bool IsLibraryContext(object? context) =>
        context is TvSeriesActionContext { Series.Id: > 0 };

    async Task OpenAsync()
    {
        if (Context is not TvSeriesActionContext { Series.Id: > 0 } context)
            return;

        TvSeries series = context.Series;
        DialogParameters<SubtitleSearchDialog> parameters = new()
        {
            { x => x.Target, SubtitleTarget.Series(series.Id, series.Title, series.Year > 0 ? series.Year.ToString() : "") }
        };
        await Dialogs.ShowAsync<SubtitleSearchDialog>(
            "Subtitles",
            parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true });
    }
}
