@attribute [UiRegion(UiRegions.PlayerOverlays)]
@inject SubtitleSearchLauncher Launcher
@inject SubtitleService Subtitles
@inject IEnumerable<ISeriesLibrary> SeriesLibraries
@inject IEnumerable<IMovieLibrary> MovieLibraries
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<PlayerSubtitleSearch> Logger
@implements IDisposable

@*
    Behaviour-only overlay inside the full-screen player. The player publishes the current item
    through SubtitleSearchLauncher; this component resolves it to the TV library and opens the same
    subtitle search popup used by movie and episode details.
*@

@code {
    bool _subscribed;

    protected override void OnInitialized()
    {
        if (!Subtitles.IsAvailable)
            return;

        Launcher.Requested += OnRequested;
        _subscribed = true;
    }

    public void Dispose()
    {
        if (_subscribed)
            Launcher.Requested -= OnRequested;
    }

    Task OnRequested(PlayerSubtitleSearchRequest request) =>
        InvokeAsync(async () =>
        {
            try
            {
                await OpenAsync(request);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not open subtitle search for {Title}", request.Title);
            }
        });

    async Task OpenAsync(PlayerSubtitleSearchRequest request)
    {
        SubtitleTarget? target = await ResolveAsync(request);
        if (target is null)
        {
            Snackbar.Add("This title is not in the TV library yet.", Severity.Warning);
            return;
        }

        DialogParameters<SubtitleSearchDialog> parameters = new()
        {
            { x => x.Target, target },
            { x => x.OnChanged, EventCallback.Factory.Create<string?>(this, RefreshPlayerAsync) }
        };
        IDialogReference dialog = await Dialogs.ShowAsync<SubtitleSearchDialog>(
            "Subtitles",
            parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    async Task<SubtitleTarget?> ResolveAsync(PlayerSubtitleSearchRequest request)
    {
        if (request.IsMovie)
        {
            IMovieLibrary? movieLibrary = MovieLibraries.FirstOrDefault();
            if (movieLibrary is null)
                return null;

            TvMovie? movie = request.TmdbId > 0
                ? (await movieLibrary.GetAllMoviesAsync()).FirstOrDefault(m => m.TmdbId == request.TmdbId)
                : null;
            return movie is null
                ? null
                : SubtitleTarget.Movie(movie.Id, movie.Title, request.Subtitle);
        }

        if (request.SeasonNumber is not int season || request.EpisodeNumber is not int episodeNumber)
            return null;

        ISeriesLibrary? seriesLibrary = SeriesLibraries.FirstOrDefault();
        if (seriesLibrary is null)
            return null;

        TvSeries? series = (await seriesLibrary.GetAllSeriesAsync()).FirstOrDefault(s =>
            (request.TvdbId > 0 && s.TvdbId == request.TvdbId)
            || (request.TmdbId > 0 && s.TmdbId == request.TmdbId));

        if (series is null)
            return null;

        TvEpisode? episode = (await seriesLibrary.GetEpisodesAsync(series.Id))
            .FirstOrDefault(e => e.SeasonNumber == season && e.EpisodeNumber == episodeNumber);
        if (episode is null)
            return null;

        return SubtitleTarget.Episode(series.Id, episode.Id, season, request.Title, request.Subtitle);
    }

    async Task RefreshPlayerAsync(string? language)
    {
        try
        {
            await JS.InvokeVoidAsync("arrkPlayer.refreshPlan", language);
        }
        catch
        {
            /* the player may already be gone */
        }
    }
}
