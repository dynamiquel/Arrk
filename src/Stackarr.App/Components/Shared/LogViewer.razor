@using Stackarr.App.Services
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

<div class="st-log-viewer @Class" @ref="_logViewer" @onwheel="@OnWheel">
    @if (Loading)
    {
        <div class="st-log-loading">
            <LoadingView Size="Size.Medium" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Loading logs...</MudText>
        </div>
    }
    else if (Entries.Count == 0)
    {
        <div class="st-log-empty">
            <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">No logs available</MudText>
            @if (!string.IsNullOrWhiteSpace(EmptyMessage))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@EmptyMessage</MudText>
            }
        </div>
    }
    else
    {
        <div class="st-log-content">@RenderLogs()</div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<LogEntry> Entries { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string EmptyMessage { get; set; } = "";
    [Parameter] public bool AutoScroll { get; set; } = true;
    [Parameter] public string? HighlightText { get; set; }
    [Parameter] public bool ReverseOrder { get; set; } = true;

    private ElementReference _logViewer;
    private bool _userScrolled = false;

    private MarkupString RenderLogs()
    {
        if (Entries.Count == 0)
            return new MarkupString("");

        var html = new System.Text.StringBuilder();
        var highlight = HighlightText?.ToLowerInvariant();

        var entriesToRender = ReverseOrder ? Entries.Reverse().ToList() : Entries.ToList();

        foreach (var entry in entriesToRender)
        {
            var levelClass = entry.Level.ToLowerInvariant() switch
            {
                "debug" => "st-log-debug",
                "verbose" => "st-log-debug",
                "information" => "st-log-info",
                "warning" => "st-log-warning",
                "error" => "st-log-error",
                "fatal" => "st-log-error",
                _ => "st-log-info"
            };

            var message = System.Net.WebUtility.HtmlEncode(entry.Message);
            var timestamp = System.Net.WebUtility.HtmlEncode(entry.Timestamp.ToString("HH:mm:ss.fff"));
            var level = System.Net.WebUtility.HtmlEncode(entry.Level.PadRight(7));

            // Clean up source context - remove brackets, quotes, etc.
            var sourceContext = "";
            if (!string.IsNullOrWhiteSpace(entry.SourceContext))
            {
                var cleaned = entry.SourceContext;
                var sb = new System.Text.StringBuilder();
                foreach (char c in cleaned)
                {
                    if (char.IsLetterOrDigit(c) || c == '.' || c == '_')
                        sb.Append(c);
                }
                cleaned = sb.ToString();
                if (!string.IsNullOrWhiteSpace(cleaned))
                {
                    sourceContext = System.Net.WebUtility.HtmlEncode(cleaned);
                }
            }

            if (!string.IsNullOrEmpty(highlight))
            {
                message = HighlightMatches(message, highlight);
            }

            // Merge level + source into one span (same line)
            var levelAndSource = sourceContext != "" ? $"{level} {sourceContext}" : level;

            // Emit each line without extra source whitespace: inside the pre-wrapped log
            // container literal newlines/indentation would render as visible padding.
            html.Append($"<div class=\"st-log-line {levelClass}\">");
            html.Append($"<span class=\"st-log-timestamp\">{timestamp}</span> ");
            html.Append($"<span class=\"st-log-level\">{levelAndSource}</span> ");
            html.Append($"<span class=\"st-log-message\">{message}</span>");
            html.Append("</div>");

            if (!string.IsNullOrEmpty(entry.Exception))
            {
                var exception = System.Net.WebUtility.HtmlEncode(entry.Exception);
                if (!string.IsNullOrEmpty(highlight))
                {
                    exception = HighlightMatches(exception, highlight);
                }
                html.Append($"<div class=\"st-log-exception\">{exception}</div>");
            }
        }

        return new MarkupString(html.ToString());
    }

    private string HighlightMatches(string text, string highlight)
    {
        var result = new System.Text.StringBuilder();
        var lowerText = text.ToLowerInvariant();
        var lastIndex = 0;
        var index = lowerText.IndexOf(highlight, StringComparison.OrdinalIgnoreCase);

        while (index >= 0)
        {
            result.Append(text.Substring(lastIndex, index - lastIndex));
            result.Append($"<mark class=\"st-log-highlight\">{text.Substring(index, highlight.Length)}</mark>");
            lastIndex = index + highlight.Length;
            index = lowerText.IndexOf(highlight, lastIndex, StringComparison.OrdinalIgnoreCase);
        }
        result.Append(text.Substring(lastIndex));
        return result.ToString();
    }

    private void OnWheel(WheelEventArgs e)
    {
        _userScrolled = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AutoScroll && !_userScrolled && _logViewer.Context != null)
        {
            try
            {
                await JS.InvokeVoidAsync("lv.scrollToBottom", ".st-log-viewer");
            }
            catch { }
        }
    }

    public void ResetUserScrolled() => _userScrolled = false;
}