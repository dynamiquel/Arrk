@page "/discover"
@page "/discover/{Source}"
@attribute [Authorize]
@inject UiRegistry Ui
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Stackarr - Discover</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Explore" Title="Discover">
    <Actions>
        @* Each module contributes its own "My …" quick links here, so the shell header never
           references a module. *@
        <UiRegion Name="@UiRegions.DiscoverActions" />
    </Actions>
</PageHeader>

@if (Ui.DiscoverSources.Count == 0)
{
    <ServiceDisabledNotice Title="Discover"
                           Detail="Turn on a media service (TV or Music) in configuration to browse and request media." />
}
else
{
    <StTabs T="string" Variant="segmented"
            Items="SectionTabs"
            Value="_sourceId"
            ValueChanged="SwitchSource" />

    @if (Current is not null)
    {
        <DynamicComponent Type="Current.Component" Parameters="ParametersFor(Current)" @key="Current.Id" />
    }
}

@code {
    /// <summary>The discover source id from the URL (e.g. "movies", "music").</summary>
    [Parameter] public string? Source { get; set; }

    string _sourceId = "";

    IReadOnlyList<StTabItem<string>> SectionTabs =>
        Ui.DiscoverSources.Select(s => new StTabItem<string>(s.Id, s.Label, s.Icon)).ToList();

    DiscoverSource? Current => Ui.FindDiscoverSource(_sourceId) ?? Ui.DiscoverSources.FirstOrDefault();

    Dictionary<string, object?> ParametersFor(DiscoverSource source)
    {
        Dictionary<string, object?> parameters = new();
        if (source.Parameters is { Count: > 0 })
        {
            foreach (KeyValuePair<string, object?> parameter in source.Parameters)
            {
                parameters[parameter.Key] = parameter.Value;
            }
        }

        return parameters;
    }

    protected override void OnInitialized() => Ui.Changed += OnSourcesChanged;

    protected override void OnParametersSet()
    {
        // A deep link (or a live disable) into an unavailable section falls back to the first
        // available one.
        DiscoverSource? requested = Ui.FindDiscoverSource(Source);
        _sourceId = (requested ?? Ui.DiscoverSources.FirstOrDefault())?.Id ?? "";
    }

    void SwitchSource(string id)
    {
        if (string.Equals(id, _sourceId, StringComparison.OrdinalIgnoreCase))
            return;
        Nav.NavigateTo($"/discover/{id}");
    }

    void OnSourcesChanged() => _ = InvokeAsync(() =>
    {
        if (Ui.FindDiscoverSource(_sourceId) is null)
        {
            DiscoverSource? next = Ui.DiscoverSources.FirstOrDefault();
            if (next is not null)
            {
                Nav.NavigateTo($"/discover/{next.Id}");
                return;
            }
        }
        StateHasChanged();
    });

    public void Dispose() => Ui.Changed -= OnSourcesChanged;
}
