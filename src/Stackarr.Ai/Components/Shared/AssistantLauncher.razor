@using Stackarr.Ui
@attribute [UiRegion(UiRegions.ShellAppBarActions, Order = 20, EnabledConfigPath = "ai")]
@inject IDialogService DialogService

@* App-bar launcher for the assistant popup. Gated by ai.enabled (the master switch), so it
   disappears live when AI is turned off; the popup itself explains an off/disabled state. *@

<MudTooltip Text="Ask the assistant">
    <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Inherit"
                   Class="st-header-btn" OnClick="OpenAsync" aria-label="Ask the assistant" />
</MudTooltip>

@code {
    async Task OpenAsync() =>
        await DialogService.ShowAsync<AssistantDialog>(null, StCardSheetOptions.CreateAnchored(MaxWidth.Small));
}
