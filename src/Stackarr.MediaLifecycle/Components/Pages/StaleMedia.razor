@page "/stale"
@attribute [Authorize(Policy = StackarrPolicies.AdminOnly)]
@inject StaleMediaService Stale
@inject MediaLifecycleService Lifecycle
@inject StaleCleanupJob Cleanup
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Stackarr - Stale Media</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.CleaningServices" Title="Stale Media">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RefreshAsync" Disabled="@_loading">
            Rescan
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                   OnClick="RunCleanupAsync" Disabled="@(_loading || _cleaning)">
            Run cleanup now
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="DeleteAllStaleAsync" Disabled="@(_loading || _report is null || !_report.Stale.Any())">
            Delete all stale
        </MudButton>
    </Actions>
</PageHeader>

@if (!Stale.IsAvailable)
{
    <ServiceDisabledNotice Title="Staleness tracking" Detail="Load the Media lifecycle module to evaluate and clean up stale media." />
}
else if (_loading && _report is null)
{
    <LoadingView />
}
else if (_report is not null)
{
    <MudGrid Spacing="3" Class="st-lifecycle-stats">
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="lifecycle.stale" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="lifecycle.expiring" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="lifecycle.reclaimable" Placement="TilePlacement.Page" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <TileView Id="lifecycle.autocleanup" Placement="TilePlacement.Page" />
        </MudItem>
    </MudGrid>

    <div class="st-lifecycle-toolbar">
        <StTabs T="string" Variant="segmented" Items="_statusTabs" Value="@_status" ValueChanged="SelectStatus" />
        <MudSelect T="string" Value="@_service" ValueChanged="SelectService" Dense="true" Variant="Variant.Outlined"
                   Class="st-lifecycle-service-select" Label="Service">
            <MudSelectItem T="string" Value="@("all")">All services</MudSelectItem>
            @foreach (IManagedMediaProvider provider in _providers)
            {
                <MudSelectItem T="string" Value="@provider.Key">@provider.DisplayName</MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (!Filtered.Any())
    {
        <EmptyState Icon="@Icons.Material.Filled.Spa" Message="Nothing here"
                    Detail="@EmptyMessage()" />
    }
    else
    {
        <div class="st-lifecycle-list">
            @foreach (StaleMediaItem item in Visible)
            {
                <StMediaRow ImageUrl="@item.Item.ImageUrl" Icon="@ServiceIcon(item.ProviderKey)" Title="@item.Item.Title"
                            Class="@RowClass(item)">
                    <Badges>
                        @if (item.Level != StaleLevel.Fresh)
                        {
                            <StChip Variant="@LevelVariant(item.Level)">@LevelLabel(item)</StChip>
                        }
                        @if (item.IsPinned)
                        {
                            <StChip Variant="purple">
                                <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" /> Pinned
                            </StChip>
                        }
                        @if (item.IsBookmarked)
                        {
                            <StChip Variant="info">
                                <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" />
                                @(item.BookmarkLabel ?? "Bookmarked")
                            </StChip>
                        }
                    </Badges>
                    <Info>
                        <span>@ServiceName(item.ProviderKey)</span>
                        @if (!string.IsNullOrEmpty(item.Item.Subtitle))
                        {
                            <span>· @item.Item.Subtitle</span>
                        }
                        <span>· @FormatBytes(item.Item.SizeOnDisk)</span>
                        <span>· last consumed @(item.LastConsumedAt is { } last ? Relative(last) : "never")</span>
                    </Info>
                    <Trailing>
                        <div class="st-lifecycle-remaining-value">@RemainingLabel(item)</div>
                        <div class="st-lifecycle-remaining-label">@RemainingCaption(item)</div>
                    </Trailing>
                    <Actions>
                        <PinButton ProviderKey="@item.ProviderKey" ItemKey="@item.ItemKey" Title="@item.Item.Title"
                                   IsPinned="item.IsPinned" OnToggled="@(_ => LoadAsync())" />
                        <StIconButton Icon="@Icons.Material.Filled.Delete" Title="@(item.IsPinned ? "Unpin before deleting" : "Delete")"
                                      Variant="ActionVariant.Danger" Disabled="@item.IsPinned"
                                      OnClick="@(() => DeleteOneAsync(item))" />
                    </Actions>
                </StMediaRow>
            }
        </div>

        <InfiniteScroll OnReached="LoadMore" Enabled="HasMore" ShowSpinner="_loading" />
    }
}
else
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Text">Could not load staleness data.</MudAlert>
}

@code {
    const int PageSize = 50;

    StaleMediaReport? _report;
    List<IManagedMediaProvider> _providers = [];
    bool _loading;
    bool _cleaning;
    string _status = "stale";
    string _service = "all";
    int _shown = PageSize;

    List<StTabItem<string>> _statusTabs = [];

    IEnumerable<StaleMediaItem> Filtered => _report is null
        ? []
        : _report.Items
            .Where(x => _service == "all" || x.ProviderKey == _service)
            .Where(x => _status switch
            {
                "stale" => x.IsStale,
                "expiring" => x.IsExpiring,
                "pinned" => x.IsPinned,
                _ => true
            })
            .OrderByDescending(x => x.IsStale)
            .ThenBy(x => x.DaysRemaining ?? double.MaxValue);

    IEnumerable<StaleMediaItem> Visible => Filtered.Take(_shown);

    bool HasMore => Filtered.Count() > _shown;

    protected override async Task OnInitializedAsync()
    {
        _providers = Lifecycle.Providers.ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _report = await Stale.GetReportAsync(forceRefresh: true);
            _statusTabs =
            [
                new StTabItem<string>("stale", "Stale", Count: _report?.Stale.Count().ToString()),
                new StTabItem<string>("expiring", "About to be stale", Count: _report?.Expiring.Count().ToString()),
                new StTabItem<string>("pinned", "Pinned", Count: _report?.Pinned.Count().ToString()),
                new StTabItem<string>("all", "All", Count: _report?.Items.Count.ToString())
            ];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    async Task RefreshAsync() => await LoadAsync();

    async Task RunCleanupAsync()
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Run cleanup now",
            "Scan every library item, send staleness alerts and delete stale items for services with automatic cleanup enabled. Pinned items are never touched.",
            yesText: "Run cleanup",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        _cleaning = true;
        StateHasChanged();
        try
        {
            await Cleanup.Execute(CancellationToken.None);
            Snackbar.Add("Cleanup complete.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cleanup failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cleaning = false;
            StateHasChanged();
        }
    }

    void SelectStatus(string value)
    {
        _status = value;
        _shown = PageSize;
    }

    void SelectService(string value)
    {
        _service = value;
        _shown = PageSize;
    }

    void LoadMore() => _shown += PageSize;

    async Task DeleteOneAsync(StaleMediaItem item)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Delete media",
            $"Delete \"{item.Item.Title}\" and reclaim {FormatBytes(item.Item.SizeOnDisk)}? This removes the files from disk.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        ManagedMediaDeleteResult result = await Stale.DeleteAsync(item.ProviderKey, item.ItemKey);
        if (result.Success)
            Snackbar.Add($"Deleted \"{item.Item.Title}\". Space saved: {FormatBytes(result.BytesFreed)}.", Severity.Success);
        else
            Snackbar.Add(result.Message ?? "Could not delete that item.", Severity.Error);

        await LoadAsync();
    }

    async Task DeleteAllStaleAsync()
    {
        if (_report is null || !_report.Stale.Any())
            return;

        List<StaleMediaItem> stale = _report.Stale.ToList();
        long bytes = stale.Sum(x => x.Item.SizeOnDisk);
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Delete all stale media",
            $"Delete {stale.Count} stale item(s) and reclaim up to {FormatBytes(bytes)}? This removes the files from disk and cannot be undone.",
            yesText: "Delete all",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        long freed = 0;
        int deleted = 0;
        foreach (StaleMediaItem item in stale)
        {
            ManagedMediaDeleteResult result = await Stale.DeleteAsync(item.ProviderKey, item.ItemKey);
            if (result.Success)
            {
                freed += result.BytesFreed;
                deleted++;
            }
        }

        Snackbar.Add($"Deleted {deleted} item(s). Space saved: {FormatBytes(freed)}.", Severity.Success);
        await LoadAsync();
    }

    string EmptyMessage() => _status switch
    {
        "stale" => "No media is stale right now.",
        "expiring" => "Nothing is approaching its stale threshold.",
        "pinned" => "No media is pinned.",
        _ => "No managed media found for this filter."
    };

    static string RowClass(StaleMediaItem item) => item.IsStale ? "is-stale" : item.IsExpiring ? "is-expiring" : "";

    static string LevelVariant(StaleLevel level) => level switch
    {
        StaleLevel.Stale => "error",
        StaleLevel.Expiring => "warning",
        _ => "success"
    };

    static string LevelLabel(StaleMediaItem item) => item.Level switch
    {
        StaleLevel.Stale => "Stale",
        StaleLevel.Expiring => "Leaving soon",
        _ => ""
    };

    static string RemainingLabel(StaleMediaItem item)
    {
        if (item.IsPinned)
            return "—";
        if (item.DaysRemaining is not { } days)
            return "—";
        if (item.IsStale)
            return $"{Math.Max(0, -days):0.#}d";
        return $"{Math.Max(0, days):0.#}d";
    }

    static string RemainingCaption(StaleMediaItem item)
    {
        if (item.IsPinned)
            return "never stale";
        return item.IsStale ? "over threshold" : "remaining";
    }

    static string ServiceName(string key) => key switch
    {
        "tv" => "TV",
        "music" => "Music",
        _ => key
    };

    static string ServiceIcon(string key) => key switch
    {
        "tv" => Icons.Material.Filled.Tv,
        "music" => Icons.Material.Filled.MusicNote,
        _ => Icons.Material.Filled.PermMedia
    };

    static string Relative(DateTime at)
    {
        TimeSpan age = DateTime.UtcNow - at.ToUniversalTime();
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h ago";
        if (age.TotalDays < 30) return $"{(int)age.TotalDays}d ago";
        return at.ToLocalTime().ToString("yyyy-MM-dd");
    }

    static string FormatBytes(long bytes) => StaleCleanupJob.FormatBytes(bytes);
}
