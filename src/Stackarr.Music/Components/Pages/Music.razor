@page "/music"
@attribute [Authorize]
@using Stackarr.Navidrome
@using Stackarr.Navidrome.Models
@using Stackarr.Core.Lifecycle
@inject MusicCatalogService Catalog
@inject MusicStaleEnricher Stale
@inject NavidromeService Navidrome
@inject MusicLibraryService MusicLibrary
@inject MusicSubscriptionService Subscriptions
@inject MusicDialogLauncher Launcher
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<Music> Logger
@inject UiRegistry Ui
@implements IDisposable

<PageTitle>Stackarr - Music</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.LibraryMusic" Title="Music">
    <Actions>
        <MudButton Href="/discover/music" Variant="Variant.Filled" Color="Color.Primary" Class="st-btn-gradient"
                   StartIcon="@Icons.Material.Filled.Explore" title="Discover music" AriaLabel="Discover music">
            <span class="st-btn-label">Discover Music</span>
        </MudButton>
        @if (Navidrome.IsEnabled)
        {
            <MudButton Href="/navidrome" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew" Target="_blank">
                <span class="st-btn-label">Navidrome</span>
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (!Ui.IsAvailable("services:music"))
{
    <ServiceDisabledNotice Title="Music"
                           Detail="Music is turned off. Set services.music.enabled to true (Configuration → Music) to use the library." />
}
else
{

<MudGrid Class="mb-4">
    <MudItem xs="6" sm="4" md="2">
        <TileView Id="music.albums" Placement="TilePlacement.Page" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <TileView Id="music.songs" Placement="TilePlacement.Page" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <TileView Id="music.downloaded" Placement="TilePlacement.Page" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <TileView Id="music.missing" Placement="TilePlacement.Page" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <TileView Id="music.downloading" Placement="TilePlacement.Page" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <TileView Id="music.ondisk" Placement="TilePlacement.Page" />
    </MudItem>
</MudGrid>

@if (string.IsNullOrEmpty(_search) && (_playQueue?.Entry.Count > 0 || _history.Count > 0 || _playlists.Count > 0))
{
    <div class="mb-5">
        <MusicShelfRow Title="Recently Played" ShowTitle="true" Limit="6"
                       UseProvidedData="true"
                       Playlists="VisiblePlaylists.ToList()" History="_history" PlayQueue="_playQueue"
                       UserId="_userId" IsAdmin="_isAdmin" OnChanged="LoadAsync" />
    </div>
}

<div class="st-discover-controls">
    <SearchBox @bind-Value="_search" Placeholder="Search your music..." DebounceInterval="350"
               OnSearch="OnSearchChanged" Class="st-discover-search" />
</div>

<StTabs T="MusicTab" Items="Tabs" Value="_tab" ValueChanged="SwitchTab" />

@if (_loading)
{
    <LoadingView />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert>
}
else if (_tab == MusicTab.Songs)
{
    int unidentified = _songs.Count(s => s.IsUnidentified);
    IReadOnlyList<StatusGroup<MusicItem>> songGroups = MusicStatusGrouping.ForMusic(FilteredSongs);
    @if (unidentified > 0)
    {
        <div class="st-music-songs-toolbar">
            <MudSwitch T="bool" @bind-Value="_showUnidentified" @bind-Value:after="@(() => _songsShown.Clear())" Color="Color.Primary"
                       Label="@($"Show unidentified ({unidentified})")" Dense="true" />
        </div>
    }
    @if (songGroups.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.MusicNote" Message="@(_songs.Count == 0 ? "No songs yet — add an album from Discover." : "No songs match (unidentified songs are hidden).")" />
    }
    else
    {
        @foreach (StatusGroup<MusicItem> group in songGroups)
        {
            int shown = Shown(_songsShown, group.Kind);
            <StCollapsibleSection @key="group.Kind" Icon="@group.Icon" Title="@group.Title"
                                  Count="@group.Count" Accent="@group.Accent">
                <div class="st-music-grid">
                    @foreach (MusicItem song in group.Items.Take(shown))
                    {
                        <MusicCard ShowInLibraryBadge="false" Item="song" OnClick="PlayLibrarySong" OnPlay="PlayLibrarySong"
                                   OnAddToPlaylist="@((MusicItem s) => AddToPlaylistAsync(s))" />
                    }
                </div>
                @if (group.Count > shown)
                {
                    <InfiniteScroll OnReached="@(() => LoadMoreSongs(group.Kind))" Enabled="@(group.Count > shown)" ShowSpinner="true" />
                }
            </StCollapsibleSection>
        }
    }
}
else if (_tab == MusicTab.Recent)
{
    @if (_recent.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.NewReleases" Message="No recently added music yet." />
    }
    else
    {
        <div class="st-music-grid">
            @foreach (MusicItem album in _recent)
            {
                <MusicCard ShowInLibraryBadge="false" Item="album"
                           OnClick="OpenAlbum"
                           OnPlay="@((MusicItem a) => PlayAlbumItemAsync(a, false))" />
            }
        </div>
    }
}
else if (_tab == MusicTab.Playlists)
{
    <div style="margin:var(--st-space-md) 0;display:flex;gap:8px;flex-wrap:wrap;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="st-btn-gradient" StartIcon="@Icons.Material.Filled.Add" OnClick="CreatePlaylistAsync">
            <span class="st-btn-label">New Playlist</span>
        </MudButton>
        @if (_isAdmin)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ImportPlaylistsAsync">
                <span class="st-btn-label">Import from Navidrome</span>
            </MudButton>
        }
    </div>
    @if (_subscriptions.Count == 0 && !VisiblePlaylists.Any())
    {
        <EmptyState Icon="@Icons.Material.Filled.QueueMusic" Message="No playlists yet. Create one from your library, or subscribe to one in Discover." />
    }
    else
    {
        <div class="st-music-grid">
            @foreach (MusicSubscription sub in _subscriptions)
            {
                <div class="st-media-card st-music-card st-music-playlist-tile" @onclick="() => OpenSubscriptionAsync(sub)">
                    <div class="st-media-card-badge st-music-sub-badge">Subscribed</div>
                    <div class="st-music-playlist-icon" style="@SubscriptionArtStyle(sub)">
                        @if (string.IsNullOrEmpty(sub.ArtUrl))
                        {
                            <span>♪</span>
                        }
                    </div>
                    <div class="st-media-card-info">
                        <div class="st-media-card-title" title="@sub.Name">@sub.Name</div>
                        <div class="st-media-card-meta"><span>@sub.MatchCount/@sub.TrackCount songs</span></div>
                    </div>
                    <StIconButton Overlay StopPropagation Icon="@Icons.Material.Filled.Delete"
                                  Class="st-music-playlist-del" Title="Unsubscribe" Variant="ActionVariant.Danger"
                                  OnClick="() => UnsubscribeAsync(sub)" />
                </div>
            }
            @foreach (SubsonicPlaylist playlist in VisiblePlaylists)
            {
                <div class="st-media-card st-music-card st-music-playlist-tile" @onclick="() => ManagePlaylistAsync(playlist)">
                    <div class="st-music-playlist-icon">@IconFor(playlist)</div>
                    <div class="st-media-card-info">
                        <div class="st-media-card-title" title="@playlist.Name">@playlist.Name</div>
                        <div class="st-media-card-meta"><span>@playlist.SongCount song@(playlist.SongCount == 1 ? "" : "s")</span></div>
                    </div>
                    <StIconButton Overlay StopPropagation Icon="@Icons.Material.Filled.Delete"
                                  Class="st-music-playlist-del" Title="Delete" Variant="ActionVariant.Danger"
                                  OnClick="() => DeletePlaylistAsync(playlist)" />
                </div>
            }
        </div>
    }
}
else if (_tab == MusicTab.Albums)
{
    IReadOnlyList<StatusGroup<MusicItem>> albumGroups = MusicStatusGrouping.ForMusic(FilteredAlbums);
    @if (albumGroups.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.LibraryMusic" Message="No albums yet — discover music and add it to your library." />
    }
    else
    {
        @foreach (StatusGroup<MusicItem> group in albumGroups)
        {
            int shown = Shown(_albumsShown, group.Kind);
            <StCollapsibleSection @key="group.Kind" Icon="@group.Icon" Title="@group.Title"
                                  Count="@group.Count" Accent="@group.Accent">
                <div class="st-music-grid">
                    @foreach (MusicItem album in group.Items.Take(shown))
                    {
                        <MusicCard ShowInLibraryBadge="false" Item="album" OnClick="OpenAlbum" OnPlay="PlayAlbumItem" />
                    }
                </div>
                @if (group.Count > shown)
                {
                    <InfiniteScroll OnReached="@(() => LoadMoreAlbums(group.Kind))" Enabled="@(group.Count > shown)" ShowSpinner="true" />
                }
            </StCollapsibleSection>
        }
    }
}
else
{
    @if (!FilteredArtists.Any())
    {
        <EmptyState Icon="@Icons.Material.Filled.LibraryMusic" Message="No artists yet — discover music and add it to your library." />
    }
    else
    {
        <div class="st-music-grid">
            @foreach (MusicItem artist in FilteredArtists)
            {
                <MusicCard ShowInLibraryBadge="false" Item="artist" OnClick="OpenArtist" OnPlay="OpenArtist" />
            }
        </div>
    }
}
}

@code {
    enum MusicTab { Songs, Artists, Albums, Recent, Playlists }

    static readonly StTabItem<MusicTab>[] Tabs =
    [
        new(MusicTab.Playlists, "Playlists", Icons.Material.Filled.QueueMusic),
        new(MusicTab.Songs, "Songs", Icons.Material.Filled.MusicNote),
        new(MusicTab.Artists, "Artists", Icons.Material.Filled.Person),
        new(MusicTab.Albums, "Albums", Icons.Material.Filled.Album),
        new(MusicTab.Recent, "Recently Added", Icons.Material.Filled.NewReleases)
    ];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    bool _isAdmin;

    MusicTab _tab = MusicTab.Playlists;
    bool _loading = true;
    string? _error;
    string _search = "";
    bool _showUnidentified;
    List<MusicItem> _navidromeHits = [];

    // Lazy rendering: each status section renders at most this many cards at a time; the rest load as
    // the section's sentinel scrolls into view, so a big library doesn't render hundreds of cards.
    const int PageSize = 60;
    readonly Dictionary<StatusGroupKind, int> _songsShown = [];
    readonly Dictionary<StatusGroupKind, int> _albumsShown = [];

    List<MusicItem> _songs = [];
    List<MusicPlayHistory> _history = [];
    static string AlbumKey(string value) => new(value.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());
    List<MusicItem> _artists = [];
    List<MusicItem> _albums = [];
    List<MusicItem> _recent = [];
    List<SubsonicPlaylist> _playlists = [];
    List<MusicSubscription> _subscriptions = [];
    Dictionary<string, string> _playlistIcons = new(StringComparer.OrdinalIgnoreCase);
    SubsonicPlayQueue? _playQueue;
    int _userId;

    IEnumerable<MusicItem> FilteredArtists => _artists.Where(Matches);

    IEnumerable<MusicItem> FilteredAlbums => _albums.Where(Matches);

    /// <summary>How many cards a section has rendered so far (grows by <see cref="PageSize"/>).</summary>
    static int Shown(Dictionary<StatusGroupKind, int> map, StatusGroupKind kind) =>
        map.TryGetValue(kind, out int shown) ? shown : PageSize;

    IEnumerable<MusicItem> FilteredSongs
    {
        get
        {
            IEnumerable<MusicItem> local = _songs
                .Where(s => (_showUnidentified || !s.IsUnidentified) && Matches(s))
                .OrderByDescending(s => s.HasFile)
                .ThenBy(s => s.Title, StringComparer.OrdinalIgnoreCase);
            if (string.IsNullOrWhiteSpace(_search))
                return local;
            // Fold in Navidrome matches we don't track locally (e.g. a song only in a playlist).
            HashSet<string> keys = local.Select(SongKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return local.Concat(_navidromeHits.Where(h => !keys.Contains(SongKey(h))));
        }
    }

    static string SongKey(MusicItem item) => $"{AlbumKey(item.Title)}|{AlbumKey(item.ArtistName)}";

    async Task OnSearchChanged(string value)
    {
        _songsShown.Clear();
        _albumsShown.Clear();
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 3)
        {
            _navidromeHits = [];
            return;
        }
        try
        {
            List<SubsonicSong> hits = await Navidrome.SearchSongsAsync(value.Trim(), 25);
            _navidromeHits = hits.Select(s => new MusicItem
            {
                EntityType = MusicEntityType.Track,
                Title = s.Title,
                ArtistName = s.Artist,
                AlbumName = s.Album,
                ArtUrl = !string.IsNullOrEmpty(s.CoverArt) ? NavidromeService.CoverArtUrl(s.CoverArt) : "",
                IsInLibrary = true,
                HasFile = true,
                LibraryStatus = "Downloaded"
            }).ToList();
        }
        catch
        {
            _navidromeHits = [];
        }
    }

    /// <summary>Library playlists excluding the Navidrome projections of subscriptions, a
    /// subscription already renders as its own tile, so it must not also appear as a plain playlist.</summary>
    IEnumerable<SubsonicPlaylist> VisiblePlaylists =>
        _playlists.Where(p => !_subscriptions.Any(s => !string.IsNullOrEmpty(s.NavidromePlaylistId) && s.NavidromePlaylistId == p.Id));

    bool Matches(MusicItem item) =>
        string.IsNullOrWhiteSpace(_search) ||
        item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        item.ArtistName.Contains(_search, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // A disabled module's page neither loads data nor runs any action.
        if (!Ui.IsAvailable("services:music"))
        {
            _loading = false;
            return;
        }

        if (AuthStateTask is not null)
        {
            System.Security.Claims.ClaimsPrincipal user = (await AuthStateTask).User;
            _isAdmin = user.IsInRole(StackarrRoles.Admin);
            int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
        }
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            (List<MusicItem> artists, List<MusicItem> albums) = await Catalog.GetLibraryViewAsync();
            IReadOnlyDictionary<string, StaleMediaItem> staleStatuses = await Stale.LoadAsync();
            _albums = Stale.Enrich(albums, staleStatuses);
            // Songs come from our own library (single source of truth), so each song's identification
            // and metadata match the album popup. Playback resolves the Navidrome id at click time.
            // Keep placed *and* missing songs so the Songs/Downloaded/Missing tiles agree with the tab
            // and with the album counts (missing songs render with a Missing badge).
            _songs = Stale.Enrich(await Catalog.GetLibrarySongsAsync(), staleStatuses);
            _artists = artists;
            _recent = Stale.Enrich(await Catalog.GetRecentlyAddedAsync(), staleStatuses);
            _history = await MusicLibrary.GetRecentlyPlayedAsync(_userId);
            _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
            _subscriptions = await Subscriptions.GetForUserAsync(_userId);
            try { _playlistIcons = await JS.InvokeAsync<Dictionary<string, string>>("stackarrPlaylists._all") ?? new(); }
            catch { /* icons optional */ }
            try { _playQueue = await Navidrome.GetPlayQueueAsync(); }
            catch { /* queue optional */ }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load music library");
            _error = "Could not load your music library. Check that Navidrome is running.";
        }
        _loading = false;
    }

    Task SwitchTab(MusicTab tab)
    {
        _tab = tab;
        _songsShown.Clear();
        _albumsShown.Clear();
        return Task.CompletedTask;
    }

    Task LoadMoreSongs(StatusGroupKind kind)
    {
        _songsShown[kind] = Shown(_songsShown, kind) + PageSize;
        return Task.CompletedTask;
    }

    Task LoadMoreAlbums(StatusGroupKind kind)
    {
        _albumsShown[kind] = Shown(_albumsShown, kind) + PageSize;
        return Task.CompletedTask;
    }

    async Task PlayAlbumAsync(string albumId, bool shuffle = false, MusicItem? source = null)
    {
        SubsonicAlbumWithSongs? album = await Navidrome.GetAlbumAsync(albumId);
        if (album is null || album.Song.Count == 0)
        {
            Snackbar.Add("Nothing to play.", Severity.Info);
            return;
        }
        await PlaySongsAsync(album.Song, shuffle, source);
    }

    /// <summary>Plays a library album (matched in Navidrome by artist + title).</summary>
    Task PlayAlbumItem(MusicItem album) => PlayAlbumItemAsync(album, false);

    async Task PlayAlbumItemAsync(MusicItem album, bool shuffle)
    {
        string? navId = await Navidrome.FindAlbumIdAsync(album.Title, album.ArtistName);
        if (string.IsNullOrEmpty(navId))
        {
            Snackbar.Add($"\"{album.Title}\" isn't in Navidrome yet.", Severity.Info);
            return;
        }
        await PlayAlbumAsync(navId, shuffle, album);
    }

    async Task PlaySongsAsync(List<SubsonicSong> songs, bool shuffle = false, MusicItem? album = null)
    {
        if (songs.Count == 0) return;
        IEnumerable<SubsonicSong> ordered = shuffle ? songs.OrderBy(_ => Random.Shared.Next()) : songs;
        long artistDeezerId = album?.ArtistDeezerId ?? 0;
        long albumDeezerId = album?.DeezerId ?? 0;
        string albumArtist = album?.ArtistName ?? "";
        var queue = ordered.Select(s => new
        {
            id = s.Id,
            title = s.Title,
            artist = s.Artist,
            albumArtist = string.IsNullOrWhiteSpace(albumArtist) ? s.Artist : albumArtist,
            album = string.IsNullOrWhiteSpace(s.Album) ? album?.Title ?? "" : s.Album,
            cover = !string.IsNullOrEmpty(s.CoverArt) ? NavidromeService.CoverArtUrl(s.CoverArt) : "",
            artistDeezerId,
            albumDeezerId
        }).ToList();

        try { await JS.InvokeVoidAsync("stackarrMusic.play", queue, 0); }
        catch (Exception ex) { Logger.LogDebug(ex, "Could not start music playback"); }
    }

    async Task ManagePlaylistAsync(SubsonicPlaylist playlist)
    {
        IDialogReference dialog = await Launcher.OpenLibraryPlaylistAsync(playlist);
        await dialog.Result;
        _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
    }

    async Task CreatePlaylistAsync()
    {
        DialogParameters<PlaylistDialog> p = new();
        IDialogReference dialog = await DialogService.ShowAsync<PlaylistDialog>("New playlist", p, MusicDialogLauncher.Detail());
        DialogResult result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not string name || string.IsNullOrWhiteSpace(name))
            return;

        try
        {
            await MusicLibrary.CreatePlaylistAsync(_userId, name, []);
            Snackbar.Add($"Created playlist {name}.", Severity.Success);
            _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create playlist: {ex.Message}", Severity.Error);
        }
    }

    async Task ImportPlaylistsAsync()
    {
        try
        {
            int count = await MusicLibrary.ClaimUnownedPlaylistsAsync(_userId);
            Snackbar.Add(count == 0 ? "No playlists to import." : $"Imported {count} playlist(s).", Severity.Success);
            _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not import playlists: {ex.Message}", Severity.Error);
        }
    }

    async Task OpenSubscriptionAsync(MusicSubscription sub)
    {
        IDialogReference dialog = await Launcher.OpenSubscriptionAsync(sub);
        await dialog.Result;
        _subscriptions = await Subscriptions.GetForUserAsync(_userId);
    }

    async Task UnsubscribeAsync(MusicSubscription sub)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync("Unsubscribe",
            $"Unsubscribe from \"{sub.Name}\"? The playlist will be removed from your library.", yesText: "Unsubscribe", cancelText: "Cancel");
        if (confirm != true) return;
        try
        {
            await Subscriptions.UnsubscribeAsync(_userId, _isAdmin, sub.Id);
            _subscriptions = await Subscriptions.GetForUserAsync(_userId);
            _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
            Snackbar.Add($"Unsubscribed from {sub.Name}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not unsubscribe: {ex.Message}", Severity.Error);
        }
    }

    async Task DeletePlaylistAsync(SubsonicPlaylist playlist)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync("Delete playlist",
            $"Delete \"{playlist.Name}\"?", yesText: "Delete", cancelText: "Cancel");
        if (confirm != true) return;
        try
        {
            await MusicLibrary.DeletePlaylistAsync(_userId, _isAdmin, playlist.Id);
            _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete playlist: {ex.Message}", Severity.Error);
        }
    }

    async Task OpenAlbum(MusicItem album)
    {
        IDialogReference dialog = await Launcher.OpenAlbumAsync(album, _isAdmin);
        await dialog.Result;
        Catalog.InvalidateLibraryCache();
        await LoadAsync();
    }

    async Task OpenArtist(MusicItem artist)
    {
        IDialogReference dialog = await Launcher.OpenArtistAsync(artist, _isAdmin);
        await dialog.Result;
        Catalog.InvalidateLibraryCache();
        await LoadAsync();
    }

    async Task PlayLibrarySong(MusicItem song)
    {
        try
        {
            if (!song.HasFile)
            {
                Snackbar.Add($"\"{song.Title}\" isn't downloaded yet.", Severity.Info);
                return;
            }
            string? id = await Navidrome.FindSongIdAsync(song.Title, song.ArtistName);
            if (string.IsNullOrEmpty(id))
            {
                Snackbar.Add($"\"{song.Title}\" isn't in Navidrome yet.", Severity.Info);
                return;
            }
            var queue = new[]
            {
                new { id, title = song.Title, artist = song.ArtistName, albumArtist = song.ArtistName, album = song.AlbumName,
                      cover = song.ArtUrl, stream = NavidromeService.PlayerStreamUrl(id),
                      artistDeezerId = song.ArtistDeezerId, albumDeezerId = song.AlbumDeezerId }
            };
            await JS.InvokeVoidAsync("stackarrMusic.play", queue, 0);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not play library song");
        }
    }

    string IconFor(SubsonicPlaylist playlist) =>
        _playlistIcons.TryGetValue(playlist.Id, out string? icon) && !string.IsNullOrEmpty(icon) ? icon : "♪";

    static string SubscriptionArtStyle(MusicSubscription sub) =>
        string.IsNullOrEmpty(sub.ArtUrl)
            ? ""
            : $"background-image:linear-gradient(135deg, rgba(15,10,24,.25), rgba(15,10,24,.25)), url('{sub.ArtUrl}');background-size:cover;background-position:center;";

    async Task AddToPlaylistAsync(MusicItem song)
    {
        DialogParameters<AddToPlaylistDialog> p = new()
        {
            { x => x.Title, $"{song.Title} — {song.ArtistName}" },
            { x => x.SongTitle, song.Title },
            { x => x.SongArtist, song.ArtistName }
        };
        await DialogService.ShowAsync<AddToPlaylistDialog>("Add to playlist", p, new DialogOptions { MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true });
    }

    public void Dispose() { }
}
