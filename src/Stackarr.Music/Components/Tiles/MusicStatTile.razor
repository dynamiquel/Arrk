@inject MusicLibrarySummaryService Summary
@using Stackarr.Ui.Components
@implements IDisposable

@if (_loading)
{
    <MudSkeleton Width="70px" Height="32px" />
}
else
{
    <div class="st-stat-value st-stat-value--@ValueColor">@Value</div>
    <div class="st-stat-sub">@Sub</div>
}

@code {
    [Parameter] public TileContext? Context { get; set; }

    /// <summary>One of <c>albums</c>, <c>songs</c>, <c>downloaded</c>, <c>missing</c>, <c>downloading</c> or <c>ondisk</c>.</summary>
    [Parameter] public string Metric { get; set; } = "albums";

    const int RefreshSeconds = 60;

    MusicLibrarySummary? _summary;
    bool _loading = true;
    Timer? _timer;
    CancellationTokenSource? _cts;

    int Songs => _summary?.Songs.Count ?? 0;
    int DownloadedSongs => _summary?.Songs.Count(s => s.HasFile) ?? 0;

    string Value => Metric switch
    {
        "songs" => Songs.ToString(),
        "downloaded" => DownloadedSongs.ToString(),
        "missing" => Math.Max(0, Songs - DownloadedSongs).ToString(),
        "downloading" => (_summary?.Albums.Count(a => a.IsDownloading) ?? 0).ToString(),
        "ondisk" => FormatHelper.FormatBytes(_summary?.SizeBytes ?? 0),
        _ => (_summary?.Albums.Count ?? 0).ToString()
    };

    string Sub => Metric switch
    {
        "songs" => $"{DownloadedSongs} downloaded",
        "downloaded" => Songs == 0
            ? "0% of songs"
            : $"{(int)Math.Round(DownloadedSongs * 100.0 / Songs)}% of songs",
        "missing" => "Awaiting download",
        "downloading" => "Active in queue",
        "ondisk" => $"{_summary?.Albums.Count ?? 0} albums tracked",
        _ => $"{_summary?.Artists.Count ?? 0} artists"
    };

    string ValueColor => Metric switch
    {
        "songs" => "purple",
        "downloaded" => "green",
        "missing" => "red",
        "downloading" => "blue",
        "ondisk" => "yellow",
        _ => "pink"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);

        (Timer Timer, CancellationTokenSource Cts) result = AsyncTimerHelper.Create(
            async ct =>
            {
                await LoadAsync(ct);
                await InvokeAsync(StateHasChanged);
            },
            TimeSpan.FromSeconds(RefreshSeconds),
            TimeSpan.FromSeconds(RefreshSeconds));
        _timer = result.Timer;
        _cts = result.Cts;
    }

    async Task LoadAsync(CancellationToken ct)
    {
        try
        {
            _summary = await Summary.GetAsync(ct);
            _loading = false;
        }
        catch
        {
            // Keep the last snapshot and stop showing the loading skeleton.
            _loading = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
