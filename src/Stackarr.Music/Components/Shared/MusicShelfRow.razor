@* A horizontally scrolling music shelf shared by the Music page and the dashboard tiles. It can
   show the resume queue, owned playlists and recent history, capped at a small number of cards so
   "Recently Played" stays a quick shortcut rather than a second library. *@
@inject MusicLibraryService MusicLibrary
@inject MusicSubscriptionService MusicSubscriptions
@inject NavidromeService Navidrome
@inject MusicDialogLauncher Launcher
@inject IJSRuntime JS
@inject ILogger<MusicShelfRow> Logger
@inject AuthenticationStateProvider AuthProvider

@if (_entries.Count > 0)
{
    <div class="st-music-shelf">
        @if (ShowTitle)
        {
            <div class="st-continue-head">
                <MudIcon Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@Title</MudText>
            </div>
        }
        <ScrollRow TrackClass="st-music-scroll-row">
            @foreach (ShelfEntry entry in _entries)
            {
                <div class="st-music-card-wrap" @key="entry.Key">
                    @if (entry.Kind == ShelfKind.Resume)
                    {
                        <MusicCard ShowInLibraryBadge="false" Item="entry.Item"
                                   OnClick="ResumeQueueAsync" OnPlay="ResumeQueueAsync"
                                   Class="st-music-card--resume" Badge="Resume" />
                    }
                    else if (entry.Kind == ShelfKind.Subscription)
                    {
                        <MusicCard ShowInLibraryBadge="false" Item="entry.Item"
                                   OnClick="@((MusicItem _) => OpenSubscriptionAsync(entry.Subscription!))"
                                   OnPlay="@((MusicItem _) => PlaySubscriptionAsync(entry.Subscription!))"
                                   Badge="Subscribed" />
                    }
                    else if (entry.Kind == ShelfKind.Playlist)
                    {
                        <MusicCard ShowInLibraryBadge="false" Item="entry.Item"
                                   OnClick="@((MusicItem _) => OpenPlaylistAsync(entry.Playlist!))"
                                   OnPlay="@((MusicItem _) => PlayPlaylistAsync(entry.Playlist!))" />
                    }
                    else
                    {
                        <MusicCard ShowInLibraryBadge="false" Item="entry.Item"
                                   OnClick="@((MusicItem _) => PlayHistoryAsync(entry.History!))"
                                   OnPlay="@((MusicItem _) => PlayHistoryAsync(entry.History!))" />
                    }
                </div>
            }
        </ScrollRow>
    </div>
}

@code {
    enum ShelfKind { Resume, Subscription, Playlist, History }

    sealed record ShelfEntry(
        string Key,
        MusicItem Item,
        ShelfKind Kind,
        SubsonicPlaylist? Playlist,
        MusicSubscription? Subscription,
        MusicPlayHistory? History);

    sealed record QueueItem(
        string id,
        string title,
        string artist,
        string albumArtist,
        string album,
        string cover,
        long artistDeezerId,
        long albumDeezerId,
        string stream);

    [Parameter] public string Title { get; set; } = "Recently Played";
    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public int Limit { get; set; } = 6;
    [Parameter] public bool IncludeResume { get; set; } = true;
    [Parameter] public bool IncludePlaylists { get; set; } = true;
    [Parameter] public bool IncludeHistory { get; set; } = true;

    /// <summary>The page passes its already-loaded collections; a dashboard tile lets the shelf load
    /// them itself from the signed-in account.</summary>
    [Parameter] public bool UseProvidedData { get; set; }
    [Parameter] public IReadOnlyList<SubsonicPlaylist>? Playlists { get; set; }
    [Parameter] public IReadOnlyList<MusicSubscription>? Subscriptions { get; set; }
    [Parameter] public IReadOnlyList<MusicPlayHistory>? History { get; set; }
    [Parameter] public SubsonicPlayQueue? PlayQueue { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    readonly List<ShelfEntry> _entries = [];
    List<SubsonicPlaylist> _playlists = [];
    List<MusicSubscription> _subscriptions = [];
    List<MusicPlayHistory> _history = [];
    SubsonicPlayQueue? _playQueue;
    int _userId;
    bool _isAdmin;
    bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        if (UserId > 0)
        {
            _userId = UserId;
            _isAdmin = IsAdmin;
        }
        else
        {
            AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
            _isAdmin = state.User.IsInRole(StackarrRoles.Admin);
            int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId);
        }

        if (UseProvidedData)
        {
            ApplyProvidedData();
        }
        else
        {
            try
            {
                await ReloadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not load the music shelf");
            }
        }

        Rebuild();
        _loaded = true;
    }

    protected override void OnParametersSet()
    {
        if (!UseProvidedData || !_loaded)
            return;

        ApplyProvidedData();
        Rebuild();
    }

    void ApplyProvidedData()
    {
        _playlists = Playlists?.ToList() ?? [];
        _subscriptions = Subscriptions?.ToList() ?? [];
        _history = History?.ToList() ?? [];
        _playQueue = PlayQueue;
    }

    async Task ReloadAsync()
    {
        _playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);

        if (IncludePlaylists)
        {
            _subscriptions = await MusicSubscriptions.GetForUserAsync(_userId);
            _playlists = _playlists
                .Where(p => !_subscriptions.Any(s =>
                    !string.IsNullOrEmpty(s.NavidromePlaylistId) && s.NavidromePlaylistId == p.Id))
                .ToList();
        }

        if (IncludeHistory)
            _history = await MusicLibrary.GetRecentlyPlayedAsync(_userId);

        if (IncludeResume)
        {
            try { _playQueue = await Navidrome.GetPlayQueueAsync(); }
            catch { _playQueue = null; }
        }
    }

    void Rebuild()
    {
        List<ShelfEntry> entries = [];

        if (IncludeResume && _playQueue is { Entry.Count: > 0 })
        {
            entries.Add(new ShelfEntry(
                "resume", ResumeItem(_playQueue), ShelfKind.Resume, null, null, null));
        }

        if (IncludePlaylists)
        {
            foreach (MusicSubscription subscription in _subscriptions)
            {
                entries.Add(new ShelfEntry(
                    $"subscription:{subscription.Id}", SubscriptionItem(subscription),
                    ShelfKind.Subscription, null, subscription, null));
            }

            foreach (SubsonicPlaylist playlist in _playlists)
            {
                entries.Add(new ShelfEntry(
                    $"playlist:{playlist.Id}", PlaylistItem(playlist),
                    ShelfKind.Playlist, playlist, null, null));
            }
        }

        if (IncludeHistory)
        {
            foreach (MusicPlayHistory history in _history)
            {
                entries.Add(new ShelfEntry(
                    $"history:{history.SongId}", HistoryItem(history),
                    ShelfKind.History, null, null, history));
            }
        }

        _entries.Clear();
        _entries.AddRange(entries.Take(Math.Max(0, Limit)));
    }

    MusicItem ResumeItem(SubsonicPlayQueue queue)
    {
        SubsonicSong current = queue.Entry.FirstOrDefault(s => s.Id == queue.Current) ?? queue.Entry[0];
        return new MusicItem
        {
            EntityType = MusicEntityType.Track,
            Title = current.Title,
            ArtistName = current.Artist,
            AlbumName = current.Album,
            ArtUrl = AlbumArt(current.Artist, current.Album, current.CoverArt)
        };
    }

    static MusicItem PlaylistItem(SubsonicPlaylist playlist) => new()
    {
        EntityType = MusicEntityType.Playlist,
        Title = playlist.Name,
        ArtistName = $"{playlist.SongCount} song{(playlist.SongCount == 1 ? "" : "s")}",
        TrackCount = playlist.SongCount,
        ArtUrl = !string.IsNullOrEmpty(playlist.CoverArt) ? NavidromeService.CoverArtUrl(playlist.CoverArt) : ""
    };

    static MusicItem SubscriptionItem(MusicSubscription subscription) => new()
    {
        EntityType = MusicEntityType.Playlist,
        Title = subscription.Name,
        ArtistName = $"{subscription.MatchCount}/{subscription.TrackCount} songs",
        TrackCount = subscription.TrackCount,
        ArtUrl = subscription.ArtUrl
    };

    MusicItem HistoryItem(MusicPlayHistory history) => new()
    {
        EntityType = MusicEntityType.Track,
        Title = history.Title,
        ArtistName = history.Artist,
        AlbumName = history.Album,
        ArtUrl = AlbumArt(history.Artist, history.Album, history.CoverArtUrl)
    };

    static string AlbumArt(string artist, string album, string coverArt) =>
        !string.IsNullOrEmpty(coverArt)
            ? NavidromeService.CoverArtUrl(coverArt)
            : MusicCatalogService.AlbumArtUrl(artist, album);

    async Task ResumeQueueAsync()
    {
        if (_playQueue is null || _playQueue.Entry.Count == 0)
            return;

        int index = Math.Max(0, _playQueue.Entry.FindIndex(s => s.Id == _playQueue.Current));
        List<QueueItem> queue = _playQueue.Entry.Select(s => new QueueItem(
            s.Id,
            s.Title,
            s.Artist,
            s.Artist,
            s.Album,
            !string.IsNullOrEmpty(s.CoverArt) ? NavidromeService.CoverArtUrl(s.CoverArt) : "",
            0,
            0,
            NavidromeService.PlayerStreamUrl(s.Id))).ToList();

        await PlayAsync(queue, index);
    }

    async Task PlayHistoryAsync(MusicPlayHistory history)
    {
        List<QueueItem> queue =
        [
            new(
                history.SongId,
                history.Title,
                history.Artist,
                history.Artist,
                history.Album,
                history.CoverArtUrl,
                0,
                0,
                NavidromeService.PlayerStreamUrl(history.SongId))
        ];

        await PlayAsync(queue, 0);
    }

    Task PlayPlaylistAsync(SubsonicPlaylist playlist) => PlayPlaylistByIdAsync(playlist.Id);

    async Task PlaySubscriptionAsync(MusicSubscription subscription)
    {
        string? playlistId = subscription.NavidromePlaylistId;
        if (string.IsNullOrEmpty(playlistId))
        {
            List<SubsonicPlaylist> playlists =
                await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
            playlistId = playlists.FirstOrDefault(p =>
                string.Equals(p.Name, subscription.Name, StringComparison.OrdinalIgnoreCase))?.Id;
        }

        if (!string.IsNullOrEmpty(playlistId))
            await PlayPlaylistByIdAsync(playlistId);
    }

    async Task PlayPlaylistByIdAsync(string playlistId)
    {
        SubsonicPlaylist? detail = await Navidrome.GetPlaylistAsync(playlistId);
        if (detail is null || detail.Tracks.Count == 0)
            return;

        List<QueueItem> queue = detail.Tracks.Select(s => new QueueItem(
            s.Id,
            s.Title,
            s.Artist,
            s.Artist,
            s.Album,
            !string.IsNullOrEmpty(s.CoverArt) ? NavidromeService.CoverArtUrl(s.CoverArt) : "",
            0,
            0,
            NavidromeService.PlayerStreamUrl(s.Id))).ToList();

        await PlayAsync(queue, 0);
    }

    async Task PlayAsync(List<QueueItem> queue, int index)
    {
        try
        {
            await JS.InvokeVoidAsync("stackarrMusic.play", queue, index);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not start music playback from the shelf");
        }
    }

    async Task OpenPlaylistAsync(SubsonicPlaylist playlist)
    {
        IDialogReference dialog = await Launcher.OpenLibraryPlaylistAsync(playlist);
        await dialog.Result;
        await NotifyChangedAsync();
    }

    async Task OpenSubscriptionAsync(MusicSubscription subscription)
    {
        IDialogReference dialog = await Launcher.OpenSubscriptionAsync(subscription);
        await dialog.Result;
        await NotifyChangedAsync();
    }

    async Task NotifyChangedAsync()
    {
        if (UseProvidedData)
        {
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
            return;
        }

        await ReloadAsync();
        Rebuild();
    }
}
