<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Leaf contract assembly for shared media concepts. It intentionally references no Arrk
    project and no third-party package so every feature abstraction (TV, music, downloads) can
    depend on it without pulling in the kernel or an implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
