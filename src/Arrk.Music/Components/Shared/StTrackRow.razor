@* Reusable music track / playlist / release row. *@

<div class="st-music-track @(Hoverable ? "st-music-track--hover" : "") @(Missing ? "st-music-track--missing" : "") @Class">
    @if (Number is > 0)
    {
        <span class="st-music-track-num">@Number</span>
    }
    @if (OnTitleClick.HasDelegate)
    {
        <button type="button" class="st-music-track-title st-music-track-title--btn" title="@Title" @onclick="OnTitleClick">@Title</button>
    }
    else
    {
        <span class="st-music-track-title" title="@Title">@Title</span>
    }
    @if (!string.IsNullOrEmpty(Meta))
    {
        <span class="st-music-track-duration" title="@Meta">@Meta</span>
    }
    @if (Actions is not null)
    {
        @Actions
    }
</div>

@code {
    [Parameter] public int? Number { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Meta { get; set; } = "";
    [Parameter] public bool Hoverable { get; set; } = true;
    [Parameter] public bool Missing { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnTitleClick { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
