@* Add a song to one of your playlists, invokable from anywhere in the music library.
   Subscribed playlists are read-only projections of an external (Deezer) playlist, so they are
   not offered here: only playlists you own can be edited. *@
@using Arrk.Navidrome
@using Arrk.Navidrome.Models
@inject NavidromeService Navidrome
@inject MusicLibraryService MusicLibrary
@inject MusicSubscriptionService Subscriptions
@inject ISnackbar Snackbar

<MudDialog Class="st-media-dialog">
    <DialogContent>
        <DialogCloseButton Class="st-dialog-close--floating" />
        <div class="st-detail-body" style="padding-top:8px;">
            <MudText Typo="Typo.h6" Class="mb-1">Add to playlist</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--st-text-secondary);">@Title</MudText>

            @if (_playlists.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.QueueMusic" Message="No playlists yet — create one on the Playlists tab." />
            }
            else
            {
                <div class="st-music-tracklist">
                    @foreach (SubsonicPlaylist playlist in _playlists)
                    {
                        <StTrackRow Title="@playlist.Name" Meta="@($"{playlist.SongCount} song{(playlist.SongCount == 1 ? "" : "s")}")">
                            <Actions>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" title="Add" AriaLabel="Add" OnClick="() => AddAsync(playlist)" />
                            </Actions>
                        </StTrackRow>
                    }
                </div>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SongTitle { get; set; } = "";
    [Parameter] public string SongArtist { get; set; } = "";

    List<SubsonicPlaylist> _playlists = [];
    int _userId;
    bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            ClaimsPrincipal user = (await AuthStateTask).User;
            _isAdmin = user.IsInRole(ArrkRoles.Admin);
            int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _userId);
        }
        // A subscription is surfaced as its own tile and is synced from its source; adding a song to
        // its Navidrome projection would be silently overwritten on the next sync, so exclude them.
        List<MusicSubscription> subscriptions = await Subscriptions.GetForUserAsync(_userId);
        List<SubsonicPlaylist> playlists = await MusicLibrary.GetPlaylistsForUserAsync(_userId, _isAdmin);
        _playlists = MusicSubscriptionService.ExcludeSubscribed(playlists, subscriptions);
    }

    async Task AddAsync(SubsonicPlaylist playlist)
    {
        try
        {
            string? id = await Navidrome.FindSongIdAsync(SongTitle, SongArtist);
            if (string.IsNullOrEmpty(id))
            {
                Snackbar.Add($"\"{SongTitle}\" isn't in Navidrome yet.", Severity.Info);
                return;
            }
            await Navidrome.AddToPlaylistAsync(playlist.Id, [id]);
            Snackbar.Add($"Added to {playlist.Name}.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Could not add: {ex.Message}", Severity.Error); }
    }
}
