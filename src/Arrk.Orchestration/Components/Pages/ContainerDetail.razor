@page "/docker/container/{Id}"
@attribute [Authorize(Policy = ArrkPolicies.AdminOnly)]
@inject ResourceInventory Inventory
@inject ServiceProvisioner Provisioner
@inject DockerMetricsCollector MetricsCollector
@inject LiveActivityRegistry LiveActivity
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Arrk - Container @_container?.Name</PageTitle>

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/docker" Class="mb-4"
           title="Back to Docker" AriaLabel="Back to Docker">
    <span class="st-btn-label">Back to Docker</span>
</MudButton>

@if (_loading)
{
    <LoadingView />
}
else if (_container == null)
{
    <MudAlert Severity="Severity.Error">Container not found.</MudAlert>
}
else
{
    <PageHeader Title="@_container.Name">
        <StatusDot>
            <div class="status-dot status-dot--lg @CssClassHelper.GetContainerDotClass(_container.State)"></div>
        </StatusDot>
        <Actions>
            @if (_container.State != ContainerState.Running)
            {
                <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Variant="Variant.Filled"
                           OnClick="StartContainer" title="Start" AriaLabel="Start">
                    <span class="st-btn-label">Start</span>
                </MudButton>
            }
            else
            {
                <MudButton StartIcon="@Icons.Material.Filled.Stop" Color="Color.Default" Variant="Variant.Outlined"
                           OnClick="StopContainer" title="Stop" AriaLabel="Stop">
                    <span class="st-btn-label">Stop</span>
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Default" Variant="Variant.Outlined"
                           OnClick="RestartContainer" title="Restart" AriaLabel="Restart">
                    <span class="st-btn-label">Restart</span>
                </MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_containerMetrics != null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="6" sm="3">
                <div class="st-stat-card">
                    <div class="st-stat-label"><MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" /> CPU</div>
                    <div class="st-stat-value st-stat-value--pink" style="font-size:1.4rem;">@(_containerMetrics.CpuPercent.ToString("F1"))%</div>
                    <UsageBar Label="" Percent="_containerMetrics.CpuPercent" Text="" />
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="st-stat-card">
                    <div class="st-stat-label"><MudIcon Icon="@Icons.Material.Filled.SdStorage" Size="Size.Small" /> Memory</div>
                    <div class="st-stat-value st-stat-value--purple" style="font-size:1.4rem;">@(_containerMetrics.MemoryPercent.ToString("F1"))%</div>
                    <UsageBar Label="" Percent="_containerMetrics.MemoryPercent" Text="" />
                    <div class="st-stat-sub" style="font-family:var(--st-font-mono);">@FormatHelper.FormatBytes(_containerMetrics.MemoryUsageBytes) / @FormatHelper.FormatBytes(_containerMetrics.MemoryLimitBytes)</div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="st-stat-card">
                    <div class="st-stat-label"><MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" /> Network RX</div>
                    <div class="st-stat-value st-stat-value--blue" style="font-size:1.4rem;">@FormatHelper.FormatBytes(_containerMetrics.NetworkRxBytes)</div>
                    <div class="st-stat-sub" style="font-family:var(--st-font-mono);">@FormatHelper.FormatRate(_containerMetrics.NetworkRxRateBytesPerSec)</div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="st-stat-card">
                    <div class="st-stat-label"><MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" /> Network TX</div>
                    <div class="st-stat-value st-stat-value--blue" style="font-size:1.4rem;">@FormatHelper.FormatBytes(_containerMetrics.NetworkTxBytes)</div>
                    <div class="st-stat-sub" style="font-family:var(--st-font-mono);">@FormatHelper.FormatRate(_containerMetrics.NetworkTxRateBytesPerSec)</div>
                </div>
            </MudItem>
        </MudGrid>
    }

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <SectionContainer Icon="@Icons.Material.Filled.Info" Title="Container Info">
                <div class="st-info-grid">
                    <InfoGridRow Label="ID" Break="true">@_container.Id</InfoGridRow>
                    <InfoGridRow Label="Image">@_container.Image</InfoGridRow>
                    <InfoGridRow Label="State" Monospace="false">@_container.State</InfoGridRow>
                    <InfoGridRow Label="Status" Monospace="false">@_container.Status</InfoGridRow>
                    <InfoGridRow Label="Created">@_container.CreatedAt.ToLocalTime().ToString("g")</InfoGridRow>
                </div>
            </SectionContainer>
        </MudItem>
        @if (_container.Labels.Count > 0)
        {
            <MudItem xs="12" sm="6">
                <SectionContainer Icon="@Icons.Material.Filled.Label" Title="Labels" BodyClass="st-section-body--scroll" BodyStyle="padding:0;">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>Key</th><th>Value</th></tr></thead>
                        <tbody>
                        @foreach (KeyValuePair<string, string> label in _container.Labels)
                        {
                            <tr>
                                <td><code class="st-info-value">@label.Key</code></td>
                                <td><code class="st-info-value">@label.Value</code></td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                </SectionContainer>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Class="mb-4">
        @if (_container.Ports.Count > 0)
        {
            <MudItem xs="12" sm="6">
                <SectionContainer Icon="@Icons.Material.Filled.Router" Title="Ports">
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        @foreach (string port in _container.Ports)
                        {
                            <StChip Variant="info">@port</StChip>
                        }
                    </div>
                </SectionContainer>
            </MudItem>
        }
        @if (_container.Networks.Count > 0)
        {
            <MudItem xs="12" sm="6">
                <SectionContainer Icon="@Icons.Material.Filled.Lan" Title="Networks">
                    <div style="display:flex;flex-wrap:wrap;gap:var(--st-space-sm);">
                        @foreach (string net in _container.Networks)
                        {
                            @if (_networkNameToId.TryGetValue(net, out string? netId))
                            {
                                <MudLink Href="@($"/docker/network/{netId}")" Typo="Typo.body2"><EntityIcon EntityType="network" /> @net</MudLink>
                            }
                            else
                            {
                                <StChip Variant="neutral">@net</StChip>
                            }
                        }
                    </div>
                </SectionContainer>
            </MudItem>
        }
    </MudGrid>

    @if (_mounts.Count > 0)
    {
        <SectionContainer Icon="@Icons.Material.Filled.Folder" Title="Volumes" Class="mb-4" BodyClass="st-section-body--scroll" BodyStyle="padding:0;">
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Type</th><th>Source</th><th>Destination</th><th>Mode</th></tr></thead>
                <tbody>
                    @foreach (DockerDotNet.Models.MountPoint mount in _mounts)
                    {
                        <tr>
                            <td><StChip Variant="neutral">@mount.Type</StChip></td>
                            <td style="word-break:break-all">
                                @if (mount.Type == "volume" && !string.IsNullOrEmpty(mount.Name))
                                {
                                    <MudLink Href="@($"/docker/volume/{Uri.EscapeDataString(mount.Name)}")" Typo="Typo.body2"><EntityIcon EntityType="volume" /> @mount.Name</MudLink>
                                }
                                else if (!string.IsNullOrEmpty(mount.Source))
                                {
                                    <MudLink Href="@($"/docker/volume/{Uri.EscapeDataString(mount.Source)}")" Typo="Typo.body2"><EntityIcon EntityType="volume" /> @mount.Source</MudLink>
                                }
                            </td>
                            <td style="word-break:break-all;font-family:var(--st-font-mono);font-size:0.9375rem;">@mount.Destination</td>
                            <td>@(mount.Mode ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </SectionContainer>
    }

    <SectionContainer Icon="@Icons.Material.Filled.Article" Title="Logs" BodyStyle="padding:0;">
        <HeaderRight>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-2 st-hide-mobile">(last @DockerUiConstants.DefaultLogTailLines lines)</MudText>
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadLogs"
                       title="Refresh logs" AriaLabel="Refresh logs">
                <span class="st-btn-label">Refresh</span>
            </MudButton>
        </HeaderRight>
        <ChildContent>
            <div class="st-container-logs">
                @if (_logsLoading)
                {
                    <LoadingView Size="Size.Small" />
                }
                else
                {
                    <pre class="st-container-log-pre">@_logs</pre>
                }
            </div>
        </ChildContent>
    </SectionContainer>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    ContainerInfo? _container;
    ContainerMetrics? _containerMetrics;
    string _logs = "";
    bool _loading = true;
    bool _logsLoading = true;
    Timer? _refreshTimer;
    CancellationTokenSource? _cts;
    Dictionary<string, string> _networkNameToId = new(StringComparer.OrdinalIgnoreCase);
    List<DockerDotNet.Models.MountPoint> _mounts = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadContainer();
        await LoadLogs();
        await LoadMetrics();

        (Timer Timer, CancellationTokenSource Cts) result = AsyncTimerHelper.Create(
            async ct =>
            {
                await LoadContainer();
                await LoadLogs();
                await LoadMetrics();
            },
            TimeSpan.FromSeconds(DockerUiConstants.ContainerDetailInitialDelaySeconds),
            TimeSpan.FromSeconds(DockerUiConstants.ContainerDetailRefreshSeconds));
        _refreshTimer = result.Timer;
        _cts = result.Cts;
    }

    async Task LoadContainer()
    {
        try
        {
            List<ContainerInfo> containers = await Inventory.GetOwnedContainers();
            _container = containers.FirstOrDefault(c => c.Id == Id || c.Id.StartsWith(Id, StringComparison.OrdinalIgnoreCase));
            if (_container != null)
            {
                await Provisioner.GetContainerStatus(_container.Name);
                if (_container.Networks.Count > 0)
                {
                    List<DockerDotNet.Models.NetworkResponse> networks = await Inventory.GetAllNetworks();
                    _networkNameToId = networks.Where(n => n.Name != null).ToDictionary(n => n.Name!, n => n.ID, StringComparer.OrdinalIgnoreCase);
                }
            }
        }
        catch { }
        _loading = false;
    }

    async Task LoadMetrics()
    {
        if (_container == null)
        {
            return;
        }

        try
        {
            _containerMetrics = await MetricsCollector.GetContainerStats(_container.Id);
        }
        catch { }
    }
    async Task LoadLogs()
    {
        if (_container == null)
        {
            return;
        }

        _logsLoading = true;
        try
        {
            _logs = await Provisioner.GetContainerLogs(_container.Name, tail: DockerUiConstants.DefaultLogTailLines);
        }
        catch (Exception ex)
        {
            _logs = $"Failed to load logs: {ex.Message}";
        }

        _logsLoading = false;
    }

    async Task StartContainer()
    {
        if (_container == null)
        {
            return;
        }

        await ContainerActionHelper.StartContainer(_container.Id, _container.Name, LiveActivity, LoadContainer);
    }

    async Task StopContainer()
    {
        if (_container == null)
        {
            return;
        }

        await ContainerActionHelper.StopContainer(_container.Id, _container.Name, LiveActivity, LoadContainer);
    }

    async Task RestartContainer()
    {
        if (_container == null)
        {
            return;
        }

        await ContainerActionHelper.RestartContainer(_container.Id, _container.Name, LiveActivity, LoadContainer);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _refreshTimer?.Dispose();
    }
}
