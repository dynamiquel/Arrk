@inject DockerEventMonitor EventMonitor
@implements IDisposable

<div class="st-card mb-4" style="overflow:hidden;">
    <div class="st-section-header" style="cursor:pointer;" @onclick="ToggleExpanded">
        <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Size="Size.Small" Color="Color.Primary" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Events</MudText>
        @if (_activePulls.Count > 0 || _liveContainerEvents.Count > 0)
        {
            <StChip Variant="info">@(_activePulls.Count + _liveContainerEvents.Count) active</StChip>
        }
        <div style="margin-left:auto;">
            <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
        </div>
    </div>

    @if (_expanded)
    {
        <div style="padding:var(--st-space-lg);">

            @* Active Image Pulls (pinned, live only) *@
            @if (_activePulls.Count > 0)
            {
                <div class="st-events-group mb-3">
                    <div class="st-events-group-header" style="cursor:pointer;" @onclick="() => _pullsExpanded = !_pullsExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.body2" Style="font-weight:600;">Image Pulls (@_activePulls.Count)</MudText>
                        <div style="margin-left:auto;">
                            <MudIcon Icon="@(_pullsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                        </div>
                    </div>
                    @if (_pullsExpanded)
                    {
                        <div class="st-events-group-body">
                            @foreach (ImagePullState pull in _activePulls.Values.OrderByDescending(p => p.StartedAt))
                            {
                                <div class="st-pull-card">
                                    <div style="display:flex;align-items:center;gap:var(--st-space-sm);margin-bottom:var(--st-space-xs);">
                                        <EntityIcon EntityType="image" />
                                        <span style="font-weight:500;font-size:0.9375rem;">@pull.ImageName</span>
                                        @if (pull.IsError)
                                        {
                                            <StChip Variant="error">Error</StChip>
                                        }
                                        else if (pull.IsCompleted)
                                        {
                                            <StChip Variant="success">Done</StChip>
                                        }
                                        else
                                        {
                                            <span style="font-size:0.8125rem;color:var(--st-text-muted);margin-left:auto;">@pull.OverallPercent.ToString("F0")%</span>
                                        }
                                    </div>
                                    @if (!pull.IsCompleted && !pull.IsError)
                                    {
                                        <MudProgressLinear Value="@pull.OverallPercent" Color="Color.Info" Class="mb-1" />
                                    }
                                    else if (pull.IsError)
                                    {
                                        <div style="font-size:0.8125rem;color:var(--st-red);">@pull.ErrorMessage</div>
                                    }
                                    @if (pull.Layers.Count > 0)
                                    {
                                        <div style="font-size:0.75rem;color:var(--st-text-muted);">@pull.Layers.Count layers</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Live Container Events (pinned, live only, auto disappear) *@
            @if (_liveContainerEvents.Count > 0)
            {
                <div class="st-events-group mb-3">
                    <div class="st-events-group-header" style="cursor:pointer;" @onclick="() => _liveExpanded = !_liveExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Style="font-weight:600;">Live (@_liveContainerEvents.Count)</MudText>
                        <div style="margin-left:auto;">
                            <MudIcon Icon="@(_liveExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                        </div>
                    </div>
                    @if (_liveExpanded)
                    {
                        <div class="st-events-group-body">
                            @foreach (LiveContainerEvent kv in _liveContainerEvents.Values.OrderByDescending(e => e.StartedAt))
                            {
                                <div class="st-event-row">
                                    <div class="status-dot status-dot--sm @GetLiveDotClass(kv.Event.Category)"></div>
                                    <StChip Variant="@GetEventChipVariant(kv.Event.Category)">@kv.Event.Action</StChip>
                                    <span class="st-event-name">@kv.ContainerName</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Live Event Log (collapsible, with filters) *@
            <div class="st-events-group">
                <div class="st-events-group-header" style="cursor:pointer;" @onclick="() => _logExpanded = !_logExpanded">
                    <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2" Style="font-weight:600;">History</MudText>
                    <div style="margin-left:auto;display:flex;align-items:center;gap:var(--st-space-xs);">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterList" Size="Size.Small"
                            OnClick="@((e) => _filtersVisible = !_filtersVisible)" StopPropagation="true" />
                        <MudIcon Icon="@(_logExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                    </div>
                </div>

                @if (_filtersVisible && _logExpanded)
                {
                    <div class="st-filter-bar">
                        @foreach (EventFilter filter in _filters)
                        {
                            <MudSwitch T="bool" Value="@filter.Enabled" ValueChanged="@((bool v) => ToggleFilter(filter, v))"
                                Label="@filter.Label" Color="Color.Primary" Size="Size.Small"
                                LabelPlacement="Placement.Start" />
                        }
                    </div>
                }

                @if (_logExpanded)
                {
                    <div class="st-events-group-body st-scroll-y" style="max-height:300px;">
                        @{
                            List<DockerEvent> filtered = _recentEvents.Where(e => IsEventVisible(e)).Take(100).ToList();
                        }
                        @if (filtered.Count == 0)
                        {
                            <div style="font-size:0.9375rem;color:var(--st-text-muted);padding:var(--st-space-sm);">No events.</div>
                        }
                        @foreach (DockerEvent evt in filtered)
                        {
                            <div class="st-event-row">
                                <span class="st-event-time">@evt.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                <StChip Variant="@GetEventChipVariant(evt.Category)">@evt.Type/@evt.Action</StChip>
                                @if (!string.IsNullOrEmpty(evt.ActorName))
                                {
                                    <span class="st-event-name">@evt.ActorName</span>
                                }
                                else if (!string.IsNullOrEmpty(evt.ActorId))
                                {
                                    <span class="st-event-name" style="font-family:var(--st-font-mono);font-size:0.8125rem;">@evt.ActorId[..Math.Min(12, evt.ActorId.Length)]</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    }
</div>

<style>
    .st-events-group { border: 1px solid var(--st-border); border-radius: var(--st-radius-sm); overflow: hidden; }
    .st-events-group-header { display: flex; align-items: center; gap: var(--st-space-sm); padding: var(--st-space-sm) var(--st-space-md); background: var(--st-bg-elevated); }
    .st-events-group-body { padding: var(--st-space-sm); }
    .st-pull-card { padding: var(--st-space-sm) var(--st-space-md); border: 1px solid var(--st-border); border-radius: var(--st-radius-sm); margin-bottom: var(--st-space-xs); background: var(--st-bg-surface); }
    .st-event-row { display: flex; align-items: center; gap: var(--st-space-sm); padding: 3px var(--st-space-sm); font-size: 0.8125rem; }
    .st-event-row:hover { background: var(--st-bg-elevated); }
    .st-event-time { font-family: var(--st-font-mono); font-size: 0.75rem; color: var(--st-text-muted); min-width: 65px; }
    .st-event-name { color: var(--st-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .st-filter-bar { display: flex; flex-wrap: wrap; gap: var(--st-space-sm) var(--st-space-lg); padding: var(--st-space-sm) var(--st-space-md); border-bottom: 1px solid var(--st-border); background: var(--st-bg-surface); }
</style>

@code {
    bool _expanded = true;
    bool _pullsExpanded = true;
    bool _liveExpanded = true;
    bool _logExpanded = false;
    bool _filtersVisible = false;
    List<DockerEvent> _recentEvents = new();
    Dictionary<string, ImagePullState> _activePulls = new(StringComparer.OrdinalIgnoreCase);
    Dictionary<string, LiveContainerEvent> _liveContainerEvents = new(StringComparer.OrdinalIgnoreCase);
    Timer? _refreshTimer;

    List<EventFilter> _filters = new()
    {
        new() { Key = "container", Label = "Container", Enabled = true, Categories = new[] { DockerEventCategory.ContainerStart, DockerEventCategory.ContainerStop, DockerEventCategory.ContainerDie, DockerEventCategory.ContainerCreate, DockerEventCategory.ContainerDestroy } },
        new() { Key = "image", Label = "Image", Enabled = true, Categories = new[] { DockerEventCategory.ImagePull, DockerEventCategory.ImagePush, DockerEventCategory.ImageDelete } },
        new() { Key = "network", Label = "Network", Enabled = true, Categories = new[] { DockerEventCategory.NetworkCreate, DockerEventCategory.NetworkConnect, DockerEventCategory.NetworkDisconnect, DockerEventCategory.NetworkDestroy } },
        new() { Key = "health", Label = "Health", Enabled = false, Categories = Array.Empty<DockerEventCategory>() },
        new() { Key = "other", Label = "Other", Enabled = false, Categories = new[] { DockerEventCategory.Other } },
    };

    protected override void OnInitialized()
    {
        EventMonitor.EventReceived += OnEventReceived;
        EventMonitor.PullProgressUpdated += OnPullProgressUpdated;
        EventMonitor.LiveEventsChanged += OnLiveEventsChanged;

        _refreshTimer = new(_ =>
        {
            try
            {
                InvokeAsync(StateHasChanged);
            }
            catch
            {
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
    }

    void OnEventReceived(DockerEvent evt)
    {
        _recentEvents = EventMonitor.RecentEvents.ToList();
        try
        {
            InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    void OnPullProgressUpdated(ImagePullState state)
    {
        _activePulls = EventMonitor.ActivePulls.ToDictionary(kvp => kvp.Key, kvp => kvp.Value, StringComparer.OrdinalIgnoreCase);
        try
        {
            InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    void OnLiveEventsChanged()
    {
        _liveContainerEvents = EventMonitor.LiveContainerEvents.ToDictionary(kvp => kvp.Key, kvp => kvp.Value, StringComparer.OrdinalIgnoreCase);
        try
        {
            InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    void ToggleExpanded() => _expanded = !_expanded;

    void ToggleFilter(EventFilter filter, bool enabled)
    {
        filter.Enabled = enabled;
        StateHasChanged();
    }

    bool IsEventVisible(DockerEvent evt)
    {
        if (evt.Category == DockerEventCategory.Other)
        {
            if (evt.Action.Contains("healthcheck", StringComparison.OrdinalIgnoreCase) ||
                evt.Action.Contains("health_status", StringComparison.OrdinalIgnoreCase))
            {
                return _filters.First(f => f.Key == "health").Enabled;
            }

            return _filters.First(f => f.Key == "other").Enabled;
        }

        EventFilter filter = _filters.FirstOrDefault(f => f.Categories.Contains(evt.Category));
        return filter?.Enabled ?? true;
    }

    static string GetEventChipVariant(DockerEventCategory category) => category switch
    {
        DockerEventCategory.ImagePull => "info",
        DockerEventCategory.ContainerStart => "success",
        DockerEventCategory.ContainerStop => "error",
        DockerEventCategory.ContainerDie => "warning",
        DockerEventCategory.ContainerCreate => "info",
        DockerEventCategory.ContainerDestroy => "error",
        DockerEventCategory.NetworkCreate or DockerEventCategory.NetworkConnect => "neutral",
        _ => "neutral"
    };

    static string GetLiveDotClass(DockerEventCategory category) => category switch
    {
        DockerEventCategory.ContainerStart => "status-dot--starting",
        DockerEventCategory.ContainerStop => "status-dot--stopped",
        DockerEventCategory.ContainerDie => "status-dot--stopped",
        _ => "status-dot--unknown"
    };

    public void Dispose()
    {
        EventMonitor.EventReceived -= OnEventReceived;
        EventMonitor.PullProgressUpdated -= OnPullProgressUpdated;
        EventMonitor.LiveEventsChanged -= OnLiveEventsChanged;
        _refreshTimer?.Dispose();
    }

    class EventFilter
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public bool Enabled { get; set; }
        public DockerEventCategory[] Categories { get; set; } = [];
    }
}
