@page "/docker/network/{Id}"
@attribute [Authorize(Policy = StackarrPolicies.AdminOnly)]
@inject ResourceInventory Inventory
@inject NavigationManager Nav

<PageTitle>Stackarr - Network @_network?.Name</PageTitle>

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/docker" Class="mb-4"
           title="Back to Docker" AriaLabel="Back to Docker">
    <span class="st-btn-label">Back to Docker</span>
</MudButton>

@if (_loading)
{
    <LoadingView />
}
else if (_network == null)
{
    <MudAlert Severity="Severity.Error">Network not found.</MudAlert>
}
else
{
    <PageHeader Icon="@Icons.Material.Filled.Lan" Title="@_network.Name" />

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <SectionContainer Icon="@Icons.Material.Filled.Info" Title="Network Info">
                <div class="st-info-grid">
                    <InfoGridRow Label="ID" Break="true">@_network.ID</InfoGridRow>
                    <InfoGridRow Label="Driver">@_network.Driver</InfoGridRow>
                    <InfoGridRow Label="Scope">@_network.Scope</InfoGridRow>
                    <InfoGridRow Label="Created" Monospace="false">@_network.Created.ToLocalTime().ToString("g")</InfoGridRow>
                    <InfoGridRow Label="Managed" Monospace="false">@(IsManaged ? "Yes" : "No")</InfoGridRow>
                </div>
            </SectionContainer>
        </MudItem>
        <MudItem xs="12" sm="6">
            <SectionContainer Icon="@Icons.Material.Filled.Settings" Title="Actions">
                @if (IsManaged)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                        OnClick="DeleteNetwork" title="Remove network" AriaLabel="Remove network">
                        <span class="st-btn-label">Remove Network</span>
                    </MudButton>
                }
                else
                {
                    <div style="font-size:0.9375rem;color:var(--st-text-secondary);">External network — cannot remove</div>
                }
            </SectionContainer>
        </MudItem>
    </MudGrid>

    @if (_network.Labels?.Count > 0)
    {
        <SectionContainer Icon="@Icons.Material.Filled.Label" Title="Labels" Class="mb-4" BodyStyle="padding:0;">
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Key</th><th>Value</th></tr></thead>
                <tbody>
                    @foreach (KeyValuePair<string, string> label in _network.Labels)
                    {
                        <tr>
                            <td><code class="st-info-value">@label.Key</code></td>
                            <td><code class="st-info-value">@label.Value</code></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </SectionContainer>
    }

    <SectionContainer Icon="@Icons.Material.Filled.ViewModule"
        Title="@($"Connected Containers ({_network.Containers?.Count ?? 0})")" BodyStyle="padding:0;">
        @if (_network.Containers?.Count > 0)
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Container ID</th></tr></thead>
                <tbody>
                    @foreach (string containerId in _network.Containers.Keys)
                    {
                        <tr><td class="st-info-value"><EntityIcon EntityType="container" /> @containerId[..Math.Min(DockerUiConstants.ContainerIdDisplayLength, containerId.Length)]</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <EmptyState Message="No containers connected." />
        }
    </SectionContainer>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    DockerDotNet.Models.NetworkResponse? _network;
    bool _loading = true;

    bool IsManaged => CssClassHelper.IsManagedNetwork(_network?.Labels, _network?.Name);

    protected override async Task OnInitializedAsync()
    {
        _network = await Inventory.GetNetworkById(Id);
        _loading = false;
    }

    async Task DeleteNetwork()
    {
        if (_network == null)
        {
            return;
        }
        using DockerDotNet.DockerClient client = DockerClientFactory.Create();
        NetworkManager manager = new(client);
        await manager.DeleteNetwork(_network.ID);
        Nav.NavigateTo("/docker");
    }
}
