<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Orchestration owns provisioning, config sync, health, metrics and the operational UI (Razor
    class library): the Docker pages and container components, the Containers list and the Scheduler.
    The UI is contributed to the shell through the Stackarr.Ui contracts.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Stackarr.Core\Stackarr.Core.csproj" />
    <ProjectReference Include="..\Stackarr.Ui\Stackarr.Ui.csproj" />
    <ProjectReference Include="..\Stackarr.Configuration\Stackarr.Configuration.csproj" />
    <ProjectReference Include="..\Stackarr.Docker\Stackarr.Docker.csproj" />
    <ProjectReference Include="..\Stackarr.Ai\Stackarr.Ai.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CronExpressionDescriptor" Version="2.51.0" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
