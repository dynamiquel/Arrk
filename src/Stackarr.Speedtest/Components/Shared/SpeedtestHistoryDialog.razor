@using Microsoft.EntityFrameworkCore
@using MudBlazor.Charts
@using Stackarr.Core
@using Stackarr.Core.Models

<MudDialog>
    <TitleContent>
        <StDialogTitle Icon="@Icons.Material.Filled.Speed" Title="Speedtest History" />
    </TitleContent>
    <DialogContent>
        <DialogCloseButton Class="st-dialog-close--floating" />
        @if (_loading)
        {
            <LoadingView />
        }
        else if (_results.Count == 0)
        {
            <EmptyState Message="No speed test results yet." Icon="@Icons.Material.Filled.Speed" />
        }
        else
        {
            <StTabs T="string" Items="_viewTabs"
                    Value="_selectedView" ValueChanged="OnViewChanged" />

            @if (_selectedView == "chart")
            {
                <StTabs T="string" Items="_rangeTabs"
                        Value="_selectedRange" ValueChanged="OnRangeChanged" />
            }

            @if (_selectedView == "table")
            {
                <MudDataGrid T="SpeedtestResult" Items="_results" Hover="true" Dense="true" Striped="true" FixedHeader="true" Height="400px">
                    <Columns>
                        <TemplateColumn Title="Time">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.TestedAt.ToLocalTime().ToString("MMM dd, HH:mm")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Download">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="color:var(--st-green);font-weight:600;">@FormatMBs(context.Item.DownloadMbps)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Upload">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="color:var(--st-blue);font-weight:600;">@FormatMBs(context.Item.UploadMbps)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Ping">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="color:var(--st-purple);">@context.Item.PingMs.ToString("F0") ms</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Jitter">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.JitterMs.ToString("F1") ms</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                @if (context.Item.ErrorMessage is not null)
                                {
                                    <MudTooltip Text="@context.Item.ErrorMessage">
                                        <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            }
            else
            {
                <div style="height:400px;">
                    <MudChart T="double" ChartType="ChartType.Line"
                              ChartOptions="@_chartOptions"
                              ChartLabels="@_chartLabels"
                              ChartSeries="@_chartSeries"
                              LegendPalette="@_chartPalette"
                              Width="100%"
                              Height="100%" />
                </div>
            }
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Result target to show: "network" (default) or "vpn".</summary>
    [Parameter] public string Target { get; set; } = "network";

    List<SpeedtestResult> _results = [];
    bool _loading = true;
    string _selectedView = "table";
    string _selectedRange = "24h";

    static readonly StTabItem<string>[] _viewTabs =
    [
        new("table", "Table", Icons.Material.Filled.TableChart),
        new("chart", "Chart", Icons.Material.Filled.ShowChart)
    ];

    static readonly StTabItem<string>[] _rangeTabs =
    [
        new("24h", "24h"),
        new("7d", "7d"),
        new("30d", "30d")
    ];

    List<ChartSeries<double>> _chartSeries = [];
    string[] _chartLabels = [];
    LineChartOptions _chartOptions = new();

    static readonly string[] _chartPalette = ["#4ade80", "#818cf8", "#c084fc"];

    protected override async Task OnInitializedAsync()
    {
        _chartOptions = new LineChartOptions
        {
            YAxisTitle = "MB/s",
            YAxisToStringFunc = v => v.ToString("F1"),
            LineStrokeWidth = 2,
            ShowDataMarkers = true,
            ChartPalette = _chartPalette
        };

        await LoadResults();
        _loading = false;
    }

    async Task LoadResults()
    {
        try
        {
            IDbContextFactory<StackarrDbContext> dbContextFactory =
                ScopedServiceProvider.GetRequiredService<IDbContextFactory<StackarrDbContext>>();

            DateTime cutoff = _selectedRange switch
            {
                "24h" => DateTime.UtcNow.AddHours(-24),
                "7d" => DateTime.UtcNow.AddDays(-7),
                "30d" => DateTime.UtcNow.AddDays(-30),
                _ => DateTime.UtcNow.AddHours(-24)
            };

            int limit = _selectedRange switch
            {
                "24h" => 48,
                "7d" => 336,
                "30d" => 1440,
                _ => 48
            };

            await using StackarrDbContext db = await dbContextFactory.CreateDbContextAsync();
            _results = await db.SpeedtestResults
                .Where(x => x.Target == Target && x.ErrorMessage == null && x.TestedAt >= cutoff)
                .OrderBy(x => x.TestedAt)
                .Take(limit)
                .ToListAsync();

            BuildChartData();
        }
        catch { }
    }

    void BuildChartData()
    {
        if (_results.Count == 0) return;

        bool showDate = _selectedRange is "7d" or "30d";

        _chartLabels = _results
            .Select(r => r.TestedAt.ToLocalTime().ToString(showDate ? "MMM dd, HH:mm" : "HH:mm"))
            .ToArray();

        _chartSeries =
        [
            new ChartSeries<double>
            {
                Name = "Download",
                Data = _results.Select(r => Math.Round(r.DownloadMbps / 8.0, 1)).ToArray()
            },
            new ChartSeries<double>
            {
                Name = "Upload",
                Data = _results.Select(r => Math.Round(r.UploadMbps / 8.0, 1)).ToArray()
            },
            new ChartSeries<double>
            {
                Name = "Ping",
                Data = _results.Select(r => Math.Round(r.PingMs)).ToArray()
            }
        ];
    }

    async Task OnViewChanged(string value)
    {
        _selectedView = value;
        StateHasChanged();
    }

    async Task OnRangeChanged(string value)
    {
        _selectedRange = value;
        _loading = true;
        StateHasChanged();

        await LoadResults();
        _loading = false;
        StateHasChanged();
    }

    static string FormatMBs(double megabitsPerSecond)
    {
        double megabytesPerSecond = megabitsPerSecond / 8.0;
        return $"{megabytesPerSecond:F1} MB/s";
    }

    [Inject]
    IServiceProvider ScopedServiceProvider { get; set; } = default!;
}
