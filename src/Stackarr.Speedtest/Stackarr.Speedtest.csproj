<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The speedtest module owns its dashboard tiles (Razor class library): the network/VPN speed
    tiles and their history dialog, contributed to the shell's dashboard through the Stackarr.Ui
    contracts.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Stackarr.Core\Stackarr.Core.csproj" />
    <ProjectReference Include="..\Stackarr.Ui\Stackarr.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
