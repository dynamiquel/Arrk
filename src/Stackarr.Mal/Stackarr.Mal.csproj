<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- MyAnimeList is a specific integration, not a generic anime abstraction. The module owns its
       OAuth flow, list cache, watch-progress sync and the Plan to Watch watchlist contribution. -->
  <ItemGroup>
    <ProjectReference Include="..\Stackarr.Core\Stackarr.Core.csproj" />
    <ProjectReference Include="..\Stackarr.Ui\Stackarr.Ui.csproj" />
    <ProjectReference Include="..\Stackarr.Tvarr\Stackarr.Tvarr.csproj" />
    <ProjectReference Include="..\Stackarr.Ai\Stackarr.Ai.csproj" />
    <ProjectReference Include="..\Stackarr.Media.Abstractions\Stackarr.Media.Abstractions.csproj" />
    <ProjectReference Include="..\Stackarr.Tv.Abstractions\Stackarr.Tv.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stackarr.Mal.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Stackarr.Media.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Stackarr.Tv.Abstractions" />
  </ItemGroup>
</Project>