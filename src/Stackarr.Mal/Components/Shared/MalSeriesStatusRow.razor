@using Microsoft.Extensions.Options
@using Stackarr.Mal.Models
@using Stackarr.Mal.Services
@using Stackarr.Tvarr
@using Stackarr.Tvarr.Services
@attribute [UiRegion("tv.series.season", EnabledConfigPath = "services:mal")]
@inject MalAccountService Accounts
@inject MalListService Lists
@inject MalMappingService Mappings
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService

@if (_visible && _entries.Count > 0)
{
    <div class="mal-series-row">
        <div class="mal-series-label">
            <span class="mal-series-logo st-brand-mask"
                  style="--st-brand-url:url('/_content/Stackarr.Mal/img/mal-logo.svg')"></span>
            <span>MyAnimeList</span>
        </div>
        <div class="mal-series-parts">
            @foreach ((int index, MalEntryView? entry, int malId) in _entries)
            {
                <button class="mal-series-chip" @onclick="() => OpenAsync(malId)" type="button">
                    @if (_parts.Count > 1)
                    {
                        <span class="mal-series-part">Part @(index + 1)</span>
                    }
                    @if (entry is null)
                    {
                        <span>Not on your list</span>
                    }
                    else
                    {
                        <span>@MalStatuses.Label(entry.Entry.Status)</span>
                        <span class="mal-series-progress">
                            @entry.Entry.WatchedEpisodes@(entry.Catalog.NumEpisodes > 0 ? $"/{entry.Catalog.NumEpisodes}" : "")
                        </span>
                        @if (entry.Entry.Score > 0)
                        {
                            <span class="mal-series-score">★ @entry.Entry.Score</span>
                        }
                    }
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public TvSeriesSeasonContext? Context { get; set; }

    int _userId;
    bool _visible;
    string _loadedKey = "";
    IReadOnlyList<MalMappedPart> _parts = [];
    List<(int Index, MalEntryView? Entry, int MalId)> _entries = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Context is null)
        {
            _visible = false;
            return;
        }

        string key = $"{Context.Series.Id}:{Context.Season.SeasonNumber}";
        if (key == _loadedKey)
            return;
        _loadedKey = key;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _visible = false;
        _entries = [];
        _parts = [];

        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out int userId))
            return;
        _userId = userId;

        if (await Accounts.GetAsync(userId) is null || Context is null)
            return;

        Dictionary<int, int> counts = Context.Series.Seasons
            .Where(x => x.SeasonNumber > 0)
            .ToDictionary(x => x.SeasonNumber, x => x.EpisodeCount > 0 ? x.EpisodeCount : x.TotalEpisodeCount);

        MalMappingResult? mapping;
        try
        {
            mapping = await Mappings.ResolveSeriesAsync(
                Context.Series.TmdbId,
                Context.Series.TvdbId,
                Context.Season.SeasonNumber,
                counts);
        }
        catch
        {
            return;
        }
        if (mapping is null)
            return;

        _parts = mapping.Parts;
        List<int> malIds = mapping.Parts.Select(x => x.MalId).Distinct().ToList();
        for (int i = 0; i < malIds.Count; i++)
        {
            MalEntryView? entry = await Lists.GetEntryAsync(userId, malIds[i]);
            _entries.Add((i, entry, malIds[i]));
        }

        _visible = _entries.Count > 0;
    }

    async Task OpenAsync(int malId)
    {
        DialogParameters<MalDetailDialog> parameters = new() { { x => x.MalId, malId } };
        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        await DialogService.ShowAsync<MalDetailDialog>("MyAnimeList", parameters, options);
        await LoadAsync();
        StateHasChanged();
    }
}
