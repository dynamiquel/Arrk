@page "/mal"
@attribute [Authorize]
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using Microsoft.Extensions.Options
@using Stackarr.Core.Configuration
@using Stackarr.Mal.Models
@using Stackarr.Mal.Services
@using Stackarr.Tvarr.Components.Shared
@using Stackarr.Ui.Components
@inject MalAccountService Accounts
@inject MalListService Lists
@inject MalCatalogService Catalog
@inject MalSyncService Sync
@inject IOptionsMonitor<MalConfig> Config
@inject IOptionsMonitor<RoutesConfig> Routes
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Stackarr - MyAnimeList</PageTitle>

<PageHeader LogoUrl="/_content/Stackarr.Mal/img/mal-logo.svg" Title="MyAnimeList">
    <Actions>
        @if (_account is not null)
        {
            <MudButton Href="@MalProfileUrl" Target="_blank"
                       Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew">
                Open MAL
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync" OnClick="SyncNowAsync" Disabled="@_syncing">
                Sync now
            </MudButton>
        }
        else if (_configured)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddLink" OnClick="Link">
                Link MyAnimeList
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingView />
}
else
{
    @if (!_configured)
    {
        <SectionContainer Icon="@Icons.Material.Filled.Settings" Title="Connect MyAnimeList">
            <div class="mal-setup">
                <MudText Typo="Typo.body2">
                    MyAnimeList needs an API application before users can link their accounts. An administrator
                    can create one at
                    <a href="https://myanimelist.net/apiconfig" target="_blank" rel="noreferrer">myanimelist.net/apiconfig</a>
                    and add the client id and secret to <strong>Settings → MyAnimeList</strong>.
                </MudText>
                <MudText Typo="Typo.body2">
                    Register this redirect URL exactly:
                    <code class="mal-code">@RedirectUri</code>
                </MudText>
                <MudText Typo="Typo.caption" Style="color:var(--st-text-muted);">
                    App type: other. Set <code class="mal-code">routes.publicUrl</code> to the address users open Stackarr on,
                    or add an explicit redirect URI in <code class="mal-code">services.mal.redirectUris</code>.
                </MudText>
            </div>
        </SectionContainer>
    }
    else if (_account.NeedsReauth)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @(_account.LastError ?? "The MyAnimeList session expired.")
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="Link">Reconnect</MudButton>
        </MudAlert>
    }

    <div class="mal-tabs">
        <StTabs T="string" Items="MainTabs" Value="_tab"
                ValueChanged="@((string tab) => SelectTab(tab))" Variant="segmented" />
    </div>

    <div class="mal-search-wrap">
        <SearchBox @bind-Value="_query"
                   Placeholder="@(_tab == "list" ? "Search my list" : "Search MyAnimeList")"
                   Clearable="true" Dense="true" DebounceInterval="350"
                   OnSearch="OnSearchAsync" Class="mal-search" />
    </div>

    @if (_tab == "list")
    {
        @if (_account is null)
        {
            <EmptyState Icon="@Icons.Material.Filled.PlaylistPlay" Message="Link MyAnimeList to see your list"
                        Detail="You can still browse and search the MyAnimeList catalogue." />
        }
        else
        {
            <div class="mal-list-toolbar">
                <StTabs T="string" Items="StatusTabs" Value="_status"
                        ValueChanged="@((string status) => SetStatus(status))" Variant="underline" />
            </div>

            @if (FilteredEntries.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.SearchOff" Message="No entries match"
                            Detail="Change the filter or add something from Browse." />
            }
            else
            {
                <div class="st-media-grid st-media-grid--medium mal-grid">
                    @foreach (MalEntryView entry in VisibleEntries)
                    {
                        <MediaPosterCard Item="ToMediaItem(entry)" CardSize="MediaCardSize.Medium"
                                         ShowLibraryBadge="false" ShowActions="false" ShowWatchlistAction="false"
                                         IsAdmin="false" OnClick="@(_ => OpenAsync(entry.Entry.MalId))" />
                    }
                </div>
                <InfiniteScroll OnReached="LoadMoreAsync" Enabled="@(_visibleCount < FilteredEntries.Count)"
                                ShowSpinner="true" />
            }
        }
    }
    else
    {
        @if (_searching)
        {
            <LoadingView />
        }
        else if (_searchResults.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.Search" Message="Search the MyAnimeList catalogue"
                        Detail="Results can be added straight to your Plan to Watch list." />
        }
        else
        {
            <div class="st-media-grid st-media-grid--medium mal-grid">
                @foreach (MalCatalogEntry item in _searchResults)
                {
                    <MediaPosterCard Item="ToMediaItem(item)" CardSize="MediaCardSize.Medium"
                                     ShowLibraryBadge="false" ShowActions="@(!_listIds.Contains(item.MalId))"
                                     ShowWatchlistAction="false" IsAdmin="true"
                                     OnClick="@(_ => OpenAsync(item.MalId))"
                                     OnAdd="@(_ => AddAsync(item.MalId))" />
                }
            </div>
        }
    }
}

@code {
    int _userId;
    bool _loading = true;
    bool _syncing;
    bool _searching;
    bool _configured;
    bool _refreshing;
    MalAccount? _account;
    List<MalEntryView> _allEntries = [];
    List<MalCatalogEntry> _searchResults = [];
    HashSet<int> _listIds = [];
    string _tab = "list";
    string _status = MalStatuses.Watching;
    string _query = "";
    int _visibleCount = 40;
    string _filterText = "";
    string _browseQuery = "";

    string RedirectUri =>
        Config.CurrentValue.RedirectUris.FirstOrDefault()
        ?? Routes.CurrentValue.ResolvePublicBaseUrl() + "/mal-signin";

    string MalProfileUrl => _account is null
        ? "https://myanimelist.net"
        : $"https://myanimelist.net/animelist/{Uri.EscapeDataString(_account.MalUsername)}";

    IReadOnlyList<StTabItem<string>> MainTabs { get; } =
    [
        new("list", "My list", Icons.Material.Filled.List),
        new("browse", "Browse", Icons.Material.Filled.Search)
    ];

    IReadOnlyList<StTabItem<string>> StatusTabs =>
        MalStatuses.All
            .Where(status => status != MalStatuses.Watching)
            .Prepend(MalStatuses.Watching)
            .Select(status => new StTabItem<string>(
                status,
                MalStatuses.Label(status),
                null,
                CountFor(status).ToString()))
            .ToList();

    IReadOnlyList<MalEntryView> FilteredEntries
    {
        get
        {
            IEnumerable<MalEntryView> entries = _allEntries;
            if (!string.IsNullOrWhiteSpace(_status))
                entries = entries.Where(x => x.Entry.Status == _status);
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                string term = _filterText.Trim();
                entries = entries.Where(x =>
                    x.DisplayTitle.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || x.Catalog.EnglishTitle.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return entries.ToList();
        }
    }

    IReadOnlyList<MalEntryView> VisibleEntries => FilteredEntries.Take(_visibleCount).ToList();

    int CountFor(string status) => _allEntries.Count(x => x.Entry.Status == status);

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId))
            return;

        _configured = Config.CurrentValue.IsConfigured;
        _account = await Accounts.GetAsync(_userId);

        Dictionary<string, StringValues> query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("status", out StringValues status) && !string.IsNullOrWhiteSpace(status))
            _status = status.ToString();
        if (query.TryGetValue("entry", out StringValues entry) && int.TryParse(entry, out int malId))
            _pendingEntry = malId;
        if (query.TryGetValue("linked", out StringValues linked) && linked == "mal")
            Snackbar.Add("MyAnimeList linked.", Severity.Success);
        if (query.TryGetValue("error", out StringValues error) && error == "config")
            Snackbar.Add("MyAnimeList is not configured yet.", Severity.Warning);

        await LoadAsync();
        _loading = false;

        if (_pendingEntry is int pending)
            await OpenAsync(pending);
    }

    int? _pendingEntry;

    async Task LoadAsync()
    {
        if (_account is null)
            return;

        // Render the cache immediately; the MAL pull and TMDB enrichment happen in the background
        // so a slow/unreachable MAL API can never block the Blazor circuit.
        _allEntries = [.. await Lists.GetEntriesAsync(_userId)];
        _listIds = [.. _allEntries.Select(x => x.Entry.MalId)];
        _visibleCount = 40;
        _ = RefreshAsync();
    }

    async Task RefreshAsync()
    {
        if (_refreshing)
            return;

        _refreshing = true;
        try
        {
            if (_account is null)
                return;

            if (_account.LastPulledAt is null || _account.LastPulledAt < DateTime.UtcNow.AddMinutes(-5))
            {
                await Lists.PullAsync(_userId);
                _account = await Accounts.GetAsync(_userId);
            }

            List<MalEntryView> entries = [.. await Lists.GetEntriesAsync(_userId)];
            await InvokeAsync(() =>
            {
                _allEntries = entries;
                _listIds = [.. entries.Select(x => x.Entry.MalId)];
                _visibleCount = 40;
                StateHasChanged();
            });

            _ = EnrichVisibleAsync();
        }
        catch (Exception ex)
        {
            await InvokeAsync(() => Snackbar.Add(ex.Message, Severity.Warning));
        }
        finally
        {
            _refreshing = false;
        }
    }

    async Task EnrichVisibleAsync()
    {
        try
        {
            List<MalCatalogEntry> pending = VisibleEntries
                .Select(x => x.Catalog)
                .Where(MalCatalogService.NeedsEnrichment)
                .Take(24)
                .ToList();
            if (pending.Count == 0)
                return;

            IReadOnlyList<MalCatalogEntry> enriched = await Catalog.EnrichManyAsync(pending);
            Dictionary<int, MalCatalogEntry> byMalId = enriched.ToDictionary(x => x.MalId);
            await InvokeAsync(() =>
            {
                _allEntries = _allEntries
                    .Select(x => byMalId.TryGetValue(x.Catalog.MalId, out MalCatalogEntry? catalog)
                        ? new MalEntryView(x.Entry, catalog)
                        : x)
                    .ToList();
                StateHasChanged();
            });
        }
        catch
        {
            /* cached/MAL artwork remains visible */
        }
    }

    Task LoadMoreAsync()
    {
        if (_visibleCount >= FilteredEntries.Count)
            return Task.CompletedTask;
        _visibleCount = Math.Min(_visibleCount + 40, FilteredEntries.Count);
        _ = EnrichVisibleAsync();
        return Task.CompletedTask;
    }

    Task SelectTab(string tab)
    {
        if (_tab == tab)
            return Task.CompletedTask;

        _tab = tab;
        _query = "";
        _filterText = "";
        _browseQuery = "";
        _searchResults = [];
        _visibleCount = 40;
        if (tab == "list")
            _ = EnrichVisibleAsync();
        return Task.CompletedTask;
    }

    async Task OnSearchAsync(string value)
    {
        _query = value;
        if (_tab == "list")
        {
            _filterText = value;
            _visibleCount = 40;
        }
        else
        {
            _browseQuery = value;
            await SearchAsync();
        }
    }

    Task SetStatus(string status)
    {
        _status = status;
        _visibleCount = 40;
        return Task.CompletedTask;
    }

    void Link() => Nav.NavigateTo("/account/link/mal", forceLoad: true);

    async Task SyncNowAsync()
    {
        _syncing = true;
        try
        {
            string result = await Sync.SyncUserAsync(_userId);
            Snackbar.Add(result, Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _syncing = false;
        }
    }

    async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_browseQuery))
        {
            _searchResults = [];
            return;
        }

        _searching = true;
        try
        {
            _searchResults = [.. await Lists.SearchAsync(_userId, _browseQuery)];
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _searching = false;
        }
    }

    async Task AddAsync(int malId)
    {
        try
        {
            await Lists.UpdateAsync(_userId, malId, new MalListUpdate(Status: MalStatuses.PlanToWatch, Score: 0));
            _listIds.Add(malId);
            _allEntries = [.. await Lists.GetEntriesAsync(_userId)];
            Snackbar.Add("Added to Plan to Watch.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task OpenAsync(int malId)
    {
        DialogParameters<MalDetailDialog> parameters = new() { { x => x.MalId, malId } };
        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        await DialogService.ShowAsync<MalDetailDialog>("MyAnimeList", parameters, options);
        if (_account is not null)
        {
            _allEntries = [.. await Lists.GetEntriesAsync(_userId)];
            _listIds = [.. _allEntries.Select(x => x.Entry.MalId)];
        }
    }

    MediaItem ToMediaItem(MalEntryView view) => ToMediaItem(view.Catalog, view.Entry);

    MediaItem ToMediaItem(MalCatalogEntry catalog, MalListEntry? entry = null)
    {
        bool movie = string.Equals(catalog.MediaType, "movie", StringComparison.OrdinalIgnoreCase);
        double? rating = entry is { Score: > 0 } ? entry.Score : (catalog.Mean is > 0 ? catalog.Mean : null);
        double progress = entry is not null && catalog.NumEpisodes > 0
            ? Math.Clamp(entry.WatchedEpisodes / (double)catalog.NumEpisodes, 0, 1)
            : 0;

        return new MediaItem
        {
            Title = MalCatalogService.CardTitle(catalog),
            SeasonLabel = MalCatalogService.SeasonLabel(catalog) ?? "",
            Year = MalCatalogService.YearOf(catalog),
            Overview = string.IsNullOrWhiteSpace(catalog.DisplayOverview) ? catalog.Synopsis : catalog.DisplayOverview,
            PosterUrl = MalCatalogService.Poster(catalog),
            Rating = rating,
            Genres = catalog.Genres
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList(),
            MediaType = movie ? "movie" : "tv",
            TmdbId = catalog.TmdbId ?? 0,
            TotalEpisodes = catalog.NumEpisodes,
            WatchProgress = progress,
            IsAnime = true
        };
    }

    static string StatusVariant(string status) => status switch
    {
        MalStatuses.Watching => "info",
        MalStatuses.Completed => "success",
        MalStatuses.OnHold => "warning",
        MalStatuses.Dropped => "error",
        _ => "neutral"
    };
}
