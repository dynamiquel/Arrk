<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Leaf contracts for subtitles. Backend modules (OpenSubtitles, Bazarr) depend on this
    assembly, and consumers (the shared Subtitles UI/player integrations) depend only on the
    interfaces.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
