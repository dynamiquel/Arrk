@attribute [UiRegion(UiRegions.AccountConnections, Order = 20)]
@inject UserNotificationChannelService UserChannels
@inject IExternalIdentityStore Identities
@inject AuthenticationStateProvider AuthProvider
@inject DiscordNotificationChannel Discord
@inject ISnackbar Snackbar

@if (_loaded && Discord.SupportsDirectDelivery && _linked)
{
    <div class="st-connection-row">
        <div class="st-connection-icon">
            <span class="st-discord-logo st-brand-mask"
                  style="--st-brand-url:url('/img/discord-logo.svg')"></span>
        </div>
        <div class="st-connection-body">
            <div class="st-connection-name">Discord direct messages</div>
            <div class="st-connection-state">
                @(_enabled ? "On. You'll get DMs for requests and titles you follow." : "Off.")
            </div>
        </div>
        <div class="st-connection-actions">
            <MudSwitch T="bool" Value="_enabled" ValueChanged="SetEnabledAsync"
                       Color="Color.Primary" />
        </div>
    </div>
}

@code {
    int _userId;
    bool _loaded;
    bool _linked;
    bool _enabled;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirst(StackarrClaims.UserIdClaim)?.Value, out _userId))
            return;

        IReadOnlyList<Microsoft.AspNetCore.Identity.UserLoginInfo> logins =
            await Identities.GetExternalLoginsAsync(_userId);
        _linked = logins.Any(login =>
            string.Equals(login.LoginProvider, ExternalLoginSchemes.Discord, StringComparison.OrdinalIgnoreCase));

        UserNotificationChannel? channel = await UserChannels.GetAsync(
            _userId, DiscordNotificationChannel.ChannelName);
        // Linked Discord with an active bot is on by default; only an explicit false disables it.
        _enabled = channel is null || channel.Enabled;
        _loaded = true;
    }

    async Task SetEnabledAsync(bool enabled)
    {
        _enabled = enabled;
        try
        {
            await UserChannels.SetEnabledAsync(_userId, DiscordNotificationChannel.ChannelName, enabled);
        }
        catch (Exception ex)
        {
            _enabled = !enabled;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
