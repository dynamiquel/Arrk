<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The download-management module owns its own UI (Razor class library): the unified Downloads page
    listing Transmission torrents and slskd transfers, and the shared download card/mapping, all
    contributed to the shell through the Stackarr.Ui contracts.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Stackarr.Core\Stackarr.Core.csproj" />
    <ProjectReference Include="..\Stackarr.Ui\Stackarr.Ui.csproj" />
    <ProjectReference Include="..\Stackarr.Docker\Stackarr.Docker.csproj" />
    <ProjectReference Include="..\Stackarr.Slskd\Stackarr.Slskd.csproj" />
    <ProjectReference Include="..\Stackarr.Ai\Stackarr.Ai.csproj" />
    <ProjectReference Include="..\Stackarr.Downloads.Abstractions\Stackarr.Downloads.Abstractions.csproj" />
    <ProjectReference Include="..\Stackarr.Media.Abstractions\Stackarr.Media.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Stackarr.Downloads.Abstractions" />
  </ItemGroup>
</Project>
