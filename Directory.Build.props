<Project>

  <PropertyGroup>
    <!--
      Development fallback for the Arrk version (major.minor.revision).
      Every project in the repository inherits this value, so the app and all
      built-in modules report the same version. The release workflow owns the
      released value: it updates this property, tags the commit and builds the
      image with the same version. Do not bump it in a normal pull request.
      Third-party modules ship their own csproj and set their own <Version>.
    -->
    <Version>0.500.1</Version>
    <!-- Keep InformationalVersion clean (no "+<commit sha>" suffix). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Documentation/*.md" />
  </ItemGroup>

</Project>
