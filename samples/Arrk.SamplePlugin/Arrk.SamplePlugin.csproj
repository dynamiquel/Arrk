<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    A minimal sample plugin. Drop the built DLL (and any of its assets) under <data>/plugins and
    Arrk loads it at startup: the module contributes a navigation entry, a page and an asset.
    Built as part of the solution so the contracts stay compile-checked; it is never referenced by
    the host. See docs/features/modules.md.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Arrk.Core\Arrk.Core.csproj" />
    <ProjectReference Include="..\..\src\Arrk.Ui\Arrk.Ui.csproj" />
    <ProjectReference Include="..\..\src\Arrk.Media.Abstractions\Arrk.Media.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Arrk.Tv.Abstractions\Arrk.Tv.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Arrk.SamplePlugin</RootNamespace>
  </PropertyGroup>

</Project>
